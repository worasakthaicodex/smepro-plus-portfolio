<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="ZK Spreadsheet Demo" border="normal" width="100%" height="100%">
        <spreadsheet 
            src="/renders/FM-DC-02.xlsx"
            maxVisibleRows="30"
            maxVisibleColumns="20"
            showToolbar="true"
            showSheetbar="true"
            showFormulabar="true"
        />
    </window>
</zk>