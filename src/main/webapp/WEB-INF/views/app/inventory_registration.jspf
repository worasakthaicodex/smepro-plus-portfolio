<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
 

    <c:if test="${typeshow == 1 }"> 

	   <li class="d-flex justify-content-between align-items-center">
	                                                        <p>Inventory Registration</p>
	                                                        <p class="fw-bold">  ${ir.ir_date}${ir.ir_id}</p>
	         </li>                                              
	                                                        
	     <li class="d-flex justify-content-between align-items-center">
	                                                        <p>  <spring:message code="stock.list" /></p>
	                                                        <p class="fw-bold">${stock.stock_list }</p>
	      </li>  
	      
	          <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.note"  /></p>
	                                                        <p class="fw-bold">${stock.stock_note }</p>
	      </li>  
	      
	            <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.type"  /></p>
	                                                        <p class="fw-bold">${stock.stock_type }</p>
	      </li>  
	      
	            <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.unit"  /></p>
	                                                        <p class="fw-bold">${stock.stock_unit }</p>
	      </li>  
	      

	      
	    <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.storage"  /></p>
	                                                        <p class="fw-bold">${stock.stock_storage }</p>
	     </li>
	      
	      
	      
	      							<c:set var="display_stock_pd" value="" />
                                       <c:if test="${card_pd != null }">
                                         <c:set var="display_stock_pd" value="PD: ${card_pd.production_directive } Batch: ${card_pd.batch } Type: ${card_pd.product }" />
                                       </c:if>
	      

	       <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.pd"  /></p>
	                                                        <p class="fw-bold">${display_stock_pd }</p>
	     </li>
	      
	      
	             <li class="d-flex justify-content-between align-items-center">
	                                                        <p>        <spring:message code="stock.max"  /></p>
	                                                        <p class="fw-bold">${stock.stock_max }</p>
	     </li>
	            <li class="d-flex justify-content-between align-items-center">
	                                                        <p>   <spring:message code="stock.min"  /></p>
	                                                        <p class="fw-bold">${stock.stock_min }</p>
	     </li>
	      
	                      

                          
                                           
	      
	      
	      
	     </c:if>  
	     
	     
	      <c:if test="${typeshow == 2 }">  
	       <div class="col-12">
                                                <div class="mb-1 row">
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >Inventory Registration <span title="Auto-generated">ℹ️</span></label>
                                                    </div>
                                                     <div class="col-sm-9"> 
                                                        <input type="text" class="form-control" value="${ir.ir_date}${ir.ir_id}" readonly>
                                                      </div>
                                                     </div> 
                                           </div>  
                                            <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.list" />
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 
                                                    <input type="text"  class="form-control" name="stock_list"   value="${stock.stock_list }" required>
                                                      <input type="hidden"  class="form-control" name="stock_id"   value="${stock.stock_id+0 }" >
                                                    
                                                      </div>
                                                     </div> 
                                           </div>
                                               <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.note"  />
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 
                                                    <input type="text"  class="form-control" name=stock_note   value="${stock.stock_note }" >
                                                      </div>
                                                     </div> 
                                           </div>
                                        
                                              
                                     
                                    
	
                                              
                                              
                                              
                                       <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.type"   />
                                                        
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 

                                                    <select class="form-select" name="stock_type" >
                                                    
                                                  
                                                    
                                                    
                                                      <c:forEach items="${StockType_all }" var="row" varStatus="count">
                                                        <option value="${row.dataset_data_title }"
                                                          <c:if test="${stock.stock_type == row.dataset_data_title }">selected </c:if>
                                                        >${row.dataset_data_title }</option>
                                                        </c:forEach>
                                                    </select>
                                                    
                                                      </div>
                                                     </div> 
                                       </div>
                                       
                                                    <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.max"  />
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 
                                                    <input type="text"  step="0.1"  class="form-control" name="stock_max"   value="${stock.stock_max }" >
                                                      </div>
                                                     </div> 
                                           </div>
                                           

                                     <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.min"  />
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 
                                                    <input type="number" step="0.1"  class="form-control" name="stock_min"   value="${stock.stock_min }" >
                                                      </div>
                                                     </div> 
                                      </div>
                                           
                                           
                                       
                                       
                                       <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.unit"   />
                                                        
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 

                                                    <select class="form-select" name="stock_unit" >
                                                    
                                                  
                                                    
                                                    
                                                      <c:forEach items="${unit_all }" var="row" varStatus="count">
                                                        <option value="${row.dataset_data_title }"
                                                          <c:if test="${stock.stock_unit == row.dataset_data_title }">selected </c:if>
                                                        >${row.dataset_data_title }</option>
                                                        </c:forEach>
                                                    </select>
                                                    
                                                      </div>
                                                     </div> 
                                       </div>
                                       
                              
                                       
                                            <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                          <spring:message code="stock.storage"   />    
                                                        
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 
                                                    <select class="form-select" name="stock_storage" >
                                                      <c:forEach items="${storage_all }" var="row" varStatus="count" >
                                                        <option value="${row.dataset_data_title }"
                                                        <c:if test="${stock.stock_storage == row.dataset_data_title }">selected </c:if>
                                                        >${row.dataset_data_title }</option>
                                                        </c:forEach>
                                                    </select>
                                                    
                                                      </div>
                                                     </div> 
                                       </div>   
                                                    <div class="col-12" >
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                         <spring:message code="btn.info"/>
                                                        
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 

    							<c:set var="display_stock_pd" value="" />
                                       <c:if test="${card_pd != null }">
                                         <c:set var="display_stock_pd" value="PD: ${card_pd.production_directive } Batch: ${card_pd.batch } Type: ${card_pd.product }" />
                                       </c:if>
                                           
                                 <div class="input-group">
                                     <span class="input-group-text" id="basic-addon-search1"  >
                                      <a href="#" data-bs-toggle="modal" data-bs-target="#new-task-modal">  
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
       								 </a>
                                        </span>
                                        <input type="text" class="form-control"  readonly  id="display_stock_pd"  value="${display_stock_pd }"  aria-describedby="basic-addon-search1" required>
                                    </div>
                                       
                                               <input type="hidden"  class="form-control" name="stock_pd"  id="stock_pd"   value="${stock.stock_pd }" >
                                                      </div>
                                                      
                                               </div>
                                       </div>     
	       </c:if>  
	       
	       
	       	      <c:if test="${typeshow == 4 }">  
	       	        <table   class="tabledata" style="height:auto" >
                                    <thead>
                                        <tr>
                                            <th class="form-label fixhead">SID</th>
                                            <th class="form-label fixhead"> <spring:message code="stock.list" /></th>
                                             <th class="form-label fixhead"><spring:message code="stock.type"  /></th>
                                                      <th class="form-label fixhead"><spring:message code="item.unit" text="หน่วยนับ" /></th>
 
                                            </tr>
                                           
                                           
                                        </tr>
                                    </thead>
                                    <tbody>
                          
                          
 
                                        <c:forEach items="${stock_ir }" var="row" varStatus="count">
				                                      <tr>
				                                            <td>${row.stock_receipt_date }${row.stock_id }</td >
				                                             <td>${row.stock_list }</td >
				                                             <td>${row.stock_type }</td >
				                                            <td>${row.stock_unit }</td >

				                                        </tr>
                                        </c:forEach>
                                        
                                    </tbody>
                                    </table> 
	       	          </c:if>  
	       	          
	     <c:if test="${typeshow == 7}">  
	       	          	 

<div class="card business-card">
                            <div class="card-header pb-1">
                                <h4 class="card-title">App Integrations</h4>
                            </div>
                            
                           
                              <form:form method="POST" modelAttribute="user" action="/integrationsave-workflow">
                            <div class="card-body">
                        
                                <div class="business-items">
                                    
                                    <div class="business-item">
                                    
                                    
                                     <input type="hidden"  name="workflow_key1" value="inventory_registration"  >
                                     <input type="hidden"  name="workflow_key1" value="stock_requisition"   >
                                      <input type="hidden" name="workflow_key1"  value="direct_goods_receipt"   >
                                      
  
                                     
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="business-checkbox-1" disabled  checked>
                                                <label class="form-check-label" for="business-checkbox-1"><spring:message code="Inventory.app1" /> </label>
                                            </div>
                                            <span class="badge badge-light-success"><spring:message code="app.request" /></span>
                                        </div>
                                    </div>
                                            <div class="business-item">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="business-checkbox-1" disabled  checked>
                                                <label class="form-check-label" for="business-checkbox-1"><spring:message code="Inventory.app2" /> </label>
                                            </div>
                                            <span class="badge badge-light-success"><spring:message code="app.request" /> </span>
                                        </div>
                                    </div>
                                                  <div class="business-item">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="business-checkbox-1" disabled  checked>
                                                <label class="form-check-label" for="business-checkbox-1"><spring:message code="Inventory.app3" /> </label>
                                            </div>
                                            <span class="badge badge-light-success"><spring:message code="app.request" /></span>
                                        </div>
                                    </div>
                                     
                                </div>
                                
                                   <c:if test="${( Member_id == workflows.workflow_idadmin ) || ( Member_id == workflows.workflow_idadd )}">
                                <div>
                                     <input  type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                                     <input type="hidden" class="form-select"  name="workflow_id" value="${workflows.workflow_id }"> 
                                        <input type="hidden" class="form-select"  name="workflow_type" value="1"> 
                                         <input type="hidden" class="form-select"  name="workflow_id" value="${workflows.workflow_id }">  
                                                <button type="submit" class="btn btn-primary me-1 waves-effect waves-float waves-light"><spring:message code="btn.save" /></button>
                                </div>
                                </c:if>
                                
                            </div>
                            </form:form>
                            
                        </div>
	       	          	 
	          
	       	            </c:if>  
	       	          
	     <c:if test="${typeshow ==8}">          
	       <style>
	       .wizard-container{
  width:100%;
  margin: 0 auto;
}


.wizard-container-ul{
  list-style: none

}

.wizard-container-li{
  display: inline-block;
  padding: 20px;
  width:auto;
  position: relative;
  width: 150px;
  vertical-align: top;

}

.step-div{
  
 text-align: center;
 

}

.step-bg{
  color: #fff;
  margin-top:4px;
  display: inline-block;
  
  border: 1px solid #666666;
  border-radius: 50%;
  width:32px;
  height: 32px;
  display: inline-block;
  text-align: center;
  padding-top: 2px;
}

.step-div:before
{
  display: block;
  position: absolute;
  top: 39px;
  width: 100%;
  height: 4px;
  content: '';
  background-color:#006F94;
  margin-left: -110px;

}

.wizard-container-li:first-child  .step-div:before{   
 
display:none;

}

.step-num{
   position: absolute;
   margin-left: -21px;
   margin-top: 9px;
   color:#fff;
   font-weight: bold;
   font-size: 14px;
 }


.step-title{
  font-size: 12px;
  color: #666;
  display: block;
 

}



/*marker***/
 .wizard-container-li.marker .step-bg{
   border-bottom-left-radius: 0;
   transform: rotate(-45deg);
   border:1px solid transparent;
   background-color: #006F94;
 }


/*positive outcome marker style*/
 .wizard-container-li.marker.positive .step-bg {
  background-color:#669933
}

 .wizard-container-li.marker.positive .step-num{
  background-color:#fff;
  border-radius:50%;
  width:22px;
  height:22px;
  margin-left: -27px;
  color:#669933;
  margin-top: 9px;
  vertical-align: middle;
  font-size: 15px;
}
 .wizard-container-li.marker.positive .step-title {
  color:#006633;
  font-weight: bold;
}

/*negative outcome marker style*/
 .wizard-container-li.marker.negative .step-bg {
  background-color:#EA4300
}

 .wizard-container-li.marker.negative .step-num{
  background-color:#fff;
  border-radius:50%;
  width:22px;
  height:22px;
  margin-left: -27px;
  color:#EA4300;
  margin-top: 9px;
  vertical-align: middle;
  font-size: 14px;
}

 .wizard-container-li.marker.negative .step-title {
  color:#CC0000;
  font-weight: bold;
}
/** active & disabled styles ***********************************/


/*completed***/

.wizard-container-li.completed .step-div:before,
.wizard-container-li.active .step-div:before,
.wizard-container-li.rejected .step-div:before{
  border:2px solid #666666;
  background-color:transparent;
}
.wizard-container-li.completed .step-num{
  margin-left: -24px;
  font-size: 16px;
  margin-top: 8px;
}

.wizard-container-li.completed .step-bg{
  background-color: #666666;
}



 

 /*active***/
.wizard-container-li.active .step-num{
  background-color:#fff;
  border-radius:50%;
  width:22px;
  height:22px;
  margin-left: -27px;
  color:#006F94;
  margin-top: 9px;
  vertical-align: middle;
  font-size: 14px;
}
.wizard-container-li.active .step-title{
  font-weight: bold;
  color:#006F94;
  vertical-align: top;
}

/*disabled***/



.wizard-container-li.disabled .step-div:before{
  background-color:#ccc;
}

.wizard-container-li.disabled .step-bg{
  background-color:#ccc;
  border:1px solid #ccc;
   

}

.wizard-container-li.disabled .step-num{
  color:#666;
   

}


/*onhold******/



.wizard-container-li.onhold .step-div:before,
.wizard-container-li.onhold-border .step-div:before {
  
   border:2px dashed #FF9900;
  background-color:transparent;

  /* margin-right: -250px; */
  
}
.wizard-container-li.onhold .step-bg{
  background-color:#FF9900;
  border:1px solid #FF9900;

}


.wizard-container-li.onhold .step-num{
  color:#fff;
  margin-left: -23px;
  font-size: 15px;

}
.wizard-container-li.onhold .step-title{
 
  color:#CC6633;
}
 


/**rejected **/
.wizard-container-li.rejected .step-bg{
  background-color:#CC0000;
  border:1px solid #CC0000;
} 

.onhold{
z-index:20;
} 
.active{
z-index:99;
} 
	       
	       </style>	
	       
	       
