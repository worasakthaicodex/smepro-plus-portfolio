                    R
                    </span>
                    <span class="step-title"  style="z-index:10">

                         Step 1  <spring:message code="app.requeststockid"  />
                    </span>
                </div>
            </li>
                         
            <li class="wizard-container-li  onhold"  >
                <div class="step-div" >
                    <span class="step-bg"  style="z-index:10">
                        
                    </span>
                    <span class="step-num"  style="z-index:10">
                     C
                    </span>
                    <span class="step-title"  style="z-index:10">

                         Step 1  <spring:message code="app.create"  />
                    </span>
                </div>
            </li>
            
         <li class="wizard-container-li   completed" >
                <div class="step-div" style="z-index:10">
                    <span class="step-bg" style="z-index:10">
                        
                    </span>
                    <span class="step-num" style="z-index:10">
                   A
                    </span>
                    <span class="step-title" style="z-index:10">
                        Step 2 <spring:message code="app.approved"  />
                    </span>
                </div>
         </li>


         <li class="wizard-container-li   completed" >
                <div class="step-div" style="z-index:10">
                    <span class="step-bg" style="z-index:10">
                        
                    </span>
                    <span class="step-num" style="z-index:10">
                C
                    </span>
                    <span class="step-title" style="z-index:10">
                        Step 3 <spring:message code="app.issuedclear"  />
                    </span>
                </div>
         </li>

       
                   

                 
     <li class="wizard-container-li completed positive marker" >
                <div class="step-div">
                    <span class="step-bg">
                        
                    </span>
                    <span class="step-num">
                       AS
                    </span>
                    <span class="step-title">

                        Step 4 <spring:message code="app.adjuststock"  />
                    </span>
                </div>
        </li>


                 

 

               
        </ul>   </div>
                                                    </div>
                                                </div>
                                            </div>
                                      
                                        </div>
	       
	            </c:if>  
	       	          
