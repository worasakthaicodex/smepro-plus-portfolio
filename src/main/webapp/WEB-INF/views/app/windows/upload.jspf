 <%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>
 
 <style>
    /* โครงสร้างหลักของ Panel อัปโหลด */
    .wpf-upload-panel {
        background: #fff;
        border: 1px solid var(--wpf-border-light, #ccc);
        display: flex;
        flex-direction: column;
        height: 100%; /* ให้เต็มพื้นที่ Tab */
    }

    /* แถบเครื่องมือด้านบน (เลือกประเภทเอกสาร) */
    .upload-toolbar {
        background: #f8f9fa;
        border-bottom: 1px solid #ddd;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        gap: 15px;
    }
    
    .upload-toolbar label {
        font-size: 12px;
        font-weight: bold;
        color: #555;
    }

    /* ตกแต่ง Select Box ให้เข้ากับระบบ */
    .wpf-select {
        padding: 6px 30px 6px 10px;
        border: 1px solid #ccc;
        border-radius: 2px;
        font-size: 12px;
        color: #333;
        background-color: #fff;
        outline: none;
        min-width: 300px;
        -webkit-appearance: none;
        appearance: none;
        background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24"%3E%3Cpath fill="%23888" d="M7 10l5 5 5-5z"/%3E%3C/svg%3E');
        background-repeat: no-repeat;
        background-position: right 10px center;
    }
    .wpf-select:focus {
        border-color: #0A6ED1;
        box-shadow: 0 0 0 2px rgba(10, 110, 209, 0.2);
    }

    /* พื้นที่สำหรับลากวางไฟล์ (Dropzone) */
    .wpf-dropzone {
        margin: 15px;
        border: 2px dashed #bbb;
        background: #fafafa;
        border-radius: 6px;
        padding: 5px 10px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .wpf-dropzone:hover {
        border-color: #0A6ED1;
        background: #f0f7ff;
    }

    /* ลูกเล่นเวลาลากไฟล์มาวางเหนือโซน */
    .wpf-dropzone.drag-active {
        border-color: #27ae60;
        background: #eefaf3;
        transform: scale(0.99);
    }

    .wpf-dropzone i {
        font-size: 40px;
        color: #888;
        transition: color 0.2s;
    }
    .wpf-dropzone:hover i { color: #0A6ED1; }
    .wpf-dropzone.drag-active i { color: #27ae60; }

    .dz-text { font-size: 14px; color: #444; }
    .dz-subtext { font-size: 11px; color: #888; }

    /* พื้นที่แสดงไฟล์ที่อัปโหลดแล้ว */
    .file-list-container {
        flex: 1;
        overflow-y: auto;
        padding: 0 15px 15px 15px;
        max-height: 250px;
    }
</style>

<div class="wpf-upload-panel">
    <form id="formupload${edatas.data_id}" name="formupload${edatas.data_id}" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="edata_id" value="${edatas.data_id}">
        <input type="hidden" name="folder" value="${work.workflow_folder}">

        <div class="upload-toolbar">
            <label><i class="fa fa-tags"></i> ประเภทเอกสาร (File Tag):</label>
            <select name="file_tag" class="wpf-select">   
                <option value="-">- ไม่ระบุประเภท -</option>       
                <option value="ใบเสนอราคา / ใบสั่งซื้อจาก">ใบเสนอราคา / ใบสั่งซื้อจาก</option>
                <option value="เอกสารทั่วไป">เอกสารทั่วไป</option>
                <option value="ชุดเปิด SO">ชุดเปิด SO</option>
                <option value="หลักฐานการชำระเงิน /อีเมล์การอนุมัติจากผู้บริหาร">หลักฐานการชำระเงิน /อีเมล์การอนุมัติจากผู้บริหาร</option>
                <option value="รายละเอียดการดำเนินโครงการ">รายละเอียดการดำเนินโครงการ</option>
                <option value="แบบสอบถามข้อมูลเบื้องต้น">แบบสอบถามข้อมูลเบื้องต้น</option>
                <option value="ระเบียบการชำระเงิน">ระเบียบการชำระเงิน</option>
                <option value="ภพ.20">ภพ.20</option>
                <option value="หนังสือรับรองบริษัท">หนังสือรับรองบริษัท</option>
                <option value="ทะเบียนการค้าพาณิชย์">ทะเบียนการค้าพาณิชย์</option>
                <option value="แผนที่ตั้งโรงงาน">แผนที่ตั้งโรงงาน</option>
                <option value="ใบอนุญาติจัดตั้งโรงงาน (รง2,รง4)">ใบอนุญาติจัดตั้งโรงงาน (รง2,รง4)</option>
                <option value="ใบอนุญาติสถานที่ผลิตอาหาร(อ2/สบ1)">ใบอนุญาติสถานที่ผลิตอาหาร(อ2/สบ1)</option>
                <option value="ใบขึ้นทะเบียนอาหาร(สบ5)">ใบขึ้นทะเบียนอาหาร(สบ5)</option>
                <option value="สำเนาบัตรประชาชนกรรมการบริษัท">สำเนาบัตรประชาชนกรรมการบริษัท</option>
                <option value="สำเนาทะเบียบกรรมการบริษัท">สำเนาทะเบียบกรรมการบริษัท</option>                                                         
            </select>
        </div>

        <div class="wpf-dropzone" 
             id="dz-${edatas.data_id}"
             ondrop="handleDrop(event, '${edatas.data_id}')" 
             ondragover="handleDragOver(event)" 
             ondragleave="handleDragLeave(event)"
             onclick="document.getElementById('file-input-${edatas.data_id}').click()">
            
            <i class="fa fa-cloud-arrow-up"></i>
            <div class="dz-text">ลากไฟล์มาวางที่นี่ หรือ <b>คลิกเพื่อเลือกไฟล์</b></div>
            <div class="dz-subtext">รองรับการอัปโหลดหลายไฟล์พร้อมกัน (Multiple Files)</div>

            <input type="file" 
                   id="file-input-${edatas.data_id}" 
                   name="files" 
                   style="display:none;" 
                   onchange='postData("/uploadfile_app-filemanager?${_csrf.parameterName}=${_csrf.token}","formupload${edatas.data_id}","subdataformupload${edatas.data_id}"); this.value=null;' 
                   multiple>
        </div>
    </form>

    <div class="file-list-container">
        <div id="subdataformupload${edatas.data_id}">
            <%@ include file="file.jsp" %>  
        </div>
    </div>
</div>

<script>
    // ฟังก์ชันเพิ่มเติมสำหรับ Drag & Drop ให้สมบูรณ์แบบ
    function handleDragOver(e) {
        e.preventDefault(); // สำคัญมาก ไม่งั้นเบราว์เซอร์จะไม่ยอมให้ดรอปไฟล์
        e.currentTarget.classList.add('drag-active');
    }

    function handleDragLeave(e) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-active');
    }

    function handleDrop(e, dataId) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-active');

        const files = e.dataTransfer.files;
        if (files.length > 0) {
            const fileInput = document.getElementById('file-input-' + dataId);
            fileInput.files = files; // ยัดไฟล์ที่ลากมาใส่ใน Input ที่ซ่อนอยู่
            
            // สร้าง Event บังคับให้ onchange ทำงาน เพื่อรันฟังก์ชัน postData ของคุณ
            const event = new Event('change', { bubbles: true });
            fileInput.dispatchEvent(event);
        }
    }
</script>