<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>
 


<c:set var="key" value="data_value${row.field_postion}" scope="page"/>
 <c:if test="${ steptype.contains(row.keymap.type)  }">


 <c:choose>
                                                
<c:when test='${row.field_type.equals("hidden")}'>
<input type="hidden" class=" form-control"   id="${row.keymap.mainkey}" name="edata.${key}" value="${edatas[key]}" > 	
</c:when>          
     
  <c:when test='${row.keymap.mainkey == "lot_batch" && batch_gens != null    }'>
  
   	     <div title="KET->${row.keymap.mainkey }">
<label for="i51">${title } ${disabled }</label>
  			     	<c:set var="batch_gen" value="${transaction[row.keymap.mainkey]}" /> 
        <c:if test="${ transaction[row.keymap.mainkey] == null  }"><c:set var="batch_gen" value="${batch_gens}" /> </c:if>
	    <input type="text" class="form-control"  value="${batch_gen }" name="${appmodel }${row.keymap.mainkey}"  readonly>
</div> 
   	
  
		 
			    
	      
  </c:when> 
 



 	        <c:when test='${row.keymap.change_format == "Multiply" && action_batch == null  }'>
	        
	         <div class="mb-1 row">
<div c title="KET->${row.keymap.mainkey }">${title } * ${disabled }</div>
			          <div class="col-sm-12">  
			     <input type="text" class="form-control newinput" id="${row.keymap.mainkey}" name="${appmodel }${key}"  value="${transaction[row.keymap.mainkey]}" readonly>
			     </div> 
			         </div>  
	         </c:when>
	          
	          
	         <c:when test='${row.keymap.change_format == "GRAND_AUTO_SUM" && action_batch == null    }'>
	
				<div  title="KET->${row.keymap.mainkey }">${title } * ${disabled }</div>
			           <div class="col-sm-12">  
			     <input type="text" class="form-control   newinput" id="${row.keymap.mainkey}" name="${appmodel }${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
			     </div>  
			 
	         </c:when> 
 
	        <c:when test='${row.keymap.change_format == "Multiply" && action_batch_clear == null  }'>
	        

			   
			   	    <div title="KET->${row.keymap.mainkey }">
							<label for="i51">${title } *${disabled }</label>
						  <input type="text" class="form-control newinput" id="${row.keymap.mainkey}" name="${appmodel }${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
			   
							 </div>   
			   
			   
	         </c:when>
	          
	          
	         <c:when test='${row.keymap.change_format == "GRAND_AUTO_SUM" && action_batch_clear == null    }'>
	    

			      
			    <div title="KET->${row.keymap.mainkey }">
							<label for="i51">${title } *${disabled }</label>
						   <input type="text" class="form-control newinput" id="${row.keymap.mainkey}" name="${appmodel }${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
			   
							 </div>      
			      
			      
			      
	         </c:when> 
	         
	         
	                  <c:when test='${row.keymap.change_format == "SUM"  || row.keymap.change_format == "Minus"     }'>
	 
			         
			            <div title="KET->${row.keymap.mainkey }">
							<label for="i51">${title } *${disabled }</label>
						   <input type="text" class="form-control newinput" id="${row.keymap.mainkey}" name="${appmodel }${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
                                  <span class="input-group-text" id="basic-addon-search1"  >
                                      <a href="#" onclick="shows2('draggable-window3','นำเข้ารายชื่ออาจารย์'); getData('/subtable-filemanager/${edatas.data_id+0}/${process.id}', 'mainbody3')">  
                                 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg> </a>
                                        </span>
							 </div> 
	                 
			         
	         </c:when> 

    
	         <c:when test='${row.keymap.change_format == "Mandatory Reference Key(AT)" }'>  
		       <c:if test="${edatas.edata_index_action_type > 0 }">

			 <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>
					<c:if test="${row.data_access_interface != 1}">
					    	 <%@ include file="../input/fullsearch.jsp" %>  
					    	 	  <c:set var="Keyinterface" value="0" />  	 
				   </c:if>   
				   <c:if test="${row.data_access_interface == 1}">   
					  	  <%@ include file="../input/fastselect.jsp" %> 
					  	  <c:set var="Keyinterface" value="1" />  		
					  	 
					</c:if>
					 </div> 
			 </c:if>
		    </c:when>


	            <c:when test='${row.keymap.change_format == "Mandatory Reference Key" }'>  

	            
			   <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>
				    <c:if test="${row.data_access_interface != 1}">
				    	 <%@ include file="../input/fullsearch.jsp" %>  
				    	 	  <c:set var="Keyinterface" value="0" />  	 
			            </c:if>   
			            	   <c:if test="${row.data_access_interface == 1}">   
				  	  <%@ include file="../input/fastselect.jsp" %> 
				  	  <c:set var="Keyinterface" value="1" />  		
				  	
					</c:if>
				  </div> 
	
	
		
	    </c:when>
	       
	          <c:when test='${row.keymap.change_format == "Mandatory Reference data" }'>  


	  	  <%@ include file="../input/fullsearch2.jsp" %>   		 

		
		
	    </c:when>
	       
	       
	     <c:when test='${row.keymap.change_format == "Enum" }'>
	        
   <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>

                                      <select class="${readonly}select2 form-control <c:if test="${row.display != null}">checkboxreadonly</c:if>"
                                       id="${row.keymap.mainkey}"  name="edata.${key}"   ${readonly} 
                                        <c:if test="${readonly != ''}">disabled</c:if>>
                <c:forEach items="${row.dataset_data}" var="datasets" varStatus="count">
                    <option value="${datasets.dataset_data_title}"
                        <c:if test="${edatas[key] == datasets.dataset_data_title}">selected</c:if>>
                        ${datasets.dataset_data_title} 
                        
                         	    <c:if test="${row.dataset.dataset_show_sub == 1}">
                        		 <c:if test="${datasets.dataset_data_subtitle1 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle1}
                        		  </c:if>
                        		 <c:if test="${datasets.dataset_data_subtitle2 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle2}
                        		  </c:if>
                        		   <c:if test="${datasets.dataset_data_subtitle3 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle3}
                        		  </c:if>
                        		   <c:if test="${datasets.dataset_data_subtitle4 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle4}
                        		  </c:if>
                          </c:if>
                     
                        
                        
                    </option>
                </c:forEach>
            </select>
                        
                        
                        
                <c:if test="${row.allow_adding_items  == 1}">                       
       <span class="input-group-text" id="basic-addon-search1"  >
                                      <a href="#" 
                                      onclick="shows2('draggable-window3','จัดการชุดข้อมูล'); getData('/addsubdatasetapp-condition/${row.keymap.enum_id}', 'mainbody3')">  
                                           <img  src="/app/system/icon/database  add.ico" />
                      </a>
                                 </span> 
                                 </c:if>   
                      </div>
               
 <script>
    new TomSelect("#${row.keymap.mainkey}", {
        create: false,          // ห้ามพิมพ์ค่าใหม่เอง (ต้องเลือกจากที่มี)
        sortField: {
            field: "text",
            direction: "asc"
        },
        maxOptions: 50,         // **สำคัญ** แสดงผลลัพธ์แค่ 50 ตัวพอ (พิมพ์แล้วค่อยกรอง) จะได้ไม่หน่วง
        allowEmptyOption: true
    });
</script>


	    </c:when>
	    

	        <c:when test='${row.keymap.change_format == "DB_User" || row.keymap.change_format == "DB_Department" }'>
	        
	
	            <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>
						    <c:if test='${ row.keymap.change_format == "DB_User"}'>
                                 	<%@ include file="inputdb_user.jspf" %>       
                                 </c:if>       
                                <c:if test='${ row.keymap.change_format == "DB_Department"}'>
                                 	<%@ include file="inputdb_department.jspf" %>       
                                 </c:if>       
                                 
							 </div> 
	                 
	        
  

	    </c:when>
	    
	            <c:when test='${row.keymap.change_format == "Segmentation_Profile_Static_snapshot"  }'>
	        <div class="f-row"  title="KET->${row.keymap.mainkey }">
							<label for="i51">${title } ${disabled }</label>
                                 	<%@ include file="segmentation_profile.jspf" %>       
							 </div> 
	    </c:when>
	         <c:when test='${row.keymap.change_format == "Fulladdress"  }'>
	        <div class="f-row"  title="KET->${row.keymap.mainkey }">
							<label for="i51">${title } ${disabled }</label>
                                 	<%@ include file="fulladdress.jspf" %>       
							 </div> 
	    </c:when>
	            <c:when test='${row.keymap.change_format == "Promotion"  }'>
	         <div class="f-row"  title="KET->${row.keymap.mainkey }">
							<label for="i51">${title } ${disabled }</label>
				
                                 	<%@ include file="Promotion.jspf" %>       
                          
							 </div> 
	    </c:when>
	    
	    
	       
	       	     <c:when test='${row.keymap.change_format == "TEXT" }'>
	 <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>

						 <textarea rows="4" class="form-control newinput"  id="${row.keymap.mainkey}" name="edata.${key}"  ${readonly }>${edatas[key]}</textarea>
							 </div> 
	                 
	       </c:when>
	       
	          	     <c:when test='${row.keymap.change_format == "DATE" }'>

	                 
 <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>
						  <input type="date" class="form-control newinput" id="${row.keymap.mainkey}" name="edata.${key}"  value="${edatas[key]}" ${readonly }>
                                 
							 </div> 
	                 
	                 
	       </c:when>
	       
	       
	       
	       
	       
	       <c:when test='${row.keymap.change_format == "DATETIME"}'>

  
  
 <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>
						  <input type="datetime-local"
             class="form-control newinput"
             id="${row.keymap.mainkey}"
             name="edata.${key}"
             value="${fn:replace(fn:replace(edatas[key], ' ', 'T'), '.000', '')}"
             ${readonly}>
                                 
							 </div> 
</c:when>
	       
	       
	          	     <c:when test='${row.keymap.change_format == "NUMBER" }'>

	                 
	 <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>
						  <input type="number" class="form-control newinput"  step="0.1" id="${row.keymap.mainkey}" name="edata.${key}" 
						   value="${edatas[key] + 0}" ${readonly }>
							 </div> 
	                 
	       </c:when>
	       
	    
	       
	       
	    <c:when test='${row.keymap.change_format == "Rating"}'>
	     <div class="mb-1 row" title="KET->${row.keymap.mainkey }">
<div   title="KET->${row.keymap.mainkey }">${title } *${disabled }</div>
	    <div class="col-sm-12">   
                          				     <div class="input-group">
                                                <input type="number" class="touchspin-min-max newinput" value="${transaction[row.keymap.mainkey] +0}" name="${appmodel }${row.keymap.mainkey}" ${readonly }/>
                                            </div>
	             </div>
	                 </div> 
	    </c:when>




	    <c:when test='${row.keymap.change_format == "VIEW"}'>
	
	                 
	                      <div title="KET->${row.keymap.mainkey }">
							<label for="i51">${title } *${disabled }</label>
						 <input type="text" class="form-control" value="${transaction[row.keymap.mainkey]}" id="${row.keymap.mainkey}"  readonly/>
							 </div> 
	    </c:when>



          	    <c:when test='${row.keymap.change_format == "checkbox"}'>                   
                             
                                 <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>
                                    <div style="display: block;"> <c:forEach items="${row.dataset_data}" var="datasets" >
             <input type="checkbox" class="form-select <c:if test="${row.display != null}">checkboxreadonly</c:if>" name ="edata.${key}" 
              style="margin-top:0px;"  value="${datasets.dataset_data_title}"  
             <c:if test="${edatas[key].contains(datasets.dataset_data_title)}">checked</c:if> > 
             ${datasets.dataset_data_title} 
             
     
                         	    <c:if test="${row.dataset.dataset_show_sub == 1}">
                        		 <c:if test="${datasets.dataset_data_subtitle1 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle1}
                        		  </c:if>
                        		 <c:if test="${datasets.dataset_data_subtitle2 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle2}
                        		  </c:if>
                        		   <c:if test="${datasets.dataset_data_subtitle3 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle3}
                        		  </c:if>
                        		   <c:if test="${datasets.dataset_data_subtitle4 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle4}
                        		  </c:if>
                          </c:if>
             
             <br> 
        </c:forEach>    
    </div>
                                 </div> 		

       </c:when>
	     <c:when test='${row.keymap.change_format == "TAG" }'>
	        

	        
    <div  title="KET->${row.keymap.mainkey }">
      	<label for="i51">  ${title } * ${disabled}</label>

   <input class='form-tags'  id="${row.keymap.mainkey}"  name="edata.${key}"  ${readonly}  placeholder='write some tags' value='${edatas[key]}' data-blacklist="fuck,shit">
       </div>

	    </c:when>


<c:when test='${row.keymap.change_format != "" }'>
 <div class="f-row"  title="KET->${row.keymap.mainkey }"><label>${title }:</label>
		<input type="text" placeholder="${title }"  id="${row.keymap.mainkey}" name="edata.${key}"  value="${edatas[key]}" ${readonly } autocomplete="off">
		
	 </div>            
 </c:when>
	    <c:otherwise>
	
	    </c:otherwise>
	    
</c:choose>  
              
   
        </c:if>       
        
        
