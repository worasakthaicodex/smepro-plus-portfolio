<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
 
<c:set var="key" value="data_value${count.count +keycount}" scope="page"/>




       
       

                                               
                                               
                                               
        <c:if test='${!row.field_type.equals("Title")}'> 


                                        
                                                   <c:if test='${row.field_type.equals("text")}'>   
				
									            <input type="text" name="data_value${count.count +keycount}" placeholder="${title }"  value="${edata[key]}" ${readonly }>
									           
                                                  </c:if>
                                                  
                                                  
                                                  
                                                  
           

                    
                                                 <c:if test='${row.field_type.equals("number")}'>
                                            			
                                          
									         <input type="number" step="0.01" min="0" class=" form-control"  name="data_value${count.count +keycount}" value="${edata[key]}" ${readonly }> 
									         
                                            			
                                            			
                                            			
                                                  </c:if>
                               
                             <c:if test='${row.field_type.equals("auto_date")}'>
												
												
												<c:set var="date_auto" value="${date_insert}" scope="page"/>
											 <c:if test='${edata != null}'>
											 <c:set var="date_auto" value="${edata[key]}" scope="page"/>		 
											 </c:if>

									         <input type="text"  class="form-control"  name="data_value${count.count +keycount}" value="${date_auto}" readonly > 	
                                 </c:if>
                                                  
                                                  
                                                    <c:if test='${row.field_type.equals("textarea")}'>
									       <textarea rows="4" name="data_value${count.count +keycount}"  id="data_value${row.field_id }" class="form-control" ${readonly }>${edata[key]}</textarea>
									        
                                                  </c:if>
                                                  
                                             
                                                  
                                                  
                                              <c:if test='${row.field_type.equals("date")}'>      
                                           
									             <input type="date" name="data_value${count.count +keycount}"  id="data_value${row.field_id }" class="form-control" value="${edata[key]}" ${readonly }>
									        
                                                  </c:if>
                                                  
                                                   <c:if test='${row.field_type.equals("time")}'>      
                                                   
                                                           			        <div>
									            <label for="i51">${title }</label>
									          <input type="time" class="form-control   "  name="data_value${count.count +keycount}" value="${edata[key]}" ${readonly }>
									            </div>  
                                                   
                                         
                                                  </c:if> 



                                                    <c:if test='${row.field_type.equals("checkbox")}'>
                                          
									         
    <div style="display: block;"> <c:forEach items="${row.dataset_data}" var="datasets" >
             <input type="checkbox" class="form-select <c:if test="${row.display != null}">checkboxreadonly</c:if>" name ="data_value${count.count +keycount}" 
              style="margin-top:0px;"  value="${datasets.dataset_data_title}"  
             <c:if test="${edata[key].contains(datasets.dataset_data_title)}">checked</c:if> id="data_value${row.field_id }"> 
             ${datasets.dataset_data_title} 
             
     
                         	    <c:if test="${row.dataset.dataset_show_sub == 1}">
                        		 <c:if test="${datasets.dataset_data_subtitle1 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle1}
                        		  </c:if>
                        		 <c:if test="${datasets.dataset_data_subtitle2 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle2}
                        		  </c:if>
                        		   <c:if test="${datasets.dataset_data_subtitle3 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle3}
                        		  </c:if>
                        		   <c:if test="${datasets.dataset_data_subtitle4 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle4}
                        		  </c:if>
                          </c:if>
             
             <br> 
        </c:forEach>    
    </div>
									      
                                                    </c:if>
                                             
                                 				   <c:if test='${row.field_type.equals("select")  }'>     
                                          

									           <select class="${row.display}select2 form-control <c:if test="${row.display != null}">checkboxreadonly</c:if>" id="data_value${row.field_id }"  name="data_value${count.count +keycount}" 
                                       >
                <c:forEach items="${row.dataset_data}" var="datasets" >
                    <option value="${datasets.dataset_data_title}" 
                        <c:if test="${edata[key] == datasets.dataset_data_title}">selected</c:if>>
                        ${datasets.dataset_data_title} 
                        
           
                      	    <c:if test="${row.dataset.dataset_show_sub == 1}">
                        		 <c:if test="${datasets.dataset_data_subtitle1 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle1}
                        		  </c:if>
                        		 <c:if test="${datasets.dataset_data_subtitle2 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle2}
                        		  </c:if>
                        		   <c:if test="${datasets.dataset_data_subtitle3 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle3}
                        		  </c:if>
                        		   <c:if test="${datasets.dataset_data_subtitle4 != null}">
                        		  ${row.dataset.dataset_sub_intermediate}${datasets.dataset_data_subtitle4}
                        		  </c:if>
                          </c:if>
                     
                         
                         
                    </option>
                </c:forEach>
            </select>
                                                  </c:if>
                                     


       </c:if>                                   
                                          
                                       
                               
                                     
     