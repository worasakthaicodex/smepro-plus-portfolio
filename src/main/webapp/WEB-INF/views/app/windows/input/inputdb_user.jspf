<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>                    
                    
<c:set var="linkId" value="${edatas[key]}" />  
<c:if test="${transaction[row.keymap.mainkey] != null}">
    <c:set var="linkId" value="${transaction[row.keymap.mainkey]}" />  
</c:if>

<div class="search-select-box" id="box-${row.keymap.mainkey}" style="display: flex;">

    <input type="hidden" 
           id="hidden-${process.id}-${row.keymap.mainkey}" 
           name="edata.${key}" 
           value="${linkId}">

    <select id="input-${process.id}-${row.keymap.mainkey}" 
            placeholder="พิมพ์เพื่อค้นหา..." 
            autocomplete="off"
            ${readonly}>
    </select>
  
 
    <div id="statussave${edatas[key]}"></div>
</div>

<script>
    // 1. 🌟 สร้าง Array ข้อมูลจาก Loop JSP (ยังไม่ต้องใช้ AJAX) 🌟
    var db_${row.keymap.mainkey} = [
        <c:forEach items="${db_users}" var="alls" varStatus="loop">
            {
                value: "${alls.user_id}_${alls.user_name}", // เก็บแบบ รหัส|ชื่อ เพื่อให้ onChange แกะค่าง่ายๆ
                text: "${alls.user_id}_${alls.user_name}"   // ข้อความที่จะโชว์ให้ User เห็นตอนค้นหา
            }<c:if test="${!loop.last}">,</c:if>
        </c:forEach>
    ];

    // 2. 🌟 เริ่มการทำงานของ TomSelect 🌟
    // เติม ${row.keymap.mainkey} ต่อท้ายชื่อตัวแปรกันมันชนกันเวลาหน้าเดียวมีหลายช่อง
    var tomSelect_${row.keymap.mainkey} = new TomSelect("#input-${process.id}-${row.keymap.mainkey}", {
        options: db_${row.keymap.mainkey}, // ยัด Array ที่ Loop มาใส่ตรงนี้เลย
        valueField: 'value', 
        labelField: 'text',  
        searchField: 'text',
        create: false,          
        maxOptions: 50,         
        allowEmptyOption: true,
        
        onChange: function(value) {
            var inputHidden = document.getElementById("hidden-${process.id}-${row.keymap.mainkey}");
            var inputShow2 = document.getElementById("${process.id}-customer_name"); // ตรวจสอบ ID ปลายทางให้ตรง

            if (!value) {
                if (inputHidden) inputHidden.value = ""; 
                if (inputShow2) inputShow2.value = ""; 
                return;
            }
            
            try {
                // แกะค่า รหัส|ชื่อ เหมือนที่คุณออกแบบไว้
                var splitData = value.split('|');
                var val1 = splitData[0]; // รหัส
                var val2 = splitData[1]; // ชื่อ
                
                if (inputHidden) inputHidden.value = val1.trim();
                if (inputShow2) inputShow2.value = (val2 ? val2.trim() : "");
                
            } catch (e) {
                console.error("TomSelect error:", e);
            }
        }
    });

    // ==============================================================
    // 🌟 โหลดข้อมูลชื่อลูกค้าตอนเปิดหน้าเว็บ (ค้นจาก Array แทน AJAX)
    // ==============================================================
    var initialId_${row.keymap.mainkey} = "${linkId}";
    if (initialId_${row.keymap.mainkey} && initialId_${row.keymap.mainkey}.trim() !== "") {
        
        // วิ่งหาใน Array ว่ามีตัวไหนที่รหัส (ฝั่งซ้ายของ |) ตรงกับ initialId บ้าง
        var foundItem = db_${row.keymap.mainkey}.find(function(item) {
            return item.value.split('|')[0] === initialId_${row.keymap.mainkey};
        });

        if (foundItem) {
            // สั่งให้ TomSelect เลือกค่านี้
            tomSelect_${row.keymap.mainkey}.setValue(foundItem.value, true); // true = ไม่ต้องกระตุ้น onChange ซ้ำ
            
            // เอาชื่อยัดใส่ inputShow2 เผื่อไว้
            var inputShow2 = document.getElementById("${process.id}-customer_name");
            if (inputShow2) {
                inputShow2.value = foundItem.value.split('|')[1].trim();
            }
        }
    }
</script>