<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
 


         
                     <div class="modal modal-slide-in sidebar-todo-modal fade" id="new-stock-modal" >
                            <div class="modal-dialog sidebar-lg"  style="width:1000px">
                                <div class="modal-content p-0">
                                     <form:form method="POST"  modelAttribute="search_workflow_db"  id="subdata_search"  name="subdata_search" class="todo-modal needs-validation" onsubmit="return false;">
                                    
                                        <div class="modal-header align-items-center mb-1">
                                            <h5 class="modal-title" id="supportdata">Support Data</h5>
                                            <div class="todo-item-action d-flex align-items-center justify-content-between ms-auto">
                                              
                                                <i data-feather="x" class="cursor-pointer" data-bs-dismiss="modal" stroke-width="3"></i>
                                            </div>
                                        </div>
                                        <div class="modal-body flex-grow-1 pb-sm-0 pb-3">
                                       
                                         <div class="todo-task-list-wrapper list-group" id="wrappermain">
                                   

                                       </div>
                                        <input  type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                                        </div>
                                            	 
                                    </form:form>
                                </div>
                            </div>
                        </div>
 	         


         <div class="modal fade" id="addNewCard" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-transparent">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body px-sm-5 mx-50 pb-5">
                                <h1 class="text-center mb-1" id="addNewCardTitle"> <spring:message code="dar.check" /></h1>
                              

                                <!-- form -->
                                <form  action="/flowdoc-filemanager" method="POST" >
                                    <input  type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                                
                                
                                
            
            <c:forEach items="${eformfields }"  var="row" varStatus="count">

            
                                 <c:set var="title" value="${row.field_label }" />   
                       <c:set var="appfield" value="${upload_pn.upload_pn_appfield }" /> 
                          <c:if test="${fn:contains(appfield,row.field_label)}"> 
             
                               
                                                <div class="mb-1">
                                                    <label class="form-label" for="first-name-column">${title }   </label>
                                                    
                                                 <c:if test='${row.field_type.equals("select") && !row.field_cal_type.equals("product") &&  !row.field_cal_type.equals("lot")  }'>     
                                           
                                                 <select name="data_value${count.count }"  id="data_values${row.field_id }" class="form-select">
                                                 </select>
                                                  </c:if>
                                                   <c:if test='${row.field_type.equals("text")}'>   
                                                 <input type="text" name="data_value${count.count }"  id="data_values${row.field_id }" class="autocomplete-input form-control">
                                                  </c:if>
                                                  
                                                  
                                          
                                                        <c:if test='${row.field_type.equals("number") }'>  
                                            					      <input type="number" name="data_values${count.count }"  id="data_value${row.field_id }" class="form-control">
                                                     </c:if>
                                             
        
                                                 
                                                 
                                                    <c:if test='${row.field_type.equals("textarea")}'>      
                                                 <textarea name="data_value${count.count }"  id="data_values${row.field_id }" class="form-control"></textarea>
                                                  </c:if>
                                              <c:if test='${row.field_type.equals("date")}'>      
                                               <input type="date" name="data_value${count.count }"  id="data_values${row.field_id }" class="form-control">
                                                  </c:if>
                                                  
                                                   <c:if test='${row.field_type.equals("time")}'>      
                                              <input type="time" class="form-control mydata"  name="data_value${count.count }" id="data_values${row.field_id }"  placeholder="hh:mm" >
                                                  </c:if> 
                                                  
                                                  
                                                               
                                               
                                                  
                                                    <c:if test='${row.field_type.equals("checkbox")}'>
                                                 <br>      
                                                <span id="data_value${row.field_id }"></span>
                                                    </c:if>
                                             
                                           <c:set var="totaltitle" value="${count.count }" />
                                            
                                            
                                            <c:if test='${totaltitle == null}'>  <c:set var="totaltitle" value="1" />  </c:if> 
                                            
                                    <input type="hidden" name="data_title${count.count }"  id="data_titles${row.field_id }"  value="${title }">     
                                   
                                   
                                    <input type="hidden" name="field_cal_type"  id="field_cal_type"  value="${row.field_cal_type }">         
                                     <input type="hidden" name="field_field_no"  id="field_field_no"  value="${row.field_field_no }">    
                                     
                                    </div>   
                                    
                                       </c:if> 
                            
                        </c:forEach>
                        
                        
                                                	<div class="mb-1">
                                                    <label class="form-label" for="first-name-column">Status   </label>
                                 						 <div>    
								                           <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
									                       <input type="radio" class="btn-check mydata" value="Good"  name="data_status" id="btnradio1" autocomplete="off" >
									                       <label class="btn btn-outline-success waves-effect" for="btnradio1">Good</label>
								
									                       <input type="radio" class="btn-check mydata" value="Normal"   name="data_status" id="btnradio2" autocomplete="off" checked>
									                       <label class="btn btn-outline-warning waves-effect" for="btnradio2">Normal</label>
								
									                       <input type="radio" class="btn-check mydata" value="Bad"  name="data_status" id="btnradio3" autocomplete="off">
									                       <label class="btn btn-outline-danger waves-effect" for="btnradio3">Bad</label>
									                       </div>
									                         </div>
                                    				</div>
                                    
                                    <div class="col-12">
                                        <label class="form-label" for="modalAddCardNumber"><spring:message code="dar.reason" /></label>
                                        <div class="input-group input-group-merge">
                                       
                                            <input id="modalAddCardNumber" name="note" class="form-control autocomplete-input3" type="text" />
                                        
                                            <span class="input-group-text cursor-pointer p-25" id="modalAddCard2">
                                                <span class="add-card-type"></span>
                                            </span>
                                        </div>
                                         
                       
                                      
                                          
                                    </div>
                                    
                                    
                                    
                                    
                                    

                                    <div class="col-12 text-center">
                                        <button type="submit" class="btn btn-primary me-1 mt-1" >Save</button>
                                        <button type="reset" class="btn btn-outline-secondary mt-1" data-bs-dismiss="modal" aria-label="Close">
                                         Cancel
                                        </button>
                                    </div>
                                 <input type="hidden" name="Actiontype"  value="Pass">       
                          <input type="hidden" name="id" value="${edatas.data_id}">          
                             <input type="hidden" name="Nextstpe_id" value="${Nextstpe_id}">          
                          <input type="hidden" name="process_id"  value="${process.id}"> 
                           <input type="hidden" name="Flow"  value="${Appstep_no}"> 
                            <input type="hidden" name="Nextstpe"  value="${Nextstpe}"> 
                                    
                                    
                                </form>
                            </div>
                        </div>
                    </div>
                    
<script>             


 var element = document.getElementById("app_${group}");
element.classList.add("active");                                                                 

	  $( function() {
		  
		  var newdata = 'เข้าตามเเผน,เข้าไม่ตามเเผน,ไม่ได้เข้า,เลื่อน'; // ข้อความเริ่มต้
		  var trimmedData = newdata.trim(); // ตัดช่องว่างที่อยู่ท้ายสตริง
		var dataItems = trimmedData.split(',');
	    $( ".autocomplete-input3" ).autocomplete({
	      source: dataItems
	    });
	  } );
	  
	  
	  
</script> 
                </div>
               


      <div class="modal fade" id="addNewCards" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-transparent">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body px-sm-5 mx-50 pb-5">
                                <h1 class="text-center mb-1" id="addNewCardTitle"> <spring:message code="dar.uncheck" /></h1>
                              

                                <!-- form -->
                                <form    action="/flowdoc-filemanager" id="formaddNewCardValidation" class="row gy-1 gx-2 mt-75" method="POST" >
                                    <input  type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                                    
                                    
                                    <div class="col-12">
                                        <label class="form-label" for="modalAddCardNumber"><spring:message code="dar.reason" /></label>
                                        <div class="input-group input-group-merge">
                                       
                                            <input id="modalAddCardNumber" name="note" class="form-control autocomplete-input2" type="text" />
                                              
                                            <span class="input-group-text cursor-pointer p-25" id="modalAddCard2">
                                                <span class="add-card-type">   </span>
                                            </span>
                                        </div>
                                      
                                      
                                          
                                    </div>
  										<div class="mb-1">
                                                    <label class="form-label" for="first-name-column">Status  </label>
                                 						 <div>    
								                           <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
									                       <input type="radio" class="btn-check mydata" value="Good"  name="data_status" id="btnradios1" autocomplete="off" >
									                       <label class="btn btn-outline-success waves-effect" for="btnradios1">Good</label>
								
									                       <input type="radio" class="btn-check mydata" value="Normal"   name="data_status" id="btnradios2" autocomplete="off" checked>
									                       <label class="btn btn-outline-warning waves-effect" for="btnradios2">Normal</label>
								
									                       <input type="radio" class="btn-check mydata" value="Bad"  name="data_status" id="btnradios3" autocomplete="off">
									                       <label class="btn btn-outline-danger waves-effect" for="btnradios3">Bad</label>
									                       </div>
									                         </div>
                                    				</div>
                                   
                                

                                    <div class="col-12 text-center">
                                        <button type="submit" class="btn btn-primary me-1 mt-1"   data-bs-dismiss="modal" aria-label="Close">Save</button>
                                        <button type="reset" class="btn btn-outline-secondary mt-1" data-bs-dismiss="modal" aria-label="Close">
                                         Cancel
                                        </button>
                                    </div>
      
                          <input type="hidden" name="Actiontype"  value="Reject"> 
   							<input type="hidden" name="id" value="${edatas.data_id}">          
                             <input type="hidden" name="Nextstpe_id" value="${Nextstpe_id}">          
                          	<input type="hidden" name="process_id"  value="${process.id}"> 
                           <input type="hidden" name="Flow"  value="${Appstep_no}"> 
                            <input type="hidden" name="Nextstpe"  value="${Nextstpe}">  

                                </form>
                            </div>
                        </div>
                    </div>
                    
                                                 <script>

                                             
                                                		    
                                                		                                               
                                                 
                                                 
	  $( function() {
		  
		  var newdata = 'ไม่ได้เข้า,ข้อมูลไม่ถูกต้อง'; // ข้อความเริ่มต้
		  var trimmedData = newdata.trim(); // ตัดช่องว่างที่อยู่ท้ายสตริง
		var dataItems = trimmedData.split(',');
		  
	    $( ".autocomplete-input2" ).autocomplete({
	      source: dataItems
	    });
	  } );
	  
	  
	  function reject(id){
			$("#idreject").val(id);
		}

		function app(id){
			$("#idapp").val(id);
		}
</script>     
                </div>
                
                
                
              <div   class="modal fade" id="info_flow" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-transparent">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body px-sm-5 mx-50 pb-5">
                                <h1 class="text-center mb-1" id="addNewCardTitle">Flow Log</h1>
                      <table  class="table">
                                    <thead>
                                        <tr>
           
				                                      
				                                       <th style="padding:5px;font-size:13px">NO</th >
				                                     <th style="padding:5px;font-size:13px">DATE</th >
				                                       <th style="padding:5px;font-size:13px">TYPE</th >                            
														 <th style="padding:5px;font-size:13px">TYPE</th >     
														       <th style="padding:5px;font-size:13px">SEND</th >       
														       <th style="padding:5px;font-size:13px">TO</th >       
														             <th style="padding:5px;font-size:13px">Comment</th >    
				                                    

                                        </tr>
                                    </thead>
                                    <tbody>
                                    
                            
                                    
                                
                                        <c:forEach items="${log }" var="logs"  varStatus="count">
				                                     
				                                     
				                                      <tr >
				                                       <td style="padding:5px;font-size:13px">${count.count }</td >
				                                     <td style="padding:5px;font-size:13px">${logs.flow_date}</td >
				                                      <td style="padding:5px;font-size:13px">${logs.flow_step}</td >   
				                                       <td style="padding:5px;font-size:13px">${logs.flow_type}</td >                            
														
														       <td style="padding:5px;font-size:13px">${logs.send}</td >       
														       <td style="padding:5px;font-size:13px">${logs.to}</td >       
														             <td style="padding:5px;font-size:13px">${logs.flow_comment}</td >    
				                                        </tr>
                                        </c:forEach>
                                        
                                        
                                    </tbody>
                                    </table> 
                            </div>
                        </div>
                    </div>
                    
         
                </div>
                <!--/ add new card modal  -->
                
                
                
                
                
                
                      
              <div   class="modal fade" id="info_check" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-transparent">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body px-sm-5 mx-50 pb-5">
                                <h1 class="text-center mb-1" id="addNewCardTitle"><spring:message code="check.duplicate_names"/></h1>
                      <table  class="table">
                                    <thead>
                                        <tr>
           
				                                      
				                                       <th style="padding:5px;font-size:13px">NO</th >
				                                     <th style="padding:5px;font-size:13px">NAME</th >
				                                       <th style="padding:5px;font-size:13px">NAME</th >                            
														 <th style="padding:5px;font-size:13px">Similarity</th >     
												    

                                        </tr>
                                    </thead>
                                    <tbody>
                                    
                            
                                          <c:forEach items="${levenshtein }" var="shtein" varStatus="count">  
                                           <br>
                                         
                                         
                                              <tr >
				                                       <td style="padding:5px;font-size:13px">${count.count }</td >
				                                     <td style="padding:5px;font-size:13px">${shtein.shtein_name1 }</td >
				                                      <td style="padding:5px;font-size:13px"> ${shtein.shtein_name2 }</td >   
				                                       <td style="padding:5px;font-size:13px">
											
														      <div class="fw-bold text-body-heading me-1">${shtein.distance}%</div>   
														
														    	
																	                                        
				                                        </td >                            
 


				                                        </tr>
                                         </c:forEach>
                                
                                 
                                    </tbody>
                                    </table>  
                            </div>
                        </div>
                    </div>
                    
         
                </div>
                <!--/ add new card modal  -->
                
                
                
                
                
                
                      <div class="modal fade" id="Import" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-transparent">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body px-sm-5 mx-50 pb-5">
                                <h1 class="text-center mb-1" id="addNewCardTitle">Import Csv </h1>
                              
<br>
                                <!-- form -->
                           <form method="POST" modelAttribute="edata"  action="/ImportCsvSubTable-filemanager?${_csrf.parameterName}=${_csrf.token}"   id="Importcsv" enctype="multipart/form-data"> 
                                    <input  type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                                    
                                    
                                    <div class="col-12">
                                        <label class="form-label" for="modalAddCardNumber"><spring:message code="csv.File" /></label>
                                        <div class="input-group input-group-merge">
                                       
                                            <input type="file"  name="file" id="file"   class="form-control"  required/>
                                              
                                            <span class="input-group-text cursor-pointer p-25" id="modalAddCard2">
                                                <span class="add-card-type">   </span>
                                            </span>
                                        </div>
                                      
                                      
                                          
                                    </div>
                                    
                                        <br>
  							       <div class="col-12">
                                        <label class="form-label" for="modalAddCardNumber"><spring:message code="csv.SkipFirstRow" /></label>
                                        <div class="input-group input-group-merge">
                                       
                                            <select name="SkipFirstRow" id="SkipFirstRow"   class="form-select"  required/>
                                           <option value="1"><spring:message code="csv.Yes" /></option>
                                             <option  value="0"><spring:message code="csv.No" /></option>
                                            </select>
                                              
                                   
                                        </div>
                                      
                                      
                                          
                                    </div>
                                          <br>
                                    
                                           <div class="col-12">
                                        <label class="form-label" for="modalAddCardNumber"><spring:message code="csv.SkipFirstColumn" /></label>
                                        <div class="input-group input-group-merge">
                                       
                                           <select name="SkipFirstColumn" id="SkipFirstColumn"   class="form-select"  required/>
                                               <option value="1"><spring:message code="csv.Yes" /></option>
                                             <option  value="0"><spring:message code="csv.No" /></option>
                                            </select>
                                        </div>
                                      
                                      
                                          
                                    </div>
                                    
                                    <br>
                                    
                                           <div class="col-12">
                                        <label class="form-label" for="modalAddCardNumber"><spring:message code="csv.Split" /></label>
                                        <div class="input-group input-group-merge">
                                       
                                             <select name="Spit" id="Spit"   class="form-select"  required/>
                                           <option value=",">,</option>
                                             <option  value=";">;</option>
                                                <option  value="|">|</option>
                                            </select>
                                        </div>
                                      
                                      
                                          
                                    </div>
                                

                                    <div class="col-12 text-center">
                                        <button type="submit" class="btn btn-primary me-1 mt-1"   data-bs-dismiss="modal" aria-label="Close"><spring:message code="btn.upload" /></button>
                                        <button type="reset" class="btn btn-outline-secondary mt-1" data-bs-dismiss="modal" aria-label="Close">
                                         Cancel
                                        </button>
                                    </div>
      
   							<input type="hidden" name="data_id" value="${edatas.data_id}">             
                          	<input type="hidden" name="process_id"  value="${process.id}"> 
                          	  	<input type="hidden" name="edata_type"  value="${edata_type}"> 
        					<input type="hidden" name="action_batch_insert"  value="${action_batch_insert}"> 

                                </form>
                            </div>
                        </div>
                    </div>
     
                </div>
                
                
              
                
       