<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

   
                                            <div class="modal-body">
                                                               
                <spring:message code="app.activate"  text="-​" /> : 
                
					<c:set var="namesArray" value="${fn:split(Register_Processing, ',')}" />
					
					<select class="form-select form-select-sm d-inline w-auto" name="activate_register_processing" onchange="toggleDivVisibilityactivate_processing(this)">
					    <option value="-" <c:if test="${sub_processes.activate_register_processing == '-' }">selected</c:if>>Disable</option>
					    
					    <c:forEach var="commit" items="${namesArray}">
					        <option value="${commit}" <c:if test="${sub_processes.activate_register_processing == commit }">selected</c:if>>${commit}</option>
					    </c:forEach>
					</select>
                                   <br><br>             
                 
                                   
                              <c:forEach var="rowcommit" items="${Register_Processings}">     
                                
                   
                  
                                    
                                    <c:if test="${rowcommit.actionkeys.size() > 0 }">
                                   <div id="processing-${rowcommit.name}" class="processing-div mainaction-div" style="display:none">
                                   					 <div class="mb-1 row">
                                                         <div class="col-sm-4">
                                              
                                                       
                                                       
                                                       <spring:message code="app.maincolumn"  text="-​" />
                                                        </div>
                                                           <div class="col-sm-4"><spring:message code="app.e-formcolumn"  text="-​" />  </div>
                                                             <div class="col-sm-4"><spring:message code="app.filter"  text="-​" /></div>
                                                            </div>
                                   
                                                               <div class="col-12">
                                               
                                                       <c:forEach items="${rowcommit.actionkeys }" var="row" varStatus="counts">      
		                                                      <c:set var="registerkey_id" value=" ${row.id}" />
		                                    
		                                                                   <div class="mb-1 row">
		                                                                 <div class="col-sm-4">
                                                        <label class="col-form-label" for="fname-icon"><spring:message code="${row.title }"  text="-​" /> 
                                                        
                                                    
                                                        <c:if test="${row.required == 1}">***</c:if> </label>
                                                    </div>    
		                                                               <div class="col-sm-4">  
		                                                               
		                                                                     
		                                                                <input type="hidden" name="mainkey" value="${row.mainkey }"> 
		                                                                <input type="hidden" class="form-select" name="enum_id"  value="${row.enum_id }" readonly>    
		                                                                   
		                                                                      <select class="form-select eformkey" name="eformkey">
											                                   <option value="0" selected>-</option>
											                            
											                              <c:forEach items="${eformfields }" var="fields" >    
											                             
											                                
										 <option value="${fields.field_id}" <c:if test="${row.keymap.eformkey == fields.field_id }">selected</c:if> >${fields.field_label}</option>
											                               </c:forEach>
											                                   
										 	                               </select>
										 	                           
		                                                               </div>            
		                                                                <div class="col-sm-4">         
		                                                       <c:if test="${row.type == 'Enum' }">
	      							
				                                               <select class="form-select select3s" data-custom="action${counts.count }"  multiple="multiple" >
													                                   <option value="0" selected>-</option>
													                                   
													                                   
													           <c:forEach items="${row.tag }" var="tag" varStatus="count">      
													                                   <option value="${tag.dataset_data_title}"
													                                      <c:if test="${ row.keymap.filter_enum != null && tag.dataset_data_title != null}">
													                                     <c:if test="${ row.keymap.filter_enum.contains(tag.dataset_data_title)}">
																			                selected
																			            </c:if>
																			             </c:if>>
													                                   ${tag.dataset_data_title}
													                                   </option>
													           </c:forEach>
													                                   
												 	            </select>
												 	              <c:set var="modifiedValue" value="${row.keymap.filter_enum.replace(',', '|')}" />

												 	                <input type="hidden" name="filter_enum" class="hiddenInput" value="0,${modifiedValue}"  data-custom="action${counts.count }">      
				                                                    <input type="hidden" class="form-select" name="change_format" value="Enum" readonly>   
				                                                                   <input type="hidden" name="type" value="create">
				                                                                         <input type="hidden" name="registerkey_id" value="${registerkey_id }">
				                                                    
				                                               </c:if> 
				                                               
				                                                          <c:if test="${row.type != 'Enum' }">  
				                                                          <input type="hidden" class="form-select" name="filter_enum" value="${row.source}"  readonly style="background-color:#eee">  
				                                                          <input type="text" class="form-select" name="change_format" value="${row.type}"   readonly>   
				                                                                         <input type="hidden" name="type" value="create">
				                                                                               <input type="hidden" name="registerkey_id" value="${registerkey_id }">
				                                                        
				                                                                     </c:if> 
				                                                               
				                                                                     
				                                                               </div> 
		                                                     
		                                                                 </div>  
		                                                            
		                                                                   
		                                                                   
		                                                                
		                                                                
                                                       </c:forEach>   
                                                             
         
                          
 
                  							       
                  							       
                                                             </div>
                                                            </div>
                                                            </c:if>
                                                </c:forEach>
                                                
                                
                                                          	
                                   
                                           
                                            </div>
                                            
      <script>


    $(document).ready(function () {
        $(".select3s").select2({
            tags: true
        }).on("change", function () {
            let selectedValues = $(this).val();
            let customId = $(this).data("custom"); // ดึงค่า data-custom
            
            
            // ค้นหา hidden input ที่มี data-custom ตรงกัน
            $('input[name="filter_enum"][data-custom="' + customId + '"]')
                .val(selectedValues ? selectedValues.join("|") : "");
            $('input[name="actionfilter_enum"][data-custom="' + customId + '"]')
            .val(selectedValues ? selectedValues.join("|") : "");
        });
        
        
        // ค้นหา hidden input ที่มี data-custom ตรงกัน
 

    });
</script>                                        
      <script>                                      

      
      $(document).ready(function () {
  	    var selectedOption = document.querySelector('select[name="activate_register_processing"]');
  	    if (selectedOption && selectedOption.value !== '-') {
  	    	toggleDivVisibilityactivate_processing(selectedOption); // Call the function with the selected element
  	    }
  	});
      

                                      
       function toggleDivVisibilityactivate_processing(radio) {
    	
   
    	
        // Hide all divs and disable inputs inside them
              var allDivs = document.querySelectorAll('.mainaction-div');
        allDivs.forEach(function(div) {
            div.style.display = 'none';
            var inputs = div.querySelectorAll('input, select');
            inputs.forEach(function(input) {
                input.disabled = true;  // Disable the input to prevent form submission
            });
        });
  	  // Show the selected div and enable inputs inside it
        var selectedDiv = document.getElementById("processing-"+radio.value);
  	  
  	  
  	  
        if (selectedDiv) {
        	
        	
            selectedDiv.style.display = 'block';
            var selectedInputs = selectedDiv.querySelectorAll('input, select');
            selectedInputs.forEach(function(input) {
                input.disabled = false;  // Enable inputs so they can be submitted
            });
        }
    	
      
    }                                         
       
       </script>   
       
       
      <script>
const allSelects3 = document.querySelectorAll('.eformkey');

function updateOptions3() {
    const selectedValues3 = new Set();


    
    // เก็บค่าที่ถูกเลือกจาก select ที่ไม่ถูก disable
    allSelects3.forEach(select => {
        if (!select.disabled) {
            const val = select.value;
            if (val !== "0") {
            	selectedValues3.add(val);
            }
        }
    });

    // ซ่อน options ซ้ำจากทุก select (แม้จะ disabled)
    allSelects3.forEach(select => {
        const currentVal = select.value;

        [...select.options].forEach(option => {
            if (option.value === "0" || option.value === currentVal) {
                option.hidden = false;
            } else {
                option.hidden = selectedValues3.has(option.value);
            }
        });
    });
}

allSelects3.forEach(select => {
    select.addEventListener("change", updateOptions3);
});

// เรียกตอนโหลดหน้า
updateOptions3();
</script> 
       
       
                                          