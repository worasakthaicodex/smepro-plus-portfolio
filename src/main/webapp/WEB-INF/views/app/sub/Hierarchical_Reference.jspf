     <%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>   
                                            <div class="modal-body">
                                                               
  

	          <spring:message code="app.activate" text="-" /> :
					
					<c:set var="namesArray" value="${fn:split(Hierarchical, ',')}" />
					  		
					<select class="form-select form-select-sm d-inline w-auto" name="activate_hierarchical_reference" onchange="toggleDivHierarchical(this)">
					    <option value="-" <c:if test="${sub_processes.activate_hierarchical_reference == commit }">selected</c:if>>Disable</option>
					    
					    <c:forEach var="commit" items="${namesArray}">
					        <option value="${commit}" <c:if test="${sub_processes.activate_hierarchical_reference == commit }">selected</c:if>>${commit}</option>
					    </c:forEach>
					</select>
					

                        <br><br> 
                    
 				
 					
 					
                                  <c:forEach var="rowcommit" items="${Hierarchicals}">     
                                 
                                 
                                 
                                 
                                    <c:if test="${rowcommit.actionkeys.size() > 0 }">
                  
                                   	   <div id="hierarchical-${rowcommit.name}" class="reference-div mainaction-div" style="display:none">	

                            
	
                                                               <div >
                                           		
<c:set var="shownGroups" value="" />

<c:forEach var="row" items="${rowcommit.actionkeys}">
    <c:set var="group" value="${row.keygroups}" />

    <c:if test="${not fn:contains(shownGroups, group)}">
        <details>
            <summary><spring:message code="${group}"  text="-​" /> </summary>

<br>
	 <div class="mb-1 row">
                                                         <div class="col-sm-4">
                                              
                                                  
                                                       
                                                       
                                                       <spring:message code="app.maincolumn"  text="-​" />
                                                        </div>
                                                           <div class="col-sm-4"><spring:message code="app.e-formcolumn"  text="-​" />  </div>
                                                             <div class="col-sm-4"><spring:message code="app.filter"  text="-​" /></div>
                                                            </div>
                                   

         
                 <c:forEach items="${rowcommit.actionkeys }" var="row" varStatus="counts">      
		                                           
		                                                 <c:set var="registerkey_id" value=" ${row.id}" />
		                                           
		                                          <c:if test="${row.keygroups == group}">                 
		                                           
		                                                                   <div class="mb-1 row">
		                                                                 <div class="col-sm-4">
                                                        <label class="col-form-label" for="fname-icon"><spring:message code="${row.title }"  text="-​" /> 
                                                        
                                                    
                                                        <c:if test="${row.required == 1}">***</c:if> </label>
                                                    </div>    
		                                                               <div class="col-sm-4">  
		                                                               
		                                                                     
		                                                                <input type="hidden" name="referencemainkey" value="${row.mainkey }"> 
		                                                                <input type="hidden" class="form-select" name="referenceenum_id"  value="${row.enum_id }" readonly>    
		                                                                   
		                                                                      <select class="form-select" name="referenceeformkey">
											                                   <option value="0" <c:if test="${row.keymap.eformkey == 0 }">selected</c:if>>-</option>
											                            
											                              <c:forEach items="${eformfields }" var="fields" >    
											                             
											                                
										 <option value="${fields.field_id}" <c:if test="${row.keymap.eformkey == fields.field_id }">selected</c:if> >${fields.field_label}</option>
											                               </c:forEach>
											                                   
										 	                               </select>
										 	                           
		                                                               </div>            
		                                                                <div class="col-sm-4">         
		                                                       <c:if test="${row.type == 'Enum' }">
	      							
				                                               <select class="form-select select2s" data-custom="reference${counts.count }"  multiple="multiple">
													                                   <option value="0">ALL</option>
													                                   
													                                   
													           <c:forEach items="${row.tag }" var="tag" varStatus="count">      
													                                   <option value="${tag.dataset_data_title}"
													                                     <c:if test="${row.keymap.filter_enum.contains(tag.dataset_data_title)}">
																			                selected
																			            </c:if>>
													                                   ${tag.dataset_data_title}
													                                   </option>
													           </c:forEach>
													                                   
												 	            </select>
												 	              <c:set var="modifiedValue" value="${row.keymap.filter_enum.replace(',', '|')}" />
 																		<c:if test="${row.keymap.filter_enum == null }">
 																		 <c:set var="modifiedValue" value="0" />
 																		</c:if> 
                                                                     

												 	                <input type="hidden" name="referencefilter_enum" class="hiddenInput" value="${modifiedValue}"  data-custom="reference${counts.count }">      
				                                                    <input type="hidden" name="referencechange_format" value="Enum" readonly>   
				                                                    	<input type="hidden"  name="reference_type" value="hierarchical_reference"  >   
				                                                    	    <input type="hidden" name="registerkey_id" value="${registerkey_id }">   
				                                               </c:if> 
				                                               
				                                                          <c:if test="${row.type != 'Enum' }">  
				                                                          <input type="text" class="form-select" name="referencefilter_enum" value="${row.source}"  readonly style="background-color:#eee">  
				                                                          <input type="hidden"  name="referencechange_format" value="${row.type}"   readonly>   
				                                                          	<input type="hidden"  name="reference_type" value="hierarchical_reference"  >   
				                                                          	    <input type="hidden" name="registerkey_id" value="${registerkey_id }">   
				                                                                     </c:if> 
				                                                               
				                                                                     
				                                                               </div> 
		                                                     
		                                                                 </div>  
		                                                            
		                                                                   
		                                                                   
		                                                       </c:if>         
		                                                                
                                                       </c:forEach>   
                                                             
         
            
            
        </details>

        <!-- เพิ่มชื่อกลุ่มนี้ไว้ใน shownGroups เพื่อไม่แสดงซ้ำ -->
        <c:set var="shownGroups" value="${shownGroups},${group}" />
    </c:if>
</c:forEach>    

 <script>

 const allSelects = document.querySelectorAll('select[name="referenceeformkey"]');

 function updateOptions() {
     const selectedValues = new Set();

     allSelects.forEach(select => {
         const val = select.value;
         if (val !== "0") {
             selectedValues.add(val);
         }
     });

     allSelects.forEach(select => {
         const currentVal = select.value;

         [...select.options].forEach(option => {
             if (option.value === "0" || option.value === currentVal) {
                 option.hidden = false;
             } else {
                 option.hidden = selectedValues.has(option.value);
             }
         });
     });
 }

 allSelects.forEach(select => {
     select.addEventListener("change", updateOptions);
 });

 // เรียกตอนโหลดหน้า เพื่อเคลียร์ค่าซ้ำตั้งแต่ต้น
 updateOptions();
</script>  

                     		
                                                                                     
                             <br> 
                                                   
                                                            
                                                            
                                                             	 <div class="mb-1 row">
                                              <hr>          	 
                                                                          	 <div class="mb-1 row" style="display:none">
                                              <hr>          	 
                                                        	
                                                        
                                    <small class="text-muted"><spring:message code="app.batchmodifyinfo"  text="-​" /> .</small>
                                   <br><br>             	 
                                                         <div class="col-sm-4">
                                              
                                                       
                                                       
                                                       <spring:message code="app.batchmodify"  text="-​" />
                                                        </div>
                                                        
                                                                    
                                                                      
                                                                          <div class="col-sm-8">  
                                                             
                                                                           <select class="form-select select2"  name="action_batch_hierarchical"   multiple="multiple">
													                           
													                             <c:forEach items="${rowcommit.actionkeys }" var="rowed" varStatus="counts">  
													                             <spring:message code="${rowed.title }"  text="-​" var="vardata" />
													                              <option value="${rowed.mainkey }"
													                              <c:if test="${sub_processes.action_batch_hierarchical.contains(rowed.mainkey)}">
																			                selected
																			            </c:if>
													                              >${vardata }
													                              </option>
													        					   </c:forEach>   
												 	          				  </select>
                                                                          
                                                                          </div>
                                                                
    
                                                            </div>
                                   
                                                            </div>
                                                            
                                                                <br>    <br><br> <br>
                                                            
                                                                   <br> <br> <br>        <br> <br>
                                                             <br> <br> <br>
                      
                                                      </div>        
                                                             
                                                               
                                                      

      			
 															
                                                          
                                                                
                                            
                                                     
                                                   
                                     
                  							       
                  							       
                                                          
                                                            </div>
                                                            </c:if>
                                                </c:forEach>
      
                             
                             
                             
                                   
                    
                                           
                                           
                                            </div>
                                            
                                            
                 <script>


    $(document).ready(function () {
        $(".select2s").select2({
            tags: true
        }).on("change", function () {
            let selectedValues = $(this).val();
            let customId = $(this).data("custom"); // ดึงค่า data-custom
            
            
            alert(customId);
            
            // ค้นหา hidden input ที่มี data-custom ตรงกัน
            $('input[name="filter_enum"][data-custom="' + customId + '"]')
                .val(selectedValues ? selectedValues.join("|") : "");
            $('input[name="actionfilter_enum"][data-custom="' + customId + '"]')
            .val(selectedValues ? selectedValues.join("|") : "");
        });
        
        
        // ค้นหา hidden input ที่มี data-custom ตรงกัน
 

    });
</script>                                  
                                            
        <script>                                      
  
      $(document).ready(function () {
  	    var selectedOption = document.querySelector('select[name="activate_hierarchical_reference"]');
  	    if (selectedOption && selectedOption.value !== '-') {
  	    	toggleDivHierarchical(selectedOption); // Call the function with the selected element
  	    }
  	});
   
                                      
       function toggleDivHierarchical(radio) {
    	   

     	   $('.reference_input').removeAttr('name');
    	   $('#hierarchical_reference').attr('name','type');
    	   
    	   
    	
        // Hide all divs and disable inputs inside them
        var allDivs = document.querySelectorAll('.mainreference-div');
        allDivs.forEach(function(div) {
            div.style.display = 'none';
            var inputs = div.querySelectorAll('input, select');
            inputs.forEach(function(input) {
                input.disabled = true;  // Disable the input to prevent form submission
            });
        });
  	  // Show the selected div and enable inputs inside it
        var selectedDiv = document.getElementById("hierarchical-"+radio.value);
        if (selectedDiv) {
        	
        	
            selectedDiv.style.display = 'block';
            var selectedInputs = selectedDiv.querySelectorAll('input, select');
            selectedInputs.forEach(function(input) {
                input.disabled = false;  // Enable inputs so they can be submitted
            });
        }
    	
      
    }                                         
       
       </script>                                      