                              <c:forEach var="rowcommit" items="${clears}">     
                                 
                                    <c:if test="${rowcommit.actionkeys.size() > 0 }">
                                   <div id="${rowcommit.name}" class="action-div2" style="display:none">
                                   					 <div class="mb-1 row">
                                                         <div class="col-sm-4">
                                              
                                                       
                                                       
                                                       <spring:message code="app.maincolumn"  text="-​" />
                                                        </div>
                                                           <div class="col-sm-4"><spring:message code="app.e-formcolumn"  text="-​" />  </div>
                                                             <div class="col-sm-4"><spring:message code="app.filter"  text="-​" /></div>
                                                            </div>
                                   
                                                               <div class="col-12">
                                               
                                                       <c:forEach items="${rowcommit.actionkeys }" var="row" varStatus="counts">      
		                                           
		                                                                   <div class="mb-1 row">
		                                                                 <div class="col-sm-4">
                                                        <label class="col-form-label" for="fname-icon"><spring:message code="${row.title }"  text="-​" /> 
                                                        
                                                    
                                                        <c:if test="${row.required == 1}">***</c:if> </label>
                                                    </div>    
		                                                               <div class="col-sm-4">  
		                                                               
		                                                                     
		                                                                <input type="hidden" name="actionmainkey" value="${row.mainkey }"> 
		                                                                <input type="hidden" class="form-select" name="actionenum_id"  value="${row.enum_id }" readonly>    
		                                                                   
		                                                                      <select class="form-select" name="actioneformkey">
											                                   <option value="0">-</option>
											                            
											                              <c:forEach items="${eformfields }" var="fields" >    
											                             
											                                
										 <option value="${fields.field_id}" <c:if test="${row.keymap.eformkey == fields.field_id }">selected</c:if> >${fields.field_label}</option>
											                               </c:forEach>
											                                   
										 	                               </select>
										 	                           
		                                                               </div>            
		                                                                <div class="col-sm-4">         
		                                                       <c:if test="${row.type == 'Enum' }">
	      							
				                                               <select class="form-select select2s" data-custom="action${counts.count }"  multiple="multiple">
													                                   <option value="0">-</option>
													                                   
													                                   
													           <c:forEach items="${row.tag }" var="tag" varStatus="count">      
													                                   <option value="${tag.dataset_data_title}"
													                                     <c:if test="${row.keymap.filter_enum.contains(tag.dataset_data_title)}">
																			                selected
																			            </c:if>>
													                                   ${tag.dataset_data_title}
													                                   </option>
													           </c:forEach>
													                                   
												 	            </select>
												 	              <c:set var="modifiedValue" value="${row.keymap.filter_enum.replace(',', '|')}" />

												 	                <input type="hidden" name="actionfilter_enum" class="hiddenInput" value="${modifiedValue}"  data-custom="action${counts.count }">      
				                                                    <input type="hidden" class="form-select" name="actionchange_format" value="Enum" readonly>   
				                                               </c:if> 
				                                               
				                                                          <c:if test="${row.type != 'Enum' }">  
				                                                          <input type="text" class="form-select" name="actionfilter_enum" value="${row.source}"  readonly style="background-color:#eee">  
				                                                          <input type="hidden" class="form-select" name="actionchange_format" value="${row.type}"   readonly>   
				                                                                     </c:if> 
				                                                               
				                                                                     
				                                                               </div> 
		                                                     
		                                                                 </div>  
		                                                            
		                                                                   
		                                                                   
		                                                                
		                                                                
                                                       </c:forEach>   
                                                             
         
                                          
                                          
                                                                	 <div class="mb-1 row">
                                              <hr>          	 
                                                        	
                                                            <br><br> 
                                    <small class="text-muted"><spring:message code="app.customclearinginfo"  text="-​" /> .</small>
                                   <br><br>             	 
                                                         <div class="col-sm-4">
                                              
                                                       
                                                       
                                                       <spring:message code="app.customclearing"  text="-​" />
                                                        </div>
                                                        
                                                                    
                                                                      
                                                                          <div class="col-sm-8">  
                                                             
                                                                           <select class="form-select select2"  name="action_custom_clear"   multiple="multiple">
													                           
													                             <c:forEach items="${eformfields }" var="fields" varStatus="counts">  
													                        
													                         <c:set var="test" value="${fields.field_id}" />
													                              <option value="${fields.field_id }"
													                              <c:if test="${sub_processes.action_custom_clear.contains(test.toString())}">
																			                selected
																			            </c:if>
													                              >${fields.field_label}
													                              </option>
													        					   </c:forEach>   
												 	          				  </select>
                                                                          
                                                                          </div>
                                                                    
    
                                                            </div>                  
                                                        	 <div class="mb-1 row">
                                              <hr>          	 
                                                        	
                                                            <br><br> 
                                    <small class="text-muted"><spring:message code="app.batchclearinfo"  text="-​" /> .</small>
                                   <br><br>             	 
                                                         <div class="col-sm-4">
                                              
                                                       
                                                       
                                                       <spring:message code="app.batchclear"  text="-​" />
                                                        </div>
                                                        
                                                                    
                                                                      
                                                                          <div class="col-sm-8">  
                                                             
                                                                           <select class="form-select select2"  name="action_batch_clear"   multiple="multiple">
													                           
													                             <c:forEach items="${rowcommit.actionkeys }" var="rowed" varStatus="counts">  
													                             <spring:message code="${rowed.title }"  text="-​" var="vardata" />
													                              <option value="${rowed.mainkey }"
													                              <c:if test="${sub_processes.action_batch_clear.contains(rowed.mainkey)}">
																			                selected
																			            </c:if>
													                              >${vardata }
													                              </option>
													        					   </c:forEach>   
												 	          				  </select>
                                                                          
                                                                          </div>
                                                                
    
                                                            </div>
                                   
                                                    
                                                             
                                                               
                                                      
 															
                                                          
                                                                
                                            
                                                     
                                                   
                                     
                  							       
                  							       
                                                          
                                                            </div>
                                                            </c:if>
                                                </c:forEach>
                                                
 <script type="text/javascript">
 
 
 
 
 $(document).ready(function () {
		     var checkedRadio = document.querySelector('input[name="activate_clear"]:checked');
		     if (checkedRadio) {
		         toggleDivVisibility2(checkedRadio);  // Call the function with the checked radio button
		     }
 });
 
 
    function toggleDivVisibility2(radio) {
    	
    
    
    	
    	
        // Hide all divs and disable inputs inside them
        var allDivs = document.querySelectorAll('.action-div2');
        allDivs.forEach(function(div) {
            div.style.display = 'none';
            var inputs = div.querySelectorAll('input, select');
            inputs.forEach(function(input) {
                input.disabled = true;  // Disable the input to prevent form submission
            });
        });
  	  // Show the selected div and enable inputs inside it
        var selectedDiv = document.getElementById(radio.value);
        if (selectedDiv) {
        	
        	
            selectedDiv.style.display = 'block';
            var selectedInputs = selectedDiv.querySelectorAll('input, select');
            selectedInputs.forEach(function(input) {
                input.disabled = false;  // Enable inputs so they can be submitted
            });
        }
    	
      
    }
</script>
                                           
                                           
                                           
                                            </div>
                                        
                                            </div>
                                            
                                            
               
                                            
                                            
                                            
                                        </div>
                                    </div>
                                         </div>  
                                        
                                        
                                        
                                        
                                   
                                        
                              
                                    
                                       
<script>


    $(document).ready(function () {
        $(".select2s").select2({
            tags: true
        }).on("change", function () {
            let selectedValues = $(this).val();
            let customId = $(this).data("custom"); // ดึงค่า data-custom
            
            
            // ค้นหา hidden input ที่มี data-custom ตรงกัน
            $('input[name="filter_enum"][data-custom="' + customId + '"]')
                .val(selectedValues ? selectedValues.join("|") : "");
            $('input[name="actionfilter_enum"][data-custom="' + customId + '"]')
            .val(selectedValues ? selectedValues.join("|") : "");
        });
        
        
        // ค้นหา hidden input ที่มี data-custom ตรงกัน
 

    });
</script>                             
	      <script src="<c:url value="/resources/app-assets/vendors/js/forms/select/select2.full.min.js" />"></script>
