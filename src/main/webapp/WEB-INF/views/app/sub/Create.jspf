					          <spring:message code="app.activate" text="-" /> :
					
					<c:set var="namesArray" value="${fn:split(commitment, ',')}" />
					
					<select class="form-select form-select-sm d-inline w-auto" name="activate_action" onchange="toggleDivVisibility(this)">
					    <option value="-" <c:if test="${sub_processes.action == '-' }">selected</c:if>>Disable</option>
					    
					    <c:forEach var="commit" items="${namesArray}">
					        <option value="${commit}" <c:if test="${sub_processes.action == commit }">selected</c:if>>${commit}</option>
					    </c:forEach>
					</select>
					
					
		
					

                        <br>
<br>
                                
                              <c:forEach var="rowcommit" items="${commitments}">     
                                 
                                 
                                 
                                 
                                    <c:if test="${rowcommit.actionkeys.size() > 0 }">
                                   <div id="${rowcommit.name}" class="action-div mainaction-div" style="display:none">
                                   		


	
                                                               <div >
                                           		
<c:set var="shownGroups" value="" />

<c:forEach var="row" items="${rowcommit.actionkeys}">
    <c:set var="group" value="${row.keygroups}" />

    <c:if test="${not fn:contains(shownGroups, group)}">
        <details>
            <summary><spring:message code="${group}"  text="-​" /> </summary>

<br>
	 <div class="mb-1 row">
                                                         <div class="col-sm-4">
                                              
                                                  
                                                       
                                                       
                                                       <spring:message code="app.maincolumn"  text="-​" />
                                                        </div>
                                                           <div class="col-sm-4"><spring:message code="app.e-formcolumn"  text="-​" />  </div>
                                                             <div class="col-sm-4"><spring:message code="app.filter"  text="-​" /></div>
                                                            </div>
                                   

            <c:forEach var="innerRow" items="${rowcommit.actionkeys}">
            <c:set var="registerkey_id" value=" ${innerRow.id}" />
                <c:if test="${innerRow.keygroups == group}">
                    <div class="mb-1 row">
                        <div class="col-sm-4">
                            <label class="col-form-label" title="${innerRow.title}">
                                <spring:message code="${innerRow.title}" text="-" />
                                <c:if test="${innerRow.required == 1}">***</c:if>
                            </label>
                        </div>

                        <div class="col-sm-4">
                            <input type="hidden" name="actionmainkey" value="${innerRow.mainkey}">
                            <input type="hidden" name="actionenum_id" class="form-select" value="${innerRow.enum_id}" readonly>

                            <select class="form-select action-${rowcommit.name}" name="actioneformkey">
                                <option value="0">-</option>
                                <c:forEach var="fields" items="${eformfields}">
                                    <option value="${fields.field_id}" <c:if test="${innerRow.keymap.eformkey.contains(fields.field_id.toString())}">selected</c:if>>
                                        ${fields.field_label}
                                    </option>
                                </c:forEach>
                            </select>
                        </div>

                        <div class="col-sm-4">
                            <c:if test="${innerRow.type == 'Enum'}">
                                <select class="form-select select2s" data-custom="action${counts.count}" multiple="multiple">
                                    <option value="-" <c:if test="${innerRow.keymap.filter_enum == '-'}">selected</c:if>>ALL</option>
                                    <c:forEach var="tag" items="${innerRow.tag}">
                                       <c:if test="${not empty tag.dataset_data_title}">
                                        <option value="${tag.dataset_data_title}" <c:if test="${not empty innerRow.keymap.filter_enum and innerRow.keymap.filter_enum.contains(tag.dataset_data_title)}">selected</c:if>>
                                            ${tag.dataset_data_title}
                                        </option>
                                        </c:if>
                                    </c:forEach>
                                </select>

                                <c:set var="modifiedValue" value="${innerRow.keymap.filter_enum != null ? innerRow.keymap.filter_enum.replace(',', '|') : '-'}" />
                                <input type="hidden" name="actionfilter_enum" class="hiddenInput" value="${modifiedValue}" data-custom="action${counts.count}">
                                <input type="hidden" class="form-select" name="actionchange_format" value="Enum" readonly>
                                  <input type="hidden" name="type" value="create">
                                        <input type="hidden" name="registerkey_id" value="${registerkey_id }">
                            </c:if>

                            <c:if test="${innerRow.type != 'Enum'}">
                                <input type="text" class="form-select" name="actionfilter_enum" value="${innerRow.source}" readonly style="background-color:#eee">
                                <input type="hidden" class="form-select" name="actionchange_format" value="${innerRow.type}" readonly>
                                  <input type="hidden" name="type" value="create">
                                        <input type="hidden" name="registerkey_id" value="${registerkey_id }">
                            </c:if>
                        </div>
                    </div>
                </c:if>
            </c:forEach>
        </details>

        <!-- เพิ่มชื่อกลุ่มนี้ไว้ใน shownGroups เพื่อไม่แสดงซ้ำ -->
        <c:set var="shownGroups" value="${shownGroups},${group}" />
    </c:if>
</c:forEach>    

<script>
const allSelects2 = document.querySelectorAll('select[name="actioneformkey"]');

function updateOptions2() {
    const selectedValues = new Set();

    // เก็บค่าที่ถูกเลือกจาก select ที่ไม่ถูก disable
    allSelects2.forEach(select => {
        if (!select.disabled) {
            const val = select.value;
            if (val !== "0") {
                selectedValues.add(val);
            }
        }
    });

    // ซ่อน options ซ้ำจากทุก select (แม้จะ disabled)
    allSelects2.forEach(select => {
        const currentVal = select.value;

        [...select.options].forEach(option => {
            if (option.value === "0" || option.value === currentVal) {
                option.hidden = false;
            } else {
                option.hidden = selectedValues.has(option.value);
            }
        });
    });
}

allSelects2.forEach(select => {
    select.addEventListener("change", updateOptions2);
});

// เรียกตอนโหลดหน้า
updateOptions2();
</script>
                     		
                                                                                     
