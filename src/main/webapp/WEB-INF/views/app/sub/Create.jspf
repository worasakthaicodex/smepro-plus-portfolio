                                                    	<c:set var="actionBatchArray" value="${fn:split(processes.visibility, ',')}" />
							 <c:forEach items="${eformfields }" var="fields" >    
							 
							 	<c:set var="isSelected" value="false" />
																				<c:forEach var="item" items="${actionBatchArray}">
																				    <c:if test="${item eq fields.field_id.toString()}">
																				        <c:set var="isSelected" value="true" />
																				    </c:if>
																				</c:forEach>
																																                             
													                             
					 <option value="${fields.field_id}" ${isSelected ? 'selected' : ''}>${fields.field_label} </option>

								 </c:forEach>
											                                   
