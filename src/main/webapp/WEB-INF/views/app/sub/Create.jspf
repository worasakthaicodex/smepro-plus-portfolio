                                                                                       	 <option value="0" <c:if test="${sub_processes.batch_code_generation == '0'}">selected</c:if>>-</option>
                                                                                       
                                                                                       
                                                                                  <option value="1" 
                                                                                    <c:if test="${sub_processes.batch_code_generation == '1'}">selected</c:if>>[Prefix][RunningNumber]</option>
																				 <option value="2" <c:if test="${sub_processes.batch_code_generation == '2'}">selected</c:if>>[Prefix][YYMMDD][RunningNumber]</option>
													                              <option value="3" <c:if test="${sub_processes.batch_code_generation == '3'}">selected</c:if>>[YYMMDD][RunningNumber]</option>
													        		              <option value="4" <c:if test="${sub_processes.batch_code_generation == '4'}">selected</c:if>>[Prefix][ProductCode][YYMMDD][RunningNumber]</option>
													        		                <option value="5" <c:if test="${sub_processes.batch_code_generation == '5'}">selected</c:if>>[ProductCode][YYMMDD][RunningNumber]</option>
													        		                      <option value="6" <c:if test="${sub_processes.batch_code_generation == '6'}">selected</c:if>>[ProductCode][RunningNumber]</option>
												 	          				  </select>
    
                                                              
                               
                                         
                                                                          </div>
                                                                </c:if>
    
