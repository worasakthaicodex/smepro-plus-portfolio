 <script type="text/javascript">
 
  
 
 
 $(document).ready(function () {
		
		     var selectedOption = document.querySelector('select[name="activate_register"]');
		     if (selectedOption  &&  selectedOption.value != '-') {
		    	 
		    	 toggleDivregister(selectedOption);  // Call the function with the checked radio button
				          
		     }
		     
		     
		     
 });
 
 
    function toggleDivregister(radio) {
    	
    	
    	
        // Hide all divs and disable inputs inside them
        var allDivs = document.querySelectorAll('.mainaction-div');
        allDivs.forEach(function(div) {
            div.style.display = 'none';
            var inputs = div.querySelectorAll('input, select');
            inputs.forEach(function(input) {
                input.disabled = true;  // Disable the input to prevent form submission
            });
        });
  	  // Show the selected div and enable inputs inside it
        var selectedDiv = document.getElementById(radio.value);
        if (selectedDiv) {
        	
        	
            selectedDiv.style.display = 'block';
            var selectedInputs = selectedDiv.querySelectorAll('input, select');
            selectedInputs.forEach(function(input) {
                input.disabled = false;  // Enable inputs so they can be submitted
            });
        }
    	
      
    }
</script>        
         
                                                
 <script type="text/javascript">
 
 
 $(document).ready(function () {
	    var selectedOption = document.querySelector('select[name="activate_action"]');
	    if (selectedOption && selectedOption.value !== '-') {
	        toggleDivVisibility(selectedOption); // Call the function with the selected element
	    }
	});
 
 
    function toggleDivVisibility(radio) {
    	
    
   
    	
    	
        // Hide all divs and disable inputs inside them
        var allDivs = document.querySelectorAll('.mainaction-div');
        allDivs.forEach(function(div) {
            div.style.display = 'none';
            var inputs = div.querySelectorAll('input, select');
            inputs.forEach(function(input) {
                input.disabled = true;  // Disable the input to prevent form submission
            });
        });
  	  // Show the selected div and enable inputs inside it
        var selectedDiv = document.getElementById(radio.value);

        if (selectedDiv) {
        	
        	
            selectedDiv.style.display = 'block';
            var selectedInputs = selectedDiv.querySelectorAll('input, select');
            selectedInputs.forEach(function(input) {
                input.disabled = false;  // Enable inputs so they can be submitted
            });
        }
    	
      
    }
</script>
                                            </div>
                                        
                                            </div>
                                        </div>
                                    </div>
                                         </div>  
                                        
                                        
