<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

   
                                            <div class="modal-body">
                                                               
                <spring:message code="app.activate"  text="-​" /> : 
           		<c:set var="namesArray" value="${fn:split(Clear_register, ',')}" />
                 			<c:forEach var="commit" items="${namesArray}">
                               <div class="form-check form-check-inline">
                                          <input class="form-check-input" type="radio" name="activate_reference_modify"  value="${commit}"  onclick="toggleDivVisibilityactivate_reference_modify(this)"
                                             <c:if test="${sub_processes.activate_reference_modify == commit }">checked</c:if> >
                                              ${commit}</label>
                                        </div>     
                            </c:forEach>

                        <br><br> 
                                    <small class="text-muted"><spring:message code="app.Clear_registerinfo"  text="-​" /> .</small>
                                   <br><br>             
                              <input type="text" class="form-select reference_modify"  name="type" value="clear_register"  >   
                                   
                              <c:forEach var="rowcommit" items="${Clear_registers}">     
                                
                   
                 
                                    
                                    <c:if test="${rowcommit.actionkeys.size() > 0 }">
                                   <div id="modify-${rowcommit.name}" class="reference-div" style="display:none">
                                   					 <div class="mb-1 row">
                                                         <div class="col-sm-4">
                                              
                                                       
                                                       
                                                       <spring:message code="app.maincolumn"  text="-​" />
                                                        </div>
                                                           <div class="col-sm-4"><spring:message code="app.e-formcolumn"  text="-​" />  </div>
                                                             <div class="col-sm-4"><spring:message code="app.filter"  text="-​" /></div>
                                                            </div>
                                   
                                                               <div class="col-12">
                                               
                                                       <c:forEach items="${rowcommit.actionkeys }" var="row" varStatus="counts">      
		                                           
		                                    
		                                                                   <div class="mb-1 row">
		                                                                 <div class="col-sm-4">
                                                        <label class="col-form-label" for="fname-icon"><spring:message code="${row.title }"  text="-​" /> 
                                                        
                                                    
                                                        <c:if test="${row.required == 1}">***</c:if> </label>
                                                    </div>    
		                                                               <div class="col-sm-4">  
		                                                               
		                                                                     
		                                                                <input type="hidden" name="referencemainkey" value="${row.mainkey }"> 
		                                                                <input type="hidden" class="form-select" name="referenceenum_id"  value="${row.enum_id }" readonly>    
		                                                                   
		                                                                      <select class="form-select" name="referenceeformkey">
											                                   <option value="0">-</option>
											                            
											                              <c:forEach items="${eformfields }" var="fields" >    
											                             
											                                
										 <option value="${fields.field_id}" <c:if test="${row.keymap.eformkey == fields.field_id }">selected</c:if> >${fields.field_label}</option>
											                               </c:forEach>
											                                   
										 	                               </select>
										 	                           
		                                                               </div>            
		                                                                <div class="col-sm-4">         
		                                                       <c:if test="${row.type == 'Enum' }">
	      							
				                                               <select class="form-select select2s" data-custom="reference${counts.count }"  multiple="multiple" required>
													                                   <option value="0">-</option>
													                                   
													                                   
													           <c:forEach items="${row.tag }" var="tag" varStatus="count">      
													                                   <option value="${tag.dataset_data_title}"
													                                     <c:if test="${row.keymap.filter_enum.contains(tag.dataset_data_title)}">
																			                selected
																			            </c:if>>
													                                   ${tag.dataset_data_title}
													                                   </option>
													           </c:forEach>
													                                   
												 	            </select>
												 	              <c:set var="modifiedValue" value="${row.keymap.filter_enum.replace(',', '|')}" />

												 	                <input type="hidden" name="referencefilter_enum" class="hiddenInput" value="${modifiedValue}"  data-custom="reference${counts.count }">      
				                                                    <input type="hidden" class="form-select" name="referencechange_format" value="Enum" readonly>   
				                                               </c:if> 
				                                               
				                                                          <c:if test="${row.type != 'Enum' }">  
				                                                          <input type="text" class="form-select" name="referencefilter_enum" value="${row.source}"  readonly style="background-color:#eee">  
				                                                          <input type="hidden" class="form-select" name="referencechange_format" value="${row.type}"   readonly>   
				                                                        
				                                                                     </c:if> 
				                                                               
				                                                                     
				                                                               </div> 
		                                                     
		                                                                 </div>  
		                                                            
		                                                                   
		                                                                   
		                                                                
		                                                                
                                                       </c:forEach>   
                                                             
         
                          
 
                  							       
                  							       
                                                             </div>
                                                            </div>
                                                            </c:if>
                                                </c:forEach>
                                                
                                
                                                          	
                                   
                                           
                                            </div>
                                            
      <script>


    $(document).ready(function () {
        $(".select2s").select2({
            tags: true
        }).on("change", function () {
            let selectedValues = $(this).val();
            let customId = $(this).data("custom"); // ดึงค่า data-custom
            
            
            // ค้นหา hidden input ที่มี data-custom ตรงกัน
            $('input[name="filter_enum"][data-custom="' + customId + '"]')
                .val(selectedValues ? selectedValues.join("|") : "");
            $('input[name="actionfilter_enum"][data-custom="' + customId + '"]')
            .val(selectedValues ? selectedValues.join("|") : "");
        });
        
        
        // ค้นหา hidden input ที่มี data-custom ตรงกัน
 

    });
</script>                                        
      <script>                                      
      $(document).ready(function () {
		     var checkedRadio = document.querySelector('input[name="activate_reference_modify"]:checked');
		     if (checkedRadio) {
		    	 toggleDivVisibilityactivate_reference_modify(checkedRadio);  // Call the function with the checked radio button
		     }
});

                                      
       function toggleDivVisibilityactivate_reference_modify(radio) {
    	
    	    $(".reference_continue").val("");
    	    $(".action-div").html("");
    	
    	
        // Hide all divs and disable inputs inside them
        var allDivs = document.querySelectorAll('.reference-div');
        allDivs.forEach(function(div) {
            div.style.display = 'none';
            var inputs = div.querySelectorAll('input, select');
            inputs.forEach(function(input) {
                input.disabled = true;  // Disable the input to prevent form submission
            });
        });
  	  // Show the selected div and enable inputs inside it
        var selectedDiv = document.getElementById("modify-"+radio.value);
        if (selectedDiv) {
        	
        	
            selectedDiv.style.display = 'block';
            var selectedInputs = selectedDiv.querySelectorAll('input, select');
            selectedInputs.forEach(function(input) {
                input.disabled = false;  // Enable inputs so they can be submitted
            });
        }
    	
      
    }                                         
       
       </script>                                      