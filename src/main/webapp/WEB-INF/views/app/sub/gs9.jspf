                                Action
                                </button>
                                <div class="dropdown-menu" style="">
                                    <a class="dropdown-item" onclick="setId('${rows.id}','${row.id}');calldata('/stepset-workflow/${rows.id}','${workflows.workflow_id}','Receivediv')"
                                                      data-bs-toggle="modal" data-bs-target="#Receive" style="float:right" title="Receive"> <spring:message code="app.completionactions"  text="-​" /></a>
                               
                           
                                     </div>
