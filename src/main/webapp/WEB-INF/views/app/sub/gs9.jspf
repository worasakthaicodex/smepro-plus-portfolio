<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
 




    <style>
	       .wizard-container{
  width:100%;
  margin: 0 auto;
}


.wizard-container-ul{
  list-style: none

}

.wizard-container-li{
  display: inline-block;
  padding: 20px;
  width:auto;
  position: relative;
  width: 150px;
  vertical-align: top;

}

.step-div{
  
 text-align: center;
 

}

.step-bg{
  color: #fff;
  margin-top:4px;
  display: inline-block;
  
  border: 1px solid #666666;
  border-radius: 50%;
  width:32px;
  height: 32px;
  display: inline-block;
  text-align: center;
  padding-top: 2px;
}

.step-div:before
{
  display: block;
  position: absolute;
  top: 39px;
  width: 100%;
  height: 4px;
  content: '';
  background-color:#006F94;
  margin-left: -110px;

}

.wizard-container-li:first-child  .step-div:before{   
 
display:none;

}

.step-num{
   position: absolute;
   margin-left: -21px;
   margin-top: 9px;
   color:#fff;
   font-weight: bold;
   font-size: 14px;
 }


.step-title{
  font-size: 12px;
  color: #666;
  display: block;
 

}



/*marker***/
 .wizard-container-li.marker .step-bg{
   border-bottom-left-radius: 0;
   transform: rotate(-45deg);
   border:1px solid transparent;
   background-color: #006F94;
 }


/*positive outcome marker style*/
 .wizard-container-li.marker.positive .step-bg {
  background-color:#669933
}

 .wizard-container-li.marker.positive .step-num{
  background-color:#fff;
  border-radius:50%;
  width:22px;
  height:22px;
  margin-left: -27px;
  color:#669933;
  margin-top: 9px;
  vertical-align: middle;
  font-size: 15px;
}
 .wizard-container-li.marker.positive .step-title {
  color:#006633;
  font-weight: bold;
}

/*negative outcome marker style*/
 .wizard-container-li.marker.negative .step-bg {
  background-color:#EA4300
}

 .wizard-container-li.marker.negative .step-num{
  background-color:#fff;
  border-radius:50%;
  width:22px;
  height:22px;
  margin-left: -27px;
  color:#EA4300;
  margin-top: 9px;
  vertical-align: middle;
  font-size: 14px;
}

 .wizard-container-li.marker.negative .step-title {
  color:#CC0000;
  font-weight: bold;
}
/** active & disabled styles ***********************************/


/*completed***/

.wizard-container-li.completed .step-div:before,
.wizard-container-li.active .step-div:before,
.wizard-container-li.rejected .step-div:before{
  border:2px solid #666666;
  background-color:transparent;
}
.wizard-container-li.completed .step-num{
  margin-left: -24px;
  font-size: 16px;
  margin-top: 8px;
}

.wizard-container-li.completed .step-bg{
  background-color: #666666;
}



 

 /*active***/
.wizard-container-li.active .step-num{
  background-color:#fff;
  border-radius:50%;
  width:22px;
  height:22px;
  margin-left: -27px;
  color:#006F94;
  margin-top: 9px;
  vertical-align: middle;
  font-size: 14px;
}
.wizard-container-li.active .step-title{
  font-weight: bold;
  color:#006F94;
  vertical-align: top;
}

/*disabled***/



.wizard-container-li.disabled .step-div:before{
  background-color:#ccc;
}

.wizard-container-li.disabled .step-bg{
  background-color:#ccc;
  border:1px solid #ccc;
   

}

.wizard-container-li.disabled .step-num{
  color:#666;
   

}


/*onhold******/



.wizard-container-li.onhold .step-div:before,
.wizard-container-li.onhold-border .step-div:before {
  
   border:2px dashed #FF9900;
  background-color:transparent;

  /* margin-right: -250px; */
  
}
.wizard-container-li.onhold .step-bg{
  background-color:#FF9900;
  border:1px solid #FF9900;

}


.wizard-container-li.onhold .step-num{
  color:#fff;
  margin-left: -23px;
  font-size: 15px;

}
.wizard-container-li.onhold .step-title{
 
  color:#CC6633;
}
 


/**rejected **/
.wizard-container-li.rejected .step-bg{
  background-color:#CC0000;
  border:1px solid #CC0000;
} 

.onhold{
z-index:20;
} 
.active{
z-index:99;
} 
	       
	       </style>	
	       

