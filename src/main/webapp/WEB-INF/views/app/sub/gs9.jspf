   <script>                                       
  function addprocess(Id){
	  $("form#Createapp #processe_id").val(Id);
	  $("form#Reviewapp #processe_id").val(Id);
	  $("form#Approvalapp #processe_id").val(Id);
	  $("form#Clearapp #processe_id").val(Id);
	  $("form#Receiveapp #processe_id").val(Id);
  }
  function setId(Subid,Id){
	  $("form#Createapp #sub_processes_id").val(Subid);
	  $("form#Createapp #processe_id").val(Id);
	  
	  $("form#Reviewapp #sub_processes_id").val(Subid);
	  $("form#Reviewapp #processe_id").val(Id);
	  
	  $("form#Approvalapp #sub_processes_id").val(Subid);
	  $("form#Approvalapp #processe_id").val(Id);
	  
	  
	  $("form#Clearapp #sub_processes_id").val(Subid);
	  $("form#Clearapp #processe_id").val(Id);
	  
	  $("form#Receiveapp #sub_processes_id").val(Subid);
	  $("form#Receiveapp #processe_id").val(Id);
  }
  
  
  
  
  
  
  
  
  
  
  function calldata(url,ID,save){
	  $("#Cleardiv").html("");
	  $("#Receivediv").html("");
	  $("#Reviewdiv").html("");
	  $("#Approvaldiv").html("");
	  $("#Creatediv").html("");
	  
	
	  
	    let targetDiv = $("#" + save);
	    
	    // ทำให้เนื้อหาเก่าจางลง
	    targetDiv.css("opacity", "0.5").css("position", "relative");

	    // สร้าง Spinner อยู่ตรงกลางของ div
	    let loadingSpinner = `
	        <div class="spinner-overlay">
	            <div class="spinner-border text-primary" role="status">
	                <span class="visually-hidden">Loading...</span>
	            </div>
	        </div>`;

	        targetDiv.append(loadingSpinner);  
	  
      $.ajax({
      type:'GET',
      url:url,
      data: {id : ID},
      
   success: function(data){
 	 $("#"+save).html(data);	
 	 targetDiv.css("opacity", "1"); // คืนค่า opacity ปกติ
   }
});

return false;

}



	</script>	  
                                        
                                        
        