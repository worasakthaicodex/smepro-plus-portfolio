                                <button type="button" class="btn btn-sm btn-success dropdown-toggle waves-effect waves-float waves-light" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Action
                                </button>
                                <div class="dropdown-menu" style="">
                                    <a class="dropdown-item" onclick="setId('${rows.id}','${row.id}');calldata('/stepset-workflow/${rows.id}','${workflows.workflow_id}','Approvaldiv')"
                                                      data-bs-toggle="modal" data-bs-target="#Approval"  title="Approval">Setting</a>
                               
                           
