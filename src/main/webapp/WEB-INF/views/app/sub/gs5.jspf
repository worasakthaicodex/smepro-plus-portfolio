<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
 
 
 
 <style>
 .fixhead {
  position: sticky;
  top: 30px; /* ให้ต่ำกว่า toolbar */
  background-color: #F5F5F5;
  z-index: 2;
}
 </style>

	 <div style="position: relative;border:1px solid #eee;min-height:300px;max-height:700px;overflow:auto">
	 
	 	 <div id="toolbar" style="position: sticky; top: 0; z-index: 3; border-bottom:2px solid #ddd; background-color:#F5F5F5; padding:2px">
	 	  <c:if test="${  docs == null && reference == null ||  (docs.current_step == 'Create' && reference == null )   }"> 	       	 
		<button type="button"  title="Add Data" id="submits" class="btn btn-icon btn-sm btn-primary " style="font-size:8px;padding:4px" onclick="setini()"  
		data-bs-toggle="modal" data-bs-target="#addNewGR" >                     
		<i data-feather='edit-2'></i>
		</button>  
		
	
	
</c:if>

	 	  <c:if test="${reference != null && view_type != 1  }"> 	       	 
		<button type="button" title="Copy Selected"  class="btn btn-icon btn-sm btn-primary" style="font-size:8px;padding:4px"
		 onclick="submitform();">                     
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-corner-left-up"><polyline points="14 9 9 4 4 9"></polyline><path d="M20 20h-7a4 4 0 0 1-4-4V4"></path></svg>
		</button>  
		
		</c:if>
		
		<button type="button" title="Import Csv"  data-bs-toggle="modal" data-bs-target="#Import"   class="btn btn-icon btn-sm btn-primary" 
		style="font-size:8px;padding:4px;background-color:#fff"
				 onclick="submitform();">           
				 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-down-circle"><circle cx="12" cy="12" r="10"></circle><polyline points="8 12 12 16 16 12"></polyline><line x1="12" y1="8" x2="12" y2="16"></line></svg>
		          
		</button>  
		
		
		<c:catch var="exception">
		    <c:if test="${transaction['register_code'] != null}">
		    			 <c:set var="load" value="0" />
		    		    <c:if test="${edatas.loadall == 0}"><c:set var="load" value="1" /></c:if>

		 	<a href= "/loadalldocumentapp-filemanager/${edatas.data_id}/${process.id}/${edatas.loadall}" title="LoadAll"  class="btn btn-icon btn-sm btn-light" style="font-size:8px;padding:4px;background-color:#fff"
				 onclick="submitform();">                     
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-loader"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
			</a>  
		    </c:if>
		</c:catch>
		<c:if test="${not empty exception}">
		    <!-- Handle the case where register_code doesn't exist -->
		    <!-- Optionally, do nothing or show alternative content -->
		</c:if>
		

	
		<button type="button" title="Documentation"  class="btn btn-icon btn-sm btn-light" style="font-size:8px;padding:4px;background-color:#fff"
		 onclick="submitform();">                     
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-book"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>	</button>  




	 	 </div>
	 
	 	 
	    <table  class="table">
                                    <thead>
                                        <tr>
                                        
            	 <th class="form-label fixhead" style="padding:5px;font-size:13px">#</th>           
            	 
            	 
    
<c:forEach items="${eformfields }"   var="row" varStatus="count">
    



	   <c:if test="${row.keymap.type == 'create' && actionBatchList.contains(row.keymap.mainkey) 
	   || row.keymap.type == 'reference_modify' && actionBatchList.contains(row.keymap.mainkey) 
	     || row.keymap.type == 'reference_continue' && actionBatchList.contains(row.keymap.mainkey) 
	      }">  
 			 <th class="form-label fixhead" style="padding:5px;font-size:13px">${row.field_label }</th>
		</c:if>
       
                
</c:forEach>

  <c:if test="${reference == 'reference' || view_type == 1  && reference == 'reference'}"> 
               <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="tables.reference"  /></th>
      </c:if>
      
      
                                                <c:if test="${docs == null &&  view_type != 1 or ( docs.current_step == 'Create' &&  view_type != 1
                                                 || docs.current_step == 'cleared'  &&  view_type != 1)   }"> 

                                                           <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="tables.action" text="จัดการ" /></th>
                                                           </c:if>

                                        </tr>
                                    </thead>
                                    <tbody>
                         
                            
                                    
                                        <c:set var="Clear_status" value="0.00" />
                                             <c:set var="countmain" value="0" />
                                        <c:forEach items="${item }" var="row"  varStatus="count">
				                                          <c:set var="countmain" value="${countmain + 1}" />
				                                     
				                                      <tr id="item-${row.id }" class="RF-${row.doc } CHECK-${row.check }">
				                                       <td style="padding:5px;font-size:13px" title="${row.id } <-> ${row.id_refer } ">${count.count }</td >
			
				      										<c:forEach items="${eformfields }"   var="rows" varStatus="count">
							
															   <c:if test="${ 
															   rows.keymap.type == 'create' && actionBatchList.contains(rows.keymap.mainkey) 
															   || rows.keymap.type == 'reference_modify' && actionBatchList.contains(rows.keymap.mainkey)  
															    || rows.keymap.type == 'reference_continue' && actionBatchList.contains(rows.keymap.mainkey) 
															     }">  
														 			       		 <td style="padding:5px;font-size:13px">${row[rows.keymap.mainkey]}</td >
																</c:if>
															</c:forEach>
											                                        
				                                      
				                                      
				                                             <c:if test="${docs == null && reference == null  
				                                             || ( docs.current_step == 'Create' && reference == null  
				                                             || docs.current_step == 'cleared' && reference == null  )  }"> 
				                                               <td style="padding:5px;font-size:13px">
				                                    
				                                      <c:if test="${  docs.current_step == 'cleared'  }"> 
				                                        
				                                           <a herf=""   onclick="getdatas('/edititem-filemanager/${row.id }/${tempId}','savesuccess')"  
							                                      class="btn btn-sm btn-success" data-bs-toggle="modal"  data-bs-target="#addNewSR2"><spring:message code="btn.cleared"  /></a> 
				                                          </c:if>
				                                          
				                                          
				                                        <c:if test="${docs == null or ( docs.current_step == 'Create'  )  }"> 
							                                      <a herf=""   onclick="getdatas('/edititem-filemanager/${row.id}/${tempId}','savesuccess')"  
							                                      class="btn btn-sm btn-light" data-bs-toggle="modal"  data-bs-target="#addNewGR"><spring:message code="btn.edit"  /></a> 
							                                    
							                        
							                                     <a herf="" class="btn btn-sm btn-danger"
							                                      onclick="getdata('/delitem-filemanager/${row.id }/${tempId}','savesuccess')" 
							                                     ><spring:message code="btn.remove"  /></a> 
				                                     </c:if>
				                                   
				                                     
				                                     
				                                     
				                                      </td>
				                                             </c:if>
				                                             
				                                              <c:if test="${reference == 'reference' }">  
				                                                  <td><a href="/loadreference-filemanager/${row.doc }" target="_blank">${row.doc }</a></td> 
  																       </c:if>
  																     <c:if test="${row.doc == null && reference == 'reference' && view_type != 1}">  
  																     <td>
  											<div class="form-check form-check-success">
  											
  											  <c:if test="${reference_type == 'Production'}">
  											     <input type="radio" class="form-check-input check-input" id="colorCheck3"  name="check-input" value="${row.id }" onchange="updateValues()">
  											  </c:if> 
  											  <c:if test="${reference_type != 'Production'}">
  											     <input type="checkbox" class="form-check-input check-input" id="colorCheck3"  value="${row.id }" onchange="updateValues()">
  											  </c:if> 
  											
                                         
                                    						    </div>
                                    						    	 </td> 
                                      						  </c:if>
  															
  															
  															<c:if test="${row.doc != null && view_type != 1 }">  
  																     <td>
  						
                                    						    	 </td> 
                                      						  </c:if>
  															
				                                          
				                                        </tr>
                                        </c:forEach>

                                       <c:forEach items="${item2 }" var="row"  varStatus="counts">
				                                     
				                                     
				                                      <tr >
				                                       <td style="padding:5px;font-size:13px" >${counts.count +countmain }</td >
			
				      										<c:forEach items="${eformfields }"   var="rows" varStatus="count">
							
															   <c:if test="${ 
															   rows.keymap.type == 'create' && actionBatchList.contains(rows.keymap.mainkey) 
															   || rows.keymap.type == 'reference_modify' && actionBatchList.contains(rows.keymap.mainkey)  
															    || rows.keymap.type == 'reference_continue' && actionBatchList.contains(rows.keymap.mainkey) 
															     }">  
														 			       		 <td style="padding:5px;font-size:13px">${row[rows.keymap.mainkey]}</td >
																</c:if>
															</c:forEach>
											                                        
				                                      
				                                      
				                                               <td style="padding:5px;font-size:13px"></td>
				                                        
  															
  															<c:if test="${row.doc != null && view_type != 1 }">  
  																     <td>
  						
                                    						    	 </td> 
                                      						  </c:if>
  															
				                                          
				                                        </tr>
                                        </c:forEach>
                                    
                                    </tbody>
                                      
                                    
                                    
                                    </table>     
                                    <br>   <br>
                                    
	  <c:if test="${reference == 'reference'}"> 
	

	    <script>
	    
	    
	    
	    
let selectedArray = [];

function updateValues() {
    selectedArray = [];  // ล้างค่าเดิม
    document.querySelectorAll('.check-input:checked').forEach(checkbox => {
        selectedArray.push(checkbox.value);
    });
    
    // แปลงเป็น String แล้วใส่ลงใน Input Hidden
    document.getElementById('selectedValues').value = selectedArray.join(',');
    console.log("Selected:", document.getElementById('selectedValues').value);
}
</script> 

  <script>
  function submitform(){
	  
	  
	  if (confirm("<spring:message code="procurement.titem"  />")) {
	        var id = $("#selectedValues").val();
	        document.getElementById("tab3").innerHTML = ""; 
	        $("#formimplode").submit();
	    } 
	  
	  
}
</script> 

	 </c:if> 
	  
     	          
	       
	 </div>
	 	     	 <div id="footbar" style="position: sticky; bottom: 0; z-index: 3; border-top: 2px solid #ddd; background-color: #F5F5F5; padding: 2px;">
        <spring:message code="procurement.grandtotal"  />  <input type="text"  style="border:0px;border-bottom: 1px solid #aaa;background-color: #F5F5F5;"  name="procurement_grandtotal2"  value="${grandtotal}" readonly>
    </div>    
       
     
       
       