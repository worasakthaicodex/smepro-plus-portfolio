 <div class="modal fade" id="addNewCards4" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
 
                    <div class="modal-dialog   modal-lg modal-dialog-centered">
                         <div class="modal-content">
                                                        <div class="modal-header">
                                                              <h4 class="modal-title" id="myModalLabel33"> <spring:message code="item.Additem" /></h4>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                  
                                                         <form:form method="POST"  modelAttribute="SubData"  action="/additem-filemanager"  id="formvc" name ="formvc"> 
                                                     
                                                            <div class="modal-body">
                                                                <label> <spring:message code="item.description" text="รายละเอียดสินค้า/บริการ" />: </label>
                                                                <div class="mb-1">
                                                                    <input type="text" name="description"  id="description" class="form-control">
                                                                </div>

                                                                <label><spring:message code="item.amount_received" text="ยอดรับเงิน" />: </label>
                                                                <div class="mb-1">
