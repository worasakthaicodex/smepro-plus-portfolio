<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>
 


<style>
.col-sm-3{
font-size:12px;
}
</style>


 <c:if test="${ steptype.contains(row.keymap.type)  }">



 <c:choose>
 
 
  <c:when test='${row.keymap.mainkey == "lot_batch" && batch_gens != null    }'>
  
   	
	     
	     	         <div class="mb-1 row">
<div title="KET->${row.keymap.mainkey }">${title } * ${disabled }</div>
			          <div class="col-sm-12">  
			     	<c:set var="batch_gen" value="${transaction[row.keymap.mainkey]}" /> 
        <c:if test="${ transaction[row.keymap.mainkey] == null  }"><c:set var="batch_gen" value="${batch_gens}" /> </c:if>
	    <input type="text" class="form-control"  value="${batch_gen }" name="${row.keymap.mainkey}"  readonly>
			     </div> 
			         </div>  
	     
  </c:when> 
 


 
  <c:when test='${row.keymap.mainkey == "doc_code"    }'>
  
   	
	      <div class="mb-1 row">
<div   title="KET->${row.keymap.mainkey }">${title } *${disabled }</div>
	            <div class="col-sm-12">   
	             <input type="text" class="form-control newinput"  step="0.1" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
	     
	             </div>
	                 </div> 
	     
  </c:when> 
 
 	        <c:when test='${row.keymap.change_format == "Multiply" && action_batch == null  }'>
	        
	         <div class="mb-1 row">
<div c title="KET->${row.keymap.mainkey }">${title } * ${disabled }</div>
			          <div class="col-sm-12">  
			     <input type="text" class="form-control newinput" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
			     </div> 
			         </div>  
	         </c:when>
	          
	          
	         <c:when test='${row.keymap.change_format == "GRAND_AUTO_SUM" && action_batch == null    }'>
	          <div class="mb-1 row">
				<div  title="KET->${row.keymap.mainkey }">${title } * ${disabled }</div>
			           <div class="col-sm-12">  
			     <input type="text" class="form-control   newinput" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
			     </div>  
			         </div> 
	         </c:when> 
 
	        <c:when test='${row.keymap.change_format == "Multiply" && action_batch_clear == null  }'>
	        
	         <div class="mb-1 row">
<div  title="KET->${row.keymap.mainkey }">${title } * ${disabled }</div>
			          <div class="col-sm-12">  
			     <input type="text" class="form-control newinput" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
			     </div> 
			         </div>  
	         </c:when>
	          
	          
	         <c:when test='${row.keymap.change_format == "GRAND_AUTO_SUM" && action_batch_clear == null    }'>
	          <div class="mb-1 row">
<div >${title } *${disabled }</div>
			           <div class="col-sm-12">  
			     <input type="text" class="form-control newinput" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
			     </div>  
			         </div> 
	         </c:when> 
	         
	         
	                  <c:when test='${row.keymap.change_format == "SUM"  || row.keymap.change_format == "Minus"     }'>
	          <div class="mb-1 row">
<div >${title } *${disabled }</div>
			           <div class="col-sm-12">  
			     <input type="text" class="form-control newinput" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
			     </div>  
			         </div> 
	         </c:when> 

	            <c:when test='${row.keymap.change_format == "Link" }'>  
	             <div class="mb-1 row">
<div  title="KET->${row.keymap.mainkey }">${title } * ${disabled }</div>
	
	
	
	<div class="col-sm-12">
	            <div class="input-group">
                                 
           <input type="text" class="form-control" name="${row.keymap.mainkey}" id="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" readonly>
                                    
        <span class="input-group-text cursor-pointer">
        <a   href="/addsubdataset-condition/${row.keymap.filter_enum}/${row.keymap.id}/${row.keymap.processes_id}" target="_blank" >  <i data-feather="server"></i></a>
            </span> 
                                    </div>
	
	     </div>
	
	
	

	    </div> 
		
		
	    </c:when>
	       
	     <c:when test='${row.keymap.change_format == "Enum" }'>
	       
	        
	         <div class="mb-1 row">
    <div  title="KET->${row.keymap.mainkey }">
        ${title } * ${disabled}
    </div>
<div class="col-sm-12">


                                        <div class="input-group">
                       
                                                       
                                      <select class="form-control ${readonly}select2" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  ${readonly} 
                                        <c:if test="${readonly != ''}">disabled</c:if>>
                <c:forEach items="${row.dataset_data}" var="datasets" varStatus="count">
                    <option value="${datasets.dataset_data_title}"
                        <c:if test="${transaction[row.keymap.mainkey] == datasets.dataset_data_title}">selected</c:if>>
                        ${datasets.dataset_data_title} ${datasets.dataset_data_subtitle1}
                    </option>
                </c:forEach>
            </select>
                                    
        <span class="input-group-text cursor-pointer">
            <a  href="/addsubdataset-condition/${row.keymap.enum_id}" target="_blank">
                <i data-feather="database"></i>
            </a>  
            </span> 
                                    </div>
</div>
</div>  
	        

	    </c:when>
	    
	
	    
	    
	        <c:when test='${row.keymap.change_format == "DB" }'>

	        
	         <div class="mb-1 row">
    <div  title="KET->${row.keymap.mainkey }">
        ${title } * ${disabled}
    </div>
<div class="col-sm-12">

 


                                        <div class="input-group">
                                 
                                 <c:if test="${ row.keymap.filter_enum == 'user'}">
                     
                                 	<%@ include file="inputdb_user.jspf" %>       
                                 </c:if>       
                                <c:if test="${ row.keymap.filter_enum == 'department'}">
                                 	<%@ include file="inputdb_department.jspf" %>       
                                 </c:if>       
                                 
                             
   
                                    </div>
</div>
</div>  
	        

	    </c:when>
	    
	    
	       
	       	     <c:when test='${row.keymap.change_format == "TEXT" }'>
	       	      <div class="mb-1 row" title="KET->${row.keymap.mainkey }">
<div >${title } *${disabled }</div>
	            <div class="col-sm-12">   
	            <textarea class="form-control newinput" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}" ${readonly }>${transaction[row.keymap.mainkey]}</textarea>
	     
	             </div>
	                 </div> 
	       </c:when>
	       
	          	     <c:when test='${row.keymap.change_format == "DATE" }'>
	          	      <div class="mb-1 row">
<div   title="KET->${row.keymap.mainkey }">${title } *${disabled }</div>
	            <div class="col-sm-12">   

	             <input type="date" class="form-control newinput" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" ${readonly }>
	     
	             </div>
	                 </div> 
	       </c:when>
	       <c:when test='${row.keymap.change_format == "DATETIME"}'>
  <div class="mb-1 row">
    <div  title="KET->${row.keymap.mainkey}">
      ${title } *${disabled}
    </div>
    <div class="col-sm-12">
      <input type="datetime-local"
             class="form-control newinput"
             id="${row.keymap.mainkey}"
             name="${row.keymap.mainkey}"
             value="${fn:replace(fn:replace(transaction[row.keymap.mainkey], ' ', 'T'), '.000', '')}"
             ${readonly}>
    </div>
  </div>
</c:when>
	       
	       
	          	     <c:when test='${row.keymap.change_format == "NUMBER" }'>
	          	      <div class="mb-1 row" title="KET->${row.keymap.mainkey }">
<div   title="KET->${row.keymap.mainkey }">${title } *${disabled }</div>
	            <div class="col-sm-12">  
	             <input type="number" class="form-control newinput"  step="0.1" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey] + 0}" ${readonly }>
	     
	             </div>
	                 </div> 
	       </c:when>
	       
	    
	       
	       
	    <c:when test='${row.keymap.change_format == "Rating"}'>
	     <div class="mb-1 row" title="KET->${row.keymap.mainkey }">
<div   title="KET->${row.keymap.mainkey }">${title } *${disabled }</div>
	    <div class="col-sm-12">   
                          				     <div class="input-group">
                                                <input type="number" class="touchspin-min-max newinput" value="${transaction[row.keymap.mainkey] +0}" name="${row.keymap.mainkey}" ${readonly }/>
                                            </div>
	             </div>
	                 </div> 
	    </c:when>




	    <c:when test='${row.keymap.change_format == "VIEW"}'>
	     <div class="mb-1 row" title="KET->${row.keymap.mainkey }">
<div   title="KET->${row.keymap.mainkey }">${title } *${disabled }</div>
	    <div class="col-sm-12">   
                          				     <div class="input-group">
                                                <input type="text" class="form-control" value="${transaction[row.keymap.mainkey]}" id="${row.keymap.mainkey}"  readonly/>
                                            </div>
	             </div>
	                 </div> 
	    </c:when>




    
	     <c:when test='${row.keymap.change_format == "TAG" }'>
	        
	        
	         <div class="mb-1 row">
    <div  title="KET->${row.keymap.mainkey }">
        ${title } * ${disabled}
    </div>
<div class="col-sm-12">

         <div class="input-group">
                                                  <div class="input-group">
                                 
                                                       
                                      <select class="form-select select${readonly}2" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  ${readonly}  multiple="multiple"
                                        <c:if test="${readonly != ''}">disabled</c:if>>
                                        
 <c:if test="${transaction[row.keymap.mainkey] != null  && transaction[row.keymap.mainkey] != '' }">  
 <c:set var="namesArray" value="${fn:split(transaction[row.keymap.mainkey], ',')}" />
 <c:forEach var="referencedocs"  items="${namesArray}"> 
                    <option value="${referencedocs}" selected>
                        ${referencedocs}
                    </option>
                </c:forEach>
  </c:if>              
                
            </select>
                                    
 
                                    </div>
</div>
</div>
</div>  
	        

	    </c:when>


<c:when test='${row.keymap.change_format != "" }'>
	          	      <div class="mb-1 row">
<div   title="KET->${row.keymap.mainkey }">${title } *${disabled }</div>
	            <div class="col-sm-12">   
	             <input type="text" class="form-control newinput"  step="0.1" id="${row.keymap.mainkey}" name="${row.keymap.mainkey}"  value="${transaction[row.keymap.mainkey]}" ${readonly }>
	     
	             </div>
	                 </div> 
 </c:when>

	  
	    <c:otherwise>
	
	    </c:otherwise>
	    
</c:choose>  
              
   
        </c:if>                              
 <script>                                                   
     $(document).ready(function() {
    	 
    	 
    $('.select${readonly}2').select2({
        width: '100%',
        tags: true
    });
    
  
});
</script>