
<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>

 <script>
 
 
 window.addEventListener("DOMContentLoaded", function () {
	  const theme = "${customreports.theme}";

	    var tables = document.getElementsByClassName("ui-dynamic-table-page");
	    var table = tables[0];
	    var rows = table.querySelectorAll('tbody tr');

	    const labels = [];
	    const productionData = [];
	    const axisY = "${customreports.axis_y}".split(",");
	    const axisXClass = '.cell-' + ${customreports.level};
	    const axisYClasses = axisY.map(y => '.cell-' + y);

	    // ✅ ดึงชื่อหัวคอลัมน์ของ axisX
	    const axisXHeaderIndex = parseInt(${customreports.axis_x}) - 1;
	    const axisXHeaderCell = document.getElementById("ui-dynamic-table-header-cell-" + axisXHeaderIndex);
	    const axisXHeaderLabel = axisXHeaderCell ? axisXHeaderCell.innerText : "แกน X";

	    // ✅ เตรียม array สำหรับแต่ละ axisY
	    for (let i = 0; i < axisY.length; i++) {
	        productionData.push([]);
	    }

	    // ✅ ดึงชื่อ header ของแต่ละ column ใน axisY
	    const headerLabels = [];
	    axisY.forEach(y => {
	        const correctedIndex = parseInt(y.trim()) - 1;
	        const headerCell = document.getElementById("ui-dynamic-table-header-cell-" + correctedIndex);
	        headerLabels.push(headerCell ? headerCell.innerText : "Column" + correctedIndex);
	    });

	    // ✅ อ่านค่าจากตารางจริง
	    rows.forEach(row => {
	        const labelCell = row.querySelector(axisXClass);
	        labels.push(labelCell ? labelCell.innerText : '');

	        for (let i = 0; i < axisY.length; i++) {
	            const dataCell = row.querySelector(axisYClasses[i]);
	            const value = dataCell ? Number(dataCell.innerText) : 0;
	            productionData[i].push(value);
	        }
	    });

	    // ✅ สร้าง chart
	    const ctx = document.getElementById('myChart').getContext('2d');
	    const myChart = new Chart(ctx, {
	        type: 'bar',
	        data: {
	            labels: labels,
	            datasets: axisY.map((y, index) => ({
	                label: headerLabels[index],
	                data: productionData[index],
	                backgroundColor: getThemeColor(theme, index),
	                borderColor: getThemeColor(theme, index),
	                borderWidth: 1
	            }))
	        },
	        options: {
	            responsive: true,
	          
	            
	            plugins: {
	            	/*
	                datalabels: {
	                	  anchor: 'start',       // บอกให้เริ่มจากใต้แท่ง
	                      align: 'top',          // ชิดด้านบนของ anchor = ล่างของแท่ง
	                      offset: 10,            // ดันลงล่าง
	                      clip: false,           // ให้แสดงแม้ออกนอก chart
	                      formatter: function(value, context) {
	                          return headerLabels[context.datasetIndex];
	                      },
	                    color: '#000',
	                    font: {
	                        weight: 'bold'
	                    }
	                },
	                
	              */  
	  
	                legend: {
	                    position: 'top'
	                }
	            },
	            scales: {
	                y: {
	                    beginAtZero: true
	                }
	            }
	        },
	       // plugins: [ChartDataLabels] // ✅ ใส่ตรงนี้ นอก options
	    });
	});

 
 
 
 
 </script> 