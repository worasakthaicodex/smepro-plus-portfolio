
<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>

 <script>
 
 
 window.addEventListener("DOMContentLoaded", function () {
	  const theme = "${customreports.theme}";

	    // ฟังก์ชันเพิ่มคอมมาในตัวเลข
	    function numberWithCommas(x) {
	        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
	    }

	    // ดึงตาราง
	    var tables = document.getElementsByClassName("ui-dynamic-table-page");
	    var table = tables[0];
	    if (!table) {
	        console.error("ไม่พบตาราง ui-dynamic-table-page");
	        return;
	    }
	    var rows = table.querySelectorAll('tbody tr');
	    if (!rows.length) {
	        console.error("ไม่พบแถวในตาราง");
	        return;
	    }

	    // กำหนด axisY และ axisXClass
	    var axisY = "${customreports.axis_y}".split(",");
	    var axisXClass = '.cell-' + ${customreports.level};
	    var axisYClasses = axisY.map(function(y) { return '.cell-' + y; });

	    // ดึงชื่อหัวคอลัมน์ของ axisX
	    var axisXHeaderIndex = parseInt(${customreports.axis_y}) - 1;
	    var axisXHeaderCell = document.getElementById("ui-dynamic-table-header-cell-" + axisXHeaderIndex);
	    var axisXHeaderLabel = axisXHeaderCell ? axisXHeaderCell.innerText : "";

	    // ดึงชื่อ header ของแต่ละ column ใน axisY (สำหรับ datasets)
	    var headerLabels = [];
	    for (var i = 0; i < axisY.length; i++) {
	        var correctedIndex = parseInt(axisY[i].trim()) - 1;
	        var headerCell = document.getElementById("ui-dynamic-table-header-cell-" + correctedIndex);
	        headerLabels.push(headerCell ? headerCell.innerText : "Month " + (i + 1));
	    }

	    // เตรียมข้อมูล
	    var labels = [];
	    var productionData = [];
	    for (var i = 0; i < axisY.length; i++) {
	        productionData.push([]);
	    }

	    // อ่านค่าจากตาราง
	    for (var i = 0; i < rows.length; i++) {
	        var row = rows[i];
	        var labelCell = row.querySelector(axisXClass);
	        labels.push(labelCell ? labelCell.innerText : 'แถว ' + (i + 1));

	        for (var j = 0; j < axisY.length; j++) {
	            var dataCell = row.querySelector(axisYClasses[j]);
	            var value = dataCell && dataCell.innerText ? Number(dataCell.innerText) : 0;
	            productionData[j].push(value);
	        }
	    }

	    // สร้าง datasets
	    var datasets = [];
	    for (var i = 0; i < axisY.length; i++) {
	        datasets.push({
	            label: headerLabels[i], // เช่น "Month 2", "Month 3"
	            data: productionData[i],
	            backgroundColor: getThemeColor(theme, i),
	            borderColor: getThemeColor(theme, i),
	            borderWidth: 1,
	            stack: 'Stack 0' // ทำให้ทุก dataset อยู่ใน stack เดียวกัน
	        });
	    }

	    // สร้าง chart
	    var ctx = document.getElementById('myChart').getContext('2d');
	    var myChart = new Chart(ctx, {
	        type: 'bar',
	        data: {
	            labels: labels, // เช่น ["อบ", "ผสมส่วนผสม", "การผัด"]
	            datasets: datasets
	        },
	        options: {
	            responsive: true,
	            plugins: {
	                legend: {
	                    display: true,
	                    position: 'top', // Legend อยู่ด้านล่าง
	                    labels: {
	                        font: { size: 14 }
	                    }
	                },
	                tooltip: {
	                    callbacks: {
	                        label: function(context) {
	                            var label = context.dataset.label || '';
	                            var value = context.raw || 0;
	                            return label + ": " + numberWithCommas(value);
	                        }
	                    }
	                }
	                /*
	                datalabels: {
	                    anchor: 'center',
	                    align: 'center',
	                    clip: false,
	                    formatter: function(value, context) {
	                        return value > 0 ? numberWithCommas(value) : '';
	                    },
	                    color: '#000',
	                    font: {
	                        weight: 'bold'
	                    }
	                }
	                */
	            },
	            scales: {
	                x: {
	                    stacked: true, // ทำให้แท่งซ้อนกันในแกน X
	                    title: {
	                        display: true,
	                        text: axisXHeaderLabel // เช่น "ขั้นตอน"
	                    }
	                },
	                y: {
	                    stacked: true, // ทำให้ความสูงซ้อนกัน
	                    beginAtZero: true,
	                    title: {
	                        display: true,
	                        text: ""
	                    }
	                }
	            }
	        }
	        // plugins: [ChartDataLabels] // เปิดถ้าต้องการ datalabels
	    });

	    // DEBUG
	    console.log("Labels (X):", labels);
	    console.log("Header Labels (Datasets):", headerLabels);
	    console.log("Production Data:", productionData);
	    console.log("Datasets:", datasets);
	});
 
 </script> 