
<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>

 <script>

 window.addEventListener("DOMContentLoaded", function () {
	  var theme = "${customreports.theme}";

	    // ฟังก์ชันเพิ่มคอมมาในตัวเลข
	    function numberWithCommas(x) {
	        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
	    }

	    // ดึงตาราง
	    var tables = document.getElementsByClassName("ui-dynamic-table-page");
	    var table = tables[0];
	    if (!table) {
	        console.error("ไม่พบตาราง ui-dynamic-table-page");
	        return;
	    }
	    var rows = table.querySelectorAll('tbody tr');
	    if (!rows.length) {
	        console.error("ไม่พบแถวในตาราง");
	        return;
	    }

	    // กำหนด axisY และ Title column
	    var axisY = "${customreports.axis_y}".split(","); // "38" (Frequency)
	    var axisYClass = '.cell-' + axisY[0]; // .cell-38
	    var titleClass = '.cell-' + ${customreports.level}; // .cell-36 (Title)

	    // ดึงชื่อ header ของ Frequency (สำหรับ label ของ dataset)
	    var frequencyIndex = parseInt(axisY[0]) - 1; // 38 - 1 = 37
	    var frequencyHeaderCell = document.getElementById("ui-dynamic-table-header-cell-" + frequencyIndex);
	    var frequencyHeaderLabel = frequencyHeaderCell ? frequencyHeaderCell.innerText : "Frequency";

	    // เตรียม labels จาก Title
	    var headerLabels = [];
	    headerLabels.push(""); // เพิ่ม "เริ่ม"
	    headerLabels.push(""); // เพิ่ม "เริ่ม"
	    for (var i = 0; i < rows.length; i++) {
	        var row = rows[i];
	        var titleCell = row.querySelector(titleClass);
	        var label = titleCell ? titleCell.innerText : "Title " + (i + 1);
	        headerLabels.push(label);
	    }
	    headerLabels.push(""); // เพิ่ม "สิ้นสุด"
	    headerLabels.push(""); // เพิ่ม "สิ้นสุด"
	    // เตรียมข้อมูลสำหรับ dataset เดียว
	    var data = [];
data.push(0); // เพิ่ม 0 ที่จุดเริ่มต้น
data.push(0); // เพิ่ม 0 ที่จุดเริ่มต้น
	    for (var i = 0; i < rows.length; i++) {
	        var row = rows[i];
	        var dataCell = row.querySelector(axisYClass); // .cell-38
	        var value = dataCell && dataCell.innerText ? Number(dataCell.innerText) : 0;
	        data.push(value);
	    }
	data.push(0); // เพิ่ม 0 ที่จุดสิ้นสุด
	data.push(0); // เพิ่ม 0 ที่จุดสิ้นสุด
	    // สร้าง dataset เดียว
	    var datasets = [{
	        label: frequencyHeaderLabel, // "Frequency"
	        data: data, // เช่น [0, 1.0, 1.0, 2.0, 0]
	        backgroundColor: getThemeColor(theme, 0), // Opacity 50%
	        borderColor: getThemeColor(theme, 0),
	        borderWidth: 1,
	        fill: true, // เติมสีสำหรับ Bell Curve
	        tension: 0.4, // เส้นโค้งนุ่มนวล
	        cubicInterpolationMode: 'monotone' // โค้งเรียบ
	    }];

	    // สร้าง chart
	    var ctx = document.getElementById('myChart').getContext('2d');
	    var myChart = new Chart(ctx, {
	        type: 'line', // Line Chart สำหรับ Bell Curve
	        data: {
	            labels: headerLabels, // เช่น ["เริ่ม", "ช้า", "กลาง", "เร็ว", "สิ้นสุด"]
	            datasets: datasets
	        },
	        options: {
	            responsive: true,
	            plugins: {
	                legend: {
	                    display: false // ซ่อน legend เพราะมี dataset เดียว
	                },
	                tooltip: {
	                    callbacks: {
	                        label: function(context) {
	                            var label = context.dataset.label || '';
	                            var value = context.raw || 0;
	                            return label + ": " + numberWithCommas(value);
	                        }
	                    }
	                }
	                /*
	                datalabels: {
	                    anchor: 'center',
	                    align: 'top',
	                    offset: 5,
	                    clip: false,
	                    formatter: function(value, context) {
	                        return value > 0 ? numberWithCommas(value) : '';
	                    },
	                    color: '#000',
	                    font: {
	                        weight: 'bold'
	                    }
	                }
	                */
	            },
	            scales: {
	                y: {
	                    beginAtZero: true,
	                    title: {
	                        display: true,
	                        text: "ความถี่"
	                    },
	                    ticks: {
	                        stepSize: 1 // ช่วงแกน Y เป็น 1
	                    }
	                },
	                x: {
	                    title: {
	                        display: true,
	                        text: ""
	                    }
	                }
	            }
	        }
	        // plugins: [ChartDataLabels] // เปิดถ้าต้องการ datalabels
	    });

	    // DEBUG
	    console.log("Labels (X):", headerLabels);
	    console.log("Dataset:", datasets);
	});
 
 </script> 