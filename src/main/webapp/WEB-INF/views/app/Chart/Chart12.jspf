
<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>



 <script>
 window.addEventListener("DOMContentLoaded", function () {
	    // กำหนด theme จาก customreports
	    const theme = "${customreports.theme}";

	    // ฟังก์ชันเพิ่มคอมมาในตัวเลข
	    function numberWithCommas(x) {
	        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
	    }

	    // ดึงตาราง
	    var tables = document.getElementsByClassName("ui-dynamic-table-page");
	    var table = tables[0];
	    if (!table) {
	        console.error("ไม่พบตาราง ui-dynamic-table-page");
	        return;
	    }
	    var rows = table.querySelectorAll('tbody tr');
	    if (!rows.length) {
	        console.error("ไม่พบแถวในตาราง");
	        return;
	    }

	    // กำหนด axisX, axisY, และ level
	    var axisY = "${customreports.axis_x}".split(",")[0]; // วันที่ (cell-3)
	    var axisX = "${customreports.axis_y}".split(",")[0]; // ผลตรวจ (cell-6)
	    var levelClass = '.cell-' + ${customreports.level}; // สินค้า (cell-2)

	    // ดึงชื่อ header สำหรับกราฟ
	    var seriesHeaderIndex = parseInt(${customreports.level}) - 1; // 2 - 1 = 1
	    var seriesHeaderCell = document.getElementById("ui-dynamic-table-header-cell-" + seriesHeaderIndex);
	    var chartTitleLabel = seriesHeaderCell ? seriesHeaderCell.innerText : "";

	    var xHeaderIndex = parseInt(axisX) - 1; // 6 - 1 = 5
	    var xHeaderCell = document.getElementById("ui-dynamic-table-header-cell-" + xHeaderIndex);
	    var xAxisLabel =  "";

	    var yHeaderIndex = parseInt(axisY) - 1; // 3 - 1 = 2
	    var yHeaderCell = document.getElementById("ui-dynamic-table-header-cell-" + yHeaderIndex);
	    var yAxisLabel =  "";

	    // เตรียมข้อมูลสำหรับกราฟ
	    var groupedData = {};
	    var dateTimes = [];
	    var seriesLabels = [];

	    // วนลูปผ่านแถวเพื่อนับจำนวน
	    for (var i = 0; i < rows.length; i++) {
	        var row = rows[i];
	        var productCell = row.querySelector(levelClass); // cell-2
	        var product = productCell ? productCell.innerText : "ไม่ระบุ";
	        var dateCell = row.querySelector('.cell-' + axisY); // cell-3
	        var resultCell = row.querySelector('.cell-' + axisX); // cell-6
	        var dateTime = dateCell ? dateCell.innerText : null;
	        var result = resultCell ? resultCell.innerText : "ไม่ระบุ";

	        if (dateTime) {
	            if (!dateTimes.includes(dateTime)) {
	                dateTimes.push(dateTime);
	            }

	            var seriesKey =  result; // เช่น น้ำพริกตาแดง - ไม่ผ่าน
	            if (!seriesLabels.includes(seriesKey)) {
	                seriesLabels.push(seriesKey);
	            }

	            if (!groupedData[dateTime]) {
	                groupedData[dateTime] = {};
	            }
	            if (!groupedData[dateTime][seriesKey]) {
	                groupedData[dateTime][seriesKey] = 0;
	            }
	            groupedData[dateTime][seriesKey]++;
	        }
	    }

	    // เรียง dateTimes จากเก่าสุดไปใหม่สุด
	    dateTimes.sort();

	    // สร้าง datasets
	    var datasets = seriesLabels.map(function(seriesKey, index) {
	        var data = dateTimes.map(function(dateTime) {
	            return groupedData[dateTime] && groupedData[dateTime][seriesKey]
	                ? groupedData[dateTime][seriesKey]
	                : 0;
	        });
	        return {
	            label: seriesKey,
	            data: data,
	            backgroundColor: colorThemes[theme][index], // ใช้สีจาก theme
	            borderColor: colorThemes[theme][index],
	            borderWidth: 1
	        };
	    });

	    // ดีบักข้อมูล
	    console.log("Theme:", theme);
	    console.log("DateTimes:", dateTimes);
	    console.log("Series Labels:", seriesLabels);
	    console.log("Grouped Data:", groupedData);
	    console.log("Datasets:", datasets);

	    // สร้างกราฟ
	    var ctx = document.getElementById('myChart').getContext('2d');
	    new Chart(ctx, {
	        type: 'bar',
	        data: {
	            labels: dateTimes, // เช่น ['2025-05-13T16:07', '2025-05-13T17:10', '2025-05-13T18:40']
	            datasets: datasets
	        },
	        options: {
	            responsive: true,
	            plugins: {
	                title: {
	                    display: true,
	                    text: "${customreports.report_name} ",
	                    font: {
	                        size: 18
	                    }
	                },
	                legend: {
	                    display: true
	                },
	                tooltip: {
	                    callbacks: {
	                        label: function(context) {
	                            var value = context.raw || 0;
	                            var series = context.dataset.label || "ไม่ระบุ";
	                            return series + ": " + numberWithCommas(value);
	                        }
	                    }
	                },
	                zoom: {
	                    pan: {
	                        enabled: true,
	                        mode: 'y',
	                        modifierKey: null
	                    },
	                    zoom: {
	                        wheel: {
	                            enabled: true
	                        },
	                        pinch: {
	                            enabled: true
	                        },
	                        mode: 'y'
	                    }
	                }
	            },
	            scales: {
	                x: {
	                    title: {
	                        display: true,
	                        text: xAxisLabel // จำนวน
	                    },
	                    ticks: {
	                        precision: 0 // แสดงจำนวนเต็ม
	                    }
	                },
	                y: {
	                    title: {
	                        display: true,
	                        text: yAxisLabel // วันที่
	                    }
	                }
	            }
	        },
	        plugins: [ChartZoom]
	    });
	});
 </script> 