<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
 <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;600&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
 <style>
.report-container {
    display: flex;
    justify-content: space-between;
    max-width: 1200px;
    margin: 20px auto;
 
}

.column {
    width: 48%;
}

.report-item {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
}

.label {
    width: 150px;
    font-weight: bold;
    margin-right: 15px;

}

.value {
    flex: 1;
    border-bottom: 1px solid #ddd; /* สีฟ้าแบบ Word */
    padding-bottom: 2px;
    
}

.report-container {
    padding: 15px;
    border-radius: 8px;

}


.form-table {
      width: 100%;
      border-collapse: collapse;
      max-width: 1000px;
      
    }

    .form-table td {
      border: 1px solid #d1d5db;
      padding: 10px 14px;
      vertical-align: middle;
           font-size: 11px;
    }

    .form-table .label {
      background-color: #f3f4f6;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 12px;
      color: #374151;
      width: 20%;
      white-space: nowrap;
    }

    .form-table input[type="text"],
    .form-table input[type="email"] {
      width: 100%;
      border: none;
      font-size: 14px;
      color: #111827;
      outline: none;
      background-color: transparent;
    }

    input::placeholder {
      color: #9ca3af;
    }

    @media (max-width: 768px) {
      .form-table tr {
        display: block;
        margin-bottom: 10px;
      }

      .form-table td {
        display: block;
        width: 100%;
      }

      .form-table .label {
        width: 100%;
      }
    }
  </style>
    
    

 <div class="report-container">
        <!-- คอลัมน์ซ้าย -->
        <div class="column">
        
        <c:forEach items="${eformfields }"  begin="0"  end="6"  var="row" varStatus="count">

 
        <c:set var="title" value="${row.field_label }" />  
            <div class="report-item" title="${row.keymap.mainkey}">
                <span class="label">${title }:</span>
                <span class="value">${transaction[row.keymap.mainkey]}&nbsp;</span>
            </div>
    
            
      	<c:if test="${row.keymap.mainkey == 'title_string1'  
      	or row.keymap.mainkey == 'title_string2'  
      	or row.keymap.mainkey == 'title_string3'
      	or row.keymap.mainkey == 'title_string4'
      	or row.keymap.mainkey == 'title_string5'
      	 }">        
                <script>
                
            
                

                var title_string1 = "${transaction[row.keymap.mainkey]}";
      var suggestions = title_string1.split(',');

      
      var inputmainkey =  '${fn:replace(row.keymap.mainkey, "title", "results")}';   
      var input = document.getElementById(inputmainkey);
      
      input.placeholder = title_string1;
    // สร้าง container สำหรับ suggestion
    var suggestionBox = document.createElement("div");
    suggestionBox.classList.add("autocomplete-items");
    suggestionBox.style.display = "none";
    document.body.appendChild(suggestionBox);

    // ฟังก์ชันแสดงผลลัพธ์
    input.addEventListener("input", function () {
      const value = this.value.toLowerCase();
      suggestionBox.innerHTML = '';
      suggestionBox.style.display = 'none';

 
      const matched = suggestions.filter(item => item.toLowerCase().includes(value));

      if (matched.length > 0) {
        matched.forEach(item => {
        	var div = document.createElement("div");
          div.classList.add("autocomplete-item");
          div.textContent = item;
          div.addEventListener("click", function () {
            input.value = item;
            suggestionBox.innerHTML = '';
            suggestionBox.style.display = 'none';
          });
          suggestionBox.appendChild(div);
        });

        // ตำแหน่ง suggestion box ให้ตรง input
        const rect = input.getBoundingClientRect();
        suggestionBox.style.left = rect.left + "px";
        suggestionBox.style.top = (rect.bottom + window.scrollY) + "px";
        suggestionBox.style.width = rect.width + "px";
        suggestionBox.style.display = 'block';
      }
    });

    // ซ่อน suggestion เมื่อคลิกนอก input
    document.addEventListener("click", function (e) {
      if (e.target !== input) {
        suggestionBox.innerHTML = '';
        suggestionBox.style.display = 'none';
      }
    });
  </script>   
   </c:if>   
  
  
  
<c:if test="${row.keymap.mainkey == 'title_number1'  
    or row.keymap.mainkey == 'title_number2'  
    or row.keymap.mainkey == 'title_number3'
    or row.keymap.mainkey == 'title_number4'
    or row.keymap.mainkey == 'title_number5'}">
          
     <script>
    // รับค่าจากฝั่งเซิร์ฟเวอร์
    
    
    
    
    
      var title_string1 = "${transaction[row.keymap.mainkey]}";

    var suggestions = title_string1.split(',');

    // แปลงเป็นตัวเลขและกรองที่เป็นตัวเลขจริง
    var numericValues = suggestions
      .map(x => parseFloat(x))
      .filter(x => !isNaN(x));

    var minVal = Math.min(...numericValues);
    var maxVal = Math.max(...numericValues);

    // input element

    var inputmainkey =  '${fn:replace(row.keymap.mainkey, "title", "results")}';   
    var input = document.getElementById(inputmainkey);
    input.placeholder = title_string1;

    input.addEventListener("input", function () {
      var val = parseFloat(this.value);

      if (isNaN(val)) {
        // ไม่ใช่ตัวเลข → ขอบแดง
        this.style.border = "1px solid red";
      } else if (val < minVal || val > maxVal) {
        // ตัวเลขแต่นอกช่วง → ขอบแดง
        this.style.border = "1px solid red";
      } else {
        // อยู่ในช่วง → เอาขอบแดงออก
        this.style.border = "";
      }
    });
  </script>   
     </c:if>       
        </c:forEach>    
           
        </div>

        <!-- คอลัมน์ขวา -->
        <div class="column">
   
      <c:forEach items="${eformfields }" begin="7"  end="14"   var="row" varStatus="count">

       	<c:if test="${!fn:contains(action_batch_insert,row.keymap.mainkey)  }">  
        <c:set var="title" value="${row.field_label }" />  
            <div class="report-item">
                <span class="label">${title }:</span>
                <span class="value">${transaction[row.keymap.mainkey]}&nbsp;</span>
            </div>
            </c:if>
        </c:forEach>   
  
        </div>
    </div>


         
   
 