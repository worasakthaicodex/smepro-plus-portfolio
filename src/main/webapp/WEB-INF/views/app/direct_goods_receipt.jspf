<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
 

<style>
		 table {
		    border-collapse:collapse;
		    margin: 0;
		  width: 100%;
		   border: 1px solid #eee;
		   
		}
		
		
		td {
    text-align: center;
   border: 1px solid #eee;
      max-width: 200px;
     font-size:14px;
      overflow: hidden;   /*ซ่อนเนื้อหาที่ล้น */
  text-overflow: ellipsis; /* เพิ่มจุดไข่ปลา (ellipsis) เมื่อเนื้อหาล้น */
  white-space: nowrap; /* ป้องกันการขึ้นบรรทัดใหม่ */
  padding:10px;
}
td  .action{
 text-align: center;
    border: 1px solid #eee;
    max-width: 200px;
    font-size: 14px;
    white-space: normal; /* ขึ้นบรรทัดใหม่เมื่อเนื้อหาล้น */
    
}



td:first-child { text-align: left; }


th {
    text-align: center;
   border: 1px solid #eee;
  background-color: #f2f2f2;
     height: 30px;
     
}
		
</style>
    <c:if test="${typeshow == 1 }"> 

	   <li class="d-flex justify-content-between align-items-center">
	                                                        <p>Direct Goods Receipt</p>
	                                                        <p class="fw-bold">  ${dgr.dgr_date}${dgr.dgr_id}</p>
	         </li>                                              
	                                                        
	   				  <li class="d-flex justify-content-between align-items-center">
	      				 <c:set var="display_stock_stockid" value="" />
                                       <c:if test="${card_stock != null }">
                                         <c:set var="display_stock_stockid" value="SID: ${card_stock.stock_id } List: ${card_stock.stock_list }  Quantity: ${card_stock.stock_remaining+0.0 }${card_stock.stock_unit } PD: ${card_stock.stock_pd } Batch: ${card_stock.stock_batch }" />
                                       </c:if>
	     
	                                                        <p>  <spring:message code="stock.list" /></p>
	                                                        <p class="fw-bold">${display_stock_stockid }</p>
	      </li>  
	      
	          <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.stock_date"  /></p>
	                                                        <p class="fw-bold">${stock.stock_date }</p>
	      </li>  
	      
	      
	      
	            <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.received"  /></p>
	                                                        <p class="fw-bold">${stock.stock_received }</p>
	      </li>  
	      
	            <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.storage"  /></p>
	                                                        <p class="fw-bold">${stock.stock_storage }</p>
	      </li>  
	      

	      
	    <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.lot"  /></p>
	                                                        <p class="fw-bold">${stock.stock_lot }</p>
	     </li>
	     
	        <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.SerialNumber"  /></p>
	                                                        <p class="fw-bold">${stock.stock_serial_number }</p>
	     </li>
	        <li class="d-flex justify-content-between align-items-center">
	                                                        <p><spring:message code="stock.expdate"  /></p>
	                                                        <p class="fw-bold">${stock.stock_expdate }</p>
	     </li>
	
	      
	     </c:if>  
	     
	     
	      <c:if test="${typeshow == 2 }">  
	       <div class="col-12">
                                                <div class="mb-1 row">
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >Direct Goods Receipt</label>
                                                    </div>
                                                     <div class="col-sm-9"> 
                                                     
                                                              <input type="text" class="form-control"  readonly value=" ${dgr.dgr_date}${dgr.dgr_id}" >
                                                      </div>
                                                     </div> 
                                           </div>  
                                           
                                            
                                       
   											<div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                               
                                                      
                                                        <spring:message code="stock.list" />
                                                        </label>
                                                    </div>
 
														
                                                     <div class="col-sm-9" > 
                    			
                                        
                                        <div class="input-group">
                                     <span class="input-group-text" id="basic-addon-search1"  >
                                      <a href="#" data-bs-toggle="modal" data-bs-target="#new-stock-modal">  
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
       								 </a>
                                        </span>
                                        
                                       <c:set var="display_stock_stockid" value="" />
                                       <c:if test="${card_stock != null }">
                                         <c:set var="display_stock_stockid" value="SID: ${card_stock.stock_id } List: ${card_stock.stock_list }  Quantity: ${card_stock.stock_remaining+0.0 }${card_stock.stock_unit } PD: ${card_stock.stock_pd } Batch: ${card_stock.stock_batch }" />
                                       </c:if>
 
 
                                        <input type="text" class="form-control" id="display_stock_stockid"    value="${display_stock_stockid }"  readonly required>
                                    </div>
                                        
                                                     <input type="hidden"  class="form-control" name="stock_id"   value="${stock.stock_id+0 }" >
                                                     <input type="hidden"  class="form-control" name="stock_stockid"  id="stock_stockid"   value="${stock.stock_stockid+0 }" >
                                      
                                       
                                                     
                                                      </div>
                                                      
                                                      
                                                      
                                                     </div> 
                                           </div>
                                         <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.stock_date" />
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 
                                                    <input type="date"  class="form-control" name="stock_date"   value="${stock.stock_date }" >
                                       
                                                    
                                                      </div>
                                                     </div> 
                                           </div>


                                            <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.received" />
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 
                                                    <input type="number" step="0.1"  class="form-control" name="stock_received"   value="${stock.stock_received }" required>
                                
                                                    
                                                      </div>
                                                     </div> 
                                           </div>
                                     
                                        <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                          <spring:message code="stock.storage"   />    
                                                        
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 
                                                    <select class="form-select" name="stock_storage" >
                                                      <c:forEach items="${storage_all }" var="row" varStatus="count" >
                                                        <option value="${row.dataset_data_title }"
                                                        <c:if test="${stock.stock_storage == row.dataset_data_title }">selected </c:if>
                                                        >${row.dataset_data_title }</option>
                                                        </c:forEach>
                                                    </select>
                                                    
                                                      </div>
                                                     </div> 
                                       </div>        
                                       
                                     
                                               
                                      
                                   
                                       
                                           
                                    <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.lot"   />
                                                        
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 

                                                <input type="text"  class="form-control" name="stock_lot"   value="${stock.stock_lot}" >
                                                    
                                                      </div>
                                                     </div> 
                                       </div>
                                        <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.SerialNumber"   />
                                                        
                                                        </label>
                                                    </div>
 
                                                     <div class="col-sm-9"> 

                                                <input type="text"  class="form-control" name="stock_serial_number"   value="${stock.stock_serial_number}" >
                                                    
                                                      </div>
                                                     </div> 
                                       </div>
                                              <div class="col-12">
                                                <div class="mb-1 row">   
                                                    <div class="col-sm-3">
                                                        <label class="col-form-label" for="fname-icon" >
                                                        <spring:message code="stock.expdate"  />
                                                        </label>
                                                    </div>
                                                     <div class="col-sm-9"> 
                                                 		   <input type="date"  class="form-control" name="stock_expdate"   value="${stock.stock_expdate }" >
                                                      </div>
                                                     </div> 
                                        </div>
                                           
                              
                                       
                                          
	       </c:if>  
	       
	       
	       	      <c:if test="${typeshow == 3 }">  
	       	      
<style>
 #Register th {
    position: sticky;
    top: 0;
    z-index: 10; /* ให้แน่ใจว่าหัวตารางอยู่ด้านบน */
}        
 </style>       
       <input type="text" id="searchInputstock_card" placeholder="Search..." class="form-control mb-3">
              
	       	      
	       	              <div style="max-height:500px;overflow-y:auto">
	       	        <table   class="tabledata" style="height:auto" id="stock_card" >
                                    <thead>
                                        <tr>
                                            <th class="form-label fixhead">SID</th>
                                            <th class="form-label fixhead"> <spring:message code="stock.list" /></th>
                                             <th class="form-label fixhead"><spring:message code="stock.type"  /></th>
   										 <th class="form-label fixhead"><spring:message code="stock.quantity" /></th>
   										      <th class="form-label fixhead"><spring:message code="item.unit" text="หน่วยนับ" /></th>
   										      
   									    <th style="font-size: 10px;padding:5px"><spring:message code="maindata.pd"  /></th>
                      <th style="font-size: 10px;padding:5px"><spring:message code="maindata.batch"  /></th>
   										      
   										          <th class="form-label fixhead">Action</th>
                                            </tr>
                                            
                                            
                                           
                                           
                                        </tr>
                                    </thead>
                                    <tbody>
                          
                          
 
                                        <c:forEach items="${stock_card }" var="row" varStatus="count">
				                                      <tr>
				                                            <td data-custom="id">${row.stock_receipt_date }${row.stock_id }</td>
				                                             <td data-custom="list">${row.stock_list }</td>
				                                             <td data-custom="type">${row.stock_type }</td>
				                                            <td data-custom="quantity">${row.stock_remaining+0.0 }</td>
  															<td data-custom="unit">${row.stock_unit }</td>
  	
  														    <td data-custom="product">${row.stock_pd }</td>
  															<td data-custom="batch">${row.stock_batch }</td >
  																<td>
  													
  															<a class="btn btn-sm btn-success" onclick="selectd('SC-${count.count}')"><spring:message code="maindata.apply"  /></a>
  											
  															
  														
  																</td >
				                                        </tr>
				                                        
				                     
                                        </c:forEach>
                                        
                                    </tbody>
                                    </table> 
                                    </div>
                                    
                   <script>
    $(document).ready(function() {
        // ฟังก์ชันกรองข้อมูลเมื่อพิมพ์ลงในช่องSearch
        $("#searchInputstock_card").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $("#stock_card tbody tr").filter(function() {
                // ซ่อนหรือแสดงแถวตามการSearch
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });
    });
</script>                          
                                    
                                    
      
	      	  
	      	    <script>    

	       	  
	          $("#stock_card").on("click", "a", function(event) {
	        	    event.preventDefault();
	        	    // ดึงข้อมูลจากแถวที่กดเลือก
	        	    const row = $(this).closest("tr");
	        	    const list = row.find("td[data-custom='list']").text();
	        	    const type = row.find("td[data-custom='type']").text();
	         	    const quantity = row.find("td[data-custom='quantity']").text();
	         	    const unit = row.find("td[data-custom='unit']").text();
	         	    const id = row.find("td[data-custom='id']").text();
	         	   const product = row.find("td[data-custom='product']").text();
	         	  const batch = row.find("td[data-custom='batch']").text();
	         	   
	         	  
	         	    $("#stock_stockid").val(id);
	         	    $("#stock_pd").val(product);
	         	    $("#stock_batch").val(batch);
	         	   
	         	   
	        	    const data =  " SID: "+id+" List: "+list+" Quantity: "+quantity+""+unit+" PD: "+product+" Batch: "+batch;
	        	    
	        	    // นำข้อมูลที่ได้ไปใส่ใน input ที่ต้องการ
	        	    $("#display_stock_stockid").val(data).css("border", "2px solid red").prop("disabled", true);

	        	    // หากต้องการทำให้สีขอบกลับเป็นปกติหลังจากเวลาหนึ่ง
	        	    setTimeout(function() {
	        	        $("#display_stock_stockid").css("border", "").prop("readonly", false);
	        	    }, 10000); // 10000ms = 10 วินาที
	        	       
	        	});
	      	  </script>    
	       	          </c:if>  
	       	          
	       	          
	       	          
	    	<c:if test="${typeshow == 4}">  
	       	              ${stock.stock_support_dataflow }
      
	       	 </c:if>  
	      