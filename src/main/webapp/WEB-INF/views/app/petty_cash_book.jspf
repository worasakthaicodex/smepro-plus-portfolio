<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
 

<style>
		 table {
		    border-collapse:collapse;
		    margin: 0;
		  width: 100%;
		   border: 1px solid #eee;
		   
		}
		
		
		td {
    text-align: center;
   border: 1px solid #eee;
      max-width: 200px;
     font-size:14px;
      overflow: hidden;   /*ซ่อนเนื้อหาที่ล้น */
  text-overflow: ellipsis; /* เพิ่มจุดไข่ปลา (ellipsis) เมื่อเนื้อหาล้น */
  white-space: nowrap; /* ป้องกันการขึ้นบรรทัดใหม่ */
  padding:10px;
}
td  .action{
 text-align: center;
    border: 1px solid #eee;
    max-width: 200px;
    font-size: 14px;
    white-space: normal; /* ขึ้นบรรทัดใหม่เมื่อเนื้อหาล้น */
    
}



td:first-child { text-align: left; }


th {
    text-align: center;
   border: 1px solid #eee;
  background-color: #f2f2f2;
     height: 30px;
     
}
		
</style>
 <c:set var="readonly" value="readonly" />
<c:if test="${docs== null ||  docs.current_step == 'draft' ||  docs.current_step == 'rejected'     }"> 
 <c:set var="readonly" value="" />
</c:if>

    <c:if test="${typeshow == 1 }"> 

					   <li class="d-flex justify-content-between align-items-center">
						    <p>Stock Requisition</p>
						   <p class="fw-bold">${sr.sr_date}${sr.sr_id}</p>
					   </li>                                              
	                      <li class="d-flex justify-content-between align-items-center">
						    <p><spring:message code="stock.stock_daterequisition" /></p>
						   <p class="fw-bold">${stock.stock_date }</p>
					   </li>                                        
	   		
	      
	
	      
	     </c:if>  
	     
	     
	      <c:if test="${typeshow == 2 }">  

	         
	       
	        <input type="hidden" name="tempId"  readonly value="${tempId}" >
	         <input type="hidden" name="datalink_name"  readonly value="${key.datalink_name}" >
	        

                   		

                            
              
                                           
                              
                  
                                          
	       </c:if>  
	       
	       
	       	      <c:if test="${typeshow == 3 }">  
	       	      
<style>
 #Register th {
    position: sticky;
    top: 0;
    z-index: 10; /* ให้แน่ใจว่าหัวตารางอยู่ด้านบน */
}        
 </style>     
 
 

       <input type="text" id="searchInputstock_card" placeholder="Search..." class="form-control mb-3">
              
	       	      
	       	              <div style="max-height:500px;overflow-y:auto">
	       	        <table   class="tabledata" style="height:auto" id="stock_cards" >
                                    <thead>
                                        <tr>
                                            <th class="form-label fixhead">SID</th>
                                            <th class="form-label fixhead"> <spring:message code="stock.list" /></th>
                                             <th class="form-label fixhead"><spring:message code="stock.type"  /></th>
   										 <th class="form-label fixhead"><spring:message code="stock.quantity" /></th>
   										      <th class="form-label fixhead"><spring:message code="item.unit" text="หน่วยนับ" /></th>
   										      
   									    <th style="font-size: 10px;padding:5px"><spring:message code="maindata.pd"  /></th>
                      <th style="font-size: 10px;padding:5px"><spring:message code="maindata.batch"  /></th>
   										      
   										          <th class="form-label fixhead">Action</th>
                                            </tr>
                                            
                                            
                                           
                                           
                                        </tr>
                                    </thead>
                                    <tbody>
                          
                          
 
                                        <c:forEach items="${stock_card }" var="row" varStatus="count">
				                                      <tr>
				                                            <td data-custom="id">${row.stock_receipt_date }${row.stock_id }</td>
				                                             <td data-custom="list">${row.stock_list }</td>
				                                             <td data-custom="type">${row.stock_type }</td>
				                                            <td data-custom="quantity">${row.stock_remaining+0.0 }</td>
  															<td data-custom="unit">${row.stock_unit }</td>
  	
  														    <td data-custom="product">${row.stock_pd }</td>
  															<td data-custom="batch">${row.stock_batch }</td >
  																<td>
  													
  															<a class="btn btn-sm btn-success" ><spring:message code="maindata.apply"  /></a>
  											
  															
  														
  																</td >
				                                        </tr>
				                                        
				                     
                                        </c:forEach>
                                        
                                    </tbody>
                                    </table> 
                                    </div>
                                    
                   <script>
    $(document).ready(function() {
        // ฟังก์ชันกรองข้อมูลเมื่อพิมพ์ลงในช่องSearch
        $("#searchInputstock_card").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $("#stock_cards tbody tr").filter(function() {
                // ซ่อนหรือแสดงแถวตามการSearch
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });
    });
</script>                          
                                    
                                    
      
	      	  
	      	    <script>    

	       	  
	          $("#stock_cards").on("click", "a", function(event) {
	        	    event.preventDefault();
	        	    // ดึงข้อมูลจากแถวที่กดเลือก
	        	    const row = $(this).closest("tr");
	        	    const list = row.find("td[data-custom='list']").text();
	        	    const type = row.find("td[data-custom='type']").text();
	         	    const quantity = row.find("td[data-custom='quantity']").text();
	         	    const unit = row.find("td[data-custom='unit']").text();
	         	    const id = row.find("td[data-custom='id']").text();
	         	   const product = row.find("td[data-custom='product']").text();
	         	  const batch = row.find("td[data-custom='batch']").text();
	         	 
	         	  

	         	    $("#id_stock").val(id);
	         	    $("#stock_stockid").val(quantity);
	         	

	         	   // ตั้งค่า max และ value ให้ input number
	         	   $("#qty").attr("max", quantity);

	         	   
	        	    const data =  " SID: "+id+" List: "+list+" Quantity: "+quantity+""+unit+" PD: "+product+" Batch: "+batch;
	        	    
	        	    // นำข้อมูลที่ได้ไปใส่ใน input ที่ต้องการ
	        	    $("#display_stock_stockid").val(data).css("border", "2px solid red").prop("disabled", true);

	        	    // หากต้องการทำให้สีขอบกลับเป็นปกติหลังจากเวลาหนึ่ง
	        	    setTimeout(function() {
	        	        $("#display_stock_stockid").css("border", "").prop("readonly", false);
	        	    }, 10000); // 10000ms = 10 วินาที
	        	       
	        	    
	        	    
	        	  
	        	    
	        	    
	        	});
	          
	          
	          
	      	  </script>    
	       	          </c:if>  
	       	          
	       	          
	       	          
	    	<c:if test="${typeshow == 4}">  
	       	         
	       	          <table  class="table">
                                    <thead>
                                        <tr>
                                            <th class="form-label fixhead" style="padding:5px;font-size:13px">#</th>
                                            <th class="form-label fixhead" style="padding:5px;font-size:13px"> <spring:message code="item.description" text="รายละเอียดสินค้า/บริการ" /></th>
                                             <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.amount_received" text="ยอดรับเงิน" /></th>
                                                      <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.amount_paid" text="ยอดจ่ายเงิน" /></th>
                                              <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.total" text="คงเหลือ" /></th>
                                                <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.requester" text="ผู้เขอ" /></th>
                                           

                                        </tr>
                                    </thead>
                                    <tbody>
                                        <c:set var="Clear_status" value="0" />
                                         <c:set var="Clear_status2" value="0" />
                                        <c:forEach items="${item }" var="row" varStatus="count">
				                                     <tr id="item-${row.id }">
				                                            <td style="padding:5px;font-size:13px">${count.count }</td >
				                                             <td style="padding:5px;font-size:13px">${row.description }</td >


				                                             <td style="padding:5px;font-size:13px">${row.received_qty }</td >
				                                            <td style="padding:5px;font-size:13px">${row.issued_qty }</td >
				                                            
				                                                  <c:set var="Clear_status" value="${Clear_status + row.received_qty  }" />
				           										  <c:set var="Clear_status2" value="${Clear_status2 + row.issued_qty  }" />
				           										  
				                                        	<td style="padding:5px;font-size:13px"> ${Clear_status - Clear_status2  }</td >
				                                         	<td style="padding:5px;font-size:13px"> ${row.requester }</td >
				                                                  
				                                                  
				                   
				                                        </tr>
                                        </c:forEach>
                                              </tbody>
                                              
                                                <tfoot> 
                                        				 <tr>
				                                            <td style="padding:5px;font-size:13px"></td >
				                                             <td style="padding:5px;font-size:13px"><b>TOTAL</b></td >
				                                             <td style="padding:5px;font-size:13px"><b>${Clear_status}</b></td >
				                                            <td style="padding:5px;font-size:13px"><b>${Clear_status2}</b></td >
				                                        	<td style="padding:5px;font-size:13px"> <b>${Clear_status - Clear_status2 }</b></td >
				                                             <td style="padding:5px;font-size:13px"></td>
				                             
				                                        </tr>
                                                 </tfoot>
                              
                                    </table>  
                                    
                                    <br>    <br>
                                      ${stock.stock_support_dataflow }
                                    
      
	       	 </c:if>  
	       	 
	
	
	
	<c:if test="${typeshow == 5 }">  
	       	 
	 
	 
  <c:if test="${  docs == null ||  (docs.current_step == 'draft' or docs.current_step == 'rejected'  )   }"> 	       	 

		   <button type="button"  id="submits" class="btn btn-sm btn-light " onclick="setini()"   data-bs-toggle="modal" data-bs-target="#addNewCards4" >               
			 <spring:message code="btn.add" text="เพิ่ม" />
			 </button> 
</c:if>


	<br>  	<br>     	 
	       	 
              <table  class="table">
                                    <thead>
                                        <tr>
                                            <th class="form-label fixhead" style="padding:5px;font-size:13px">#</th>
                                            <th class="form-label fixhead" style="padding:5px;font-size:13px"> <spring:message code="item.description" text="รายละเอียดสินค้า/บริการ" /></th>
                                             <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.amount_received" text="ยอดรับเงิน" /></th>
                                                      <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.amount_paid" text="ยอดจ่ายเงิน" /></th>
                                              <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.total" text="คงเหลือ" /></th>
                                                <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.requester" text="ผู้เขอ" /></th>
                                                           <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="tables.action" text="จัดการ" /></th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        <c:set var="Clear_status" value="0" />
                                         <c:set var="Clear_status2" value="0" />
                                        <c:forEach items="${item }" var="row" varStatus="count">
				                                     <tr id="item-${row.id }">
				                                            <td style="padding:5px;font-size:13px">${count.count }</td >
				                                             <td style="padding:5px;font-size:13px">${row.description }</td >


				                                             <td style="padding:5px;font-size:13px">${row.received_qty }</td >
				                                            <td style="padding:5px;font-size:13px">${row.issued_qty }</td >
				                                            
				                                                  <c:set var="Clear_status" value="${Clear_status + row.received_qty  }" />
				           										  <c:set var="Clear_status2" value="${Clear_status2 + row.issued_qty  }" />
				           										  
				                                        	<td style="padding:5px;font-size:13px"> ${Clear_status - Clear_status2  }</td >
				                                         	<td style="padding:5px;font-size:13px"> ${row.requester }</td >
				                                                  
				                                                  
				                           <td style="padding:5px;font-size:13px">
				                                    
				                                      <c:if test="${  docs.current_step == 'cleared'  }"> 
				                                        
				                                           <a herf=""   onclick="getdatas('/edititem-filemanager/${row.id }/${tempId}','savesuccess')"  
							                                      class="btn btn-sm btn-success" data-bs-toggle="modal"  data-bs-target="#addNewCards4"><spring:message code="btn.cleared"  /></a> 
				                                          </c:if>
				                                          
				                                          
				                                        <c:if test="${docs == null or ( docs.current_step == 'draft' or docs.current_step == 'rejected'  )  }"> 
							                                      <a herf=""   onclick="getdatas('/edititem-filemanager/${row.id }/${tempId}','savesuccess')"  
							                                      class="btn btn-sm btn-light" data-bs-toggle="modal"  data-bs-target="#addNewCards4"><spring:message code="btn.edit"  /></a> 
							                                    
							                        
							                                     <a herf="" class="btn btn-sm btn-danger"
							                                      onclick="getdata('/delitem-filemanager/${row.id }/${tempId}','savesuccess')" 
							                                     ><spring:message code="btn.delete"  /></a> 
				                                     </c:if>
				                                   
				                                     
				                                      </td>
				                                        </tr>
                                        </c:forEach>
                                              </tbody>
                                              
                                                <tfoot> 
                                        				 <tr>
				                                            <td style="padding:5px;font-size:13px"></td >
				                                             <td style="padding:5px;font-size:13px"><b>TOTAL</b></td >
				                                             <td style="padding:5px;font-size:13px"><b>${Clear_status}</b></td >
				                                            <td style="padding:5px;font-size:13px"><b>${Clear_status2}</b></td >
				                                        	<td style="padding:5px;font-size:13px"> <b>${Clear_status - Clear_status2 }</b></td >
				                                             <td style="padding:5px;font-size:13px"></td>
				                                                <td style="padding:5px;font-size:13px"></td>
				                                        </tr>
                                                 </tfoot>
                              
                                    </table>  
                                    
                                    
   <script>             
function setini(){
	var uuid = crypto.randomUUID();
	  $("form#formvc #id").val(uuid);	
}
                                
</script>                                      
                                    
                            
	 </c:if>  
	 
	 <c:if test="${typeshow == 6}">  
	       	         
                            

 <div class="modal fade" id="addNewCards4" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
 
                    <div class="modal-dialog   modal-lg modal-dialog-centered">
                         <div class="modal-content">
                                                        <div class="modal-header">
                                                              <h4 class="modal-title" id="myModalLabel33"> <spring:message code="item.Additem" /></h4>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                  
                                                         <form:form method="POST"  modelAttribute="SubData"  action="/additem-filemanager"  id="formvc" name ="formvc"> 
                                                     
                                                            <div class="modal-body">
                                                                <label> <spring:message code="item.description" text="รายละเอียดสินค้า/บริการ" />: </label>
                                                                <div class="mb-1">
                                                                    <input type="text" name="description"  id="description" class="form-control">
                                                                </div>

                                                                <label><spring:message code="item.amount_received" text="ยอดรับเงิน" />: </label>
                                                                <div class="mb-1">
                                                                    <input type="number" step="0.01" min="0"  name="received_qty" id="received_qty"    class="form-control">
                                                                </div>
                                                                   <label><spring:message code="item.amount_paid" text="ยอดจ่ายเงิน" />: </label>
                                                                <div class="mb-1">
                                                                    <input type="number" step="0.01" min="0"  name="issued_qty"  id="issued_qty"    class="form-control">
                                                                </div>
                                                             <label><spring:message code="item.requester" text="ผู้ขอ" />: </label>
                                                                <div class="mb-1">
                                                
		                                                <select name="requester" class="form-select select2">
		                                                
		                                               
		                                            
		                                                
		                                                	<c:forEach items="${users }"   var="row" varStatus="count">
		                                                		<option value="${row.user_name }">${row.user_name }</option>
		                                                	</c:forEach>
		                                                </select>
                                                                </div>
                                                        
                                                        
                                                    <div class="mb-1">  
      													<input type="hidden"  class="form-control" name="id"  id="id"   value="0" >
                                                      <input type="hidden"  class="form-control" name="status"  id="status"   value="PENDING" >  
                                                      <input type="hidden" name="tempId" id="tempId"  readonly value="${tempId}" >
							       					  <input type="hidden" name="datalink_name"  id="datalink_name"   readonly value="${key.datalink_name}" >
       								  					<input type="hidden" name="type"  id="type"   readonly value="${key.datalink_name}" >
                  							   <input type="checkbox" id="save"  name="save" value="1" > Don't close the window.
                  							       </div>
                                                          
                                                            </div>
                                                            <div class="modal-footer" Style="display: inline-block;">
                                                                <button type="button"  onclick='send("/additem-filemanager?${_csrf.parameterName}=${_csrf.token}","formvc","subdata")'  class="btn btn-primary waves-effect waves-float waves-light" data-bs-dismiss="modal">เพิ่ม</button>
                                                            </div>
                                                </form:form>
                                                    </div>    
                               
                                        </div>
                                        </div>
                                        
                                        
                                        
                                        
                                        
<script>             



   function send(Mode1,Mode2,Mode3){                                   
	
	    	
	    	postdata(Mode1,Mode2,Mode3);

	    	if ($("form#formvc #save").is(":checked")) {

	    	} else {
		    	const modal = bootstrap.Modal.getInstance(document.getElementById('addNewCards4'));
		    	modal.hide();
	    	}
	    	 $("form#formvc #description").val("");
	      $("form#formvc #id").val(0);
     	   $("form#formvc #issued_qty").val(0);
     	   $("form#formvc #received_qty").val(0);
     		var uuid = crypto.randomUUID();
     		 $("form#formvc #id").val(uuid);	
	    }
	    
   
   
   
   

</script>  
	 	 </c:if>  
	      