 <%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>
 
 <div class="upload-panel">
  
      
    <div class="content">
<form id="formupload${item_id}" name="formupload${item_id}"  method="POST" enctype="multipart/form-data">
   <input type="hidden"  name="file_indexapp" value="${item_id }" class="form-control">
  <input type="hidden"  name="folder" value="${file_patch}" class="form-control">
       <input type="hidden"  name="process_id" value="${process.id }" class="form-control">
       
       
<div class="upload-area" id="drop-zone-${item_id}" 
     style="cursor: pointer;"
     onclick="document.getElementById('file-input-${item_id}').click();"
     
     /* --- เพิ่มส่วนการดักจับ Drag & Drop ตรงนี้ --- */
     ondragover="event.preventDefault(); this.classList.add('drag-active');" 
     ondragleave="this.classList.remove('drag-active');"
     ondrop="handleDrop(event, '${item_id}')">

    <div class="upload-text">Drag files here to upload</div>
    <div class="upload-subtext">or click to browse from your computer</div>
    
    <input type="file" 
           id="file-input-${item_id}" 
           name="files" 
           onchange='postData("/uploadfile_indexapp-filemanager?${_csrf.parameterName}=${_csrf.token}","formupload${item_id}","main${item_id}"); this.value=null;' 
           multiple 
           style="display:none;">
</div>
                                                   
                                <c:set var="namesArray" value="${fn:split(dbValue, ',')}" /> 
                                 <spring:message code="files.tag"/><br>                              	 
                 <div class="file-list-title">
         
          <select name="file_tag" style="width:100%">   
                  <option value="-">-</option>       
                                                      	<c:forEach var="nameItem" items="${namesArray}" begin="0" end="5">
												 
												    <option value="${nameItem}">
												      ${nameItem}
												    </option>
											
												    
												</c:forEach>
                                                     	 </select>  
        </div>                                          	 
         </form>                                            	 
                                                     	 
                                                     	 
   

        <div class="file-list" id="file-list">
            <div style="padding: 20px; text-align: center; color: #999; font-size: 12px;" id="empty-msg">
             <div id="subdataformupload${item_id}">
                         <%@ include file="file.jsp" %>  
                </div>
            </div>
        </div>

      
    </div>
</div>

<script>
function handleDrop(e, dataId) {
    // 1. ป้องกัน Browser เปิดไฟล์ใหม่
    e.preventDefault();
    e.currentTarget.classList.remove('drag-active');

    // 2. ดึงไฟล์ที่ถูกลากมาวาง
    const files = e.dataTransfer.files;
    if (files.length > 0) {
        const fileInput = document.getElementById('file-input-' + dataId);
        
        // 3. เอาไฟล์ไปใส่ใน input file (เพื่อให้ postData ทำงานต่อได้)
        fileInput.files = files;
        
        // 4. สั่งรันฟังก์ชัน upload (onchange ของ input จะทำงาน)
        // หรือเรียกใช้ postData ตรงๆ เลยก็ได้
        fileInput.onchange(); 
    }
}
</script>

<style>
    /* เพิ่มลูกเล่นเวลาลากไฟล์มาวางเหนือโซน */
    .upload-area.drag-active {
        border: 2px dashed #387EE8 !important;
        background-color: #f0f7ff !important;
    }
</style>