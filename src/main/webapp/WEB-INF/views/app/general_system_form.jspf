</c:if>


	<br>  	<br>     	 
	       	 
             <table  class="table">
                                    <thead>
                                        <tr>
                                            <th class="form-label fixhead" style="padding:5px;font-size:13px">#</th>
                                            <th class="form-label fixhead" style="padding:5px;font-size:13px"> <spring:message code="item.description" text="รายละเอียดสินค้า/บริการ" /></th>
                                           
                                           
                                             <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.rq"  /></th>
                                              <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.iq"  /></th>
                                             
                                             
                                                      <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.unit" text="หน่วยนับ" /></th>
                                                      
                                                      
                                                      
                                              <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="stock.pd"  /></th>
                                              <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="stock.batch" /></th>
                                      
                                                <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="item.idate"  /></th>
                                                
                                                 
                                                  
                                                           <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="tables.action" text="จัดการ" /></th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        <c:set var="Clear_status" value="0.00" />
                                        <c:forEach items="${item }" var="row" varStatus="count">
				                                      <tr id="item-${row.id }">
				                                            <td style="padding:5px;font-size:13px">${count.count }</td >
				                                             <td style="padding:5px;font-size:13px">${row.description }</td >
				                                             <td style="padding:5px;font-size:13px">${row.qty }</td >
				                                             <td style="padding:5px;font-size:13px">${row.issued_qty }</td >
				                                            <td style="padding:5px;font-size:13px">${row.unit }</td >
				                                              <td style="padding:5px;font-size:13px">${row.pd }</td >
															  <td style="padding:5px;font-size:13px">${row.batch }</td >
															  <td style="padding:5px;font-size:13px">${row.date_action }</td >
				                                            
				                                            
				                                            
				                                            
				                                      <td style="padding:5px;font-size:13px">
				                                    
				                                      <c:if test="${  docs.current_step == 'cleared'  }"> 
				                                        
				                                           <a herf=""   onclick="getdatas('/edititem-filemanager/${row.id }/${tempId}','savesuccess')"  
							                                      class="btn btn-sm btn-success" data-bs-toggle="modal"  data-bs-target="#addNewSR2"><spring:message code="btn.cleared"  /></a> 
				                                          </c:if>
				                                          
				                                          
				                                        <c:if test="${docs == null or ( docs.current_step == 'draft' or docs.current_step == 'rejected'  )  }"> 
							                                      <a herf=""   onclick="getdatas('/edititem-filemanager/${row.id }/${tempId}','savesuccess')"  
							                                      class="btn btn-sm btn-light" data-bs-toggle="modal"  data-bs-target="#addNewSR"><spring:message code="btn.edit"  /></a> 
							                                    
							                        
							                                     <a herf="" class="btn btn-sm btn-danger"
							                                      onclick="getdata('/delitem-filemanager/${row.id }/${tempId}','savesuccess')" 
							                                     ><spring:message code="btn.delete"  /></a> 
				                                     </c:if>
				                                   
				                                     
				                                      </td>
				                                      
				                                        </tr>
                                        </c:forEach>
                                        
                                        
                                    </tbody>
                                    </table>  
                                    
                                    
   <script>             
function setini(){
	var uuid = crypto.randomUUID();
	  $("form#formsr #id").val(uuid);	
}
                                
</script>                                      
                                    
                            
	 </c:if>  
	 
	 <c:if test="${typeshow == 6}">  
	       	         
                                     <div class="modal fade" id="addNewSR" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
 
                    <div class="modal-dialog   modal-lg modal-dialog-centered">
                         <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h4 class="modal-title" id="myModalLabel33"> <spring:message code="item.Additem" /></h4>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                  
                                                         <form:form method="POST"  modelAttribute="SubData"  action="/additem-filemanager?${_csrf.parameterName}=${_csrf.token}"  id="formsr" name ="formsr"> 
                                                 
                                                 
                                                            <div class="modal-body">
                                                             
                                                             
                                                                <label> <spring:message code="item.description" text="รายละเอียดสินค้า/บริการ" />: </label>
                                                                <div class="mb-1">
                                                            
                                                                   <div class="input-group">
                                     <span class="input-group-text" id="basic-addon-search1"  >
                                      <a href="#" data-bs-toggle="modal" data-bs-target="#new-stock-modal">  
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
       								 </a>
                                        </span>
                                        
                                       <c:set var="display_stock_stockid" value="" />
                                       <c:if test="${card_stock != null }">
                                         <c:set var="display_stock_stockid" value="SID: ${card_stock.stock_id } List: ${card_stock.stock_list }  Quantity: ${card_stock.stock_remaining+0.0 }${card_stock.stock_unit } PD: ${card_stock.stock_pd } Batch: ${card_stock.stock_batch }" />
                                       </c:if>
 
 
                                        <input type="text" class="form-control" id="display_stock_stockid"    value="${display_stock_stockid }"  readonly required>
                                    </div>
                                        
                                    
                                                     <input type="hidden"  class="form-control" name="id_stock"  id="id_stock"   value="${stock.stock_stockid+0 }" >
                                                    
                                                    
                                                     <input type="hidden"  class="form-control" name="id"  id="id"   value="0" >
                                                      <input type="hidden"  class="form-control" name="status"  id="status"   value="PENDING" >  
                                                      <input type="hidden" name="tempId" id="tempId"  readonly value="${tempId}" >
							       					  <input type="hidden" name="datalink_name"  id="datalink_name"   readonly value="${key.datalink_name}" >
       								  					<input type="hidden" name="type"  id="type"   readonly value="${key.datalink_name}" >
                                                             
                                                             
                                                             
                                                             
                                                             
                                                                </div>

							 
                                                                <label><spring:message code="item.rq"  />: </label>
                                                                <div class="mb-1">
                                                                    <input type="number" step="0.01" min="0" id="qty"  name="qty"   class="form-control" required>
                                                                </div>
                                                                
                                                                
                                                               <label></label>  
                                                             <div class="mb-1">  

                  							   <input type="checkbox" id="save"  name="save" value="1" > Don't close the window.
                  							       </div>
                                                            </div>
                                                           
                                                           
                                                            <div class="modal-footer" >
                                                                <button type="button"  onclick='send("/additem-filemanager?${_csrf.parameterName}=${_csrf.token}","formsr","subdata")'  class="btn btn-primary waves-effect waves-float waves-light" >เพิ่ม</button>
                                                            </div>
                                                </form:form>
                                                    </div>    
                               
                                        </div>
                                        </div>
                                        
                                        
                                        
                                        
                                             <div class="modal fade" id="addNewSR2" tabindex="-1" aria-labelledby="addNewCardTitle" aria-hidden="true">
 
                    <div class="modal-dialog   modal-lg modal-dialog-centered">
                         <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h4 class="modal-title" id="myModalLabel33"><spring:message code="btn.cleared"  /></h4>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                  
                                                         <form:form method="POST"  modelAttribute="SubData"  action="/additem-filemanager?${_csrf.parameterName}=${_csrf.token}"  id="formsr_c" name ="formsr_c"> 
                                                 
                                                 
                                                            <div class="modal-body">
                                                             
                                                             
                                                                <label> <spring:message code="item.description" text="รายละเอียดสินค้า/บริการ" />: </label>
                                                                <div class="mb-1">
                                                            
                                                                   <div class="input-group">
                                     <span class="input-group-text" id="basic-addon-search1"  >
                                      <a href="#" data-bs-toggle="modal" data-bs-target="#new-stock-modal${readonly}">  
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
       								 </a>
                                        </span>
                                        
                                       <c:set var="display_stock_stockid" value="" />
                                       <c:if test="${card_stock != null }">
                                         <c:set var="display_stock_stockid" value="SID: ${card_stock.stock_id } List: ${card_stock.stock_list }  Quantity: ${card_stock.stock_remaining+0.0 }${card_stock.stock_unit } PD: ${card_stock.stock_pd } Batch: ${card_stock.stock_batch }" />
                                       </c:if>
 
 
                                        <input type="text" class="form-control" id="display_stock_stockid"    value="${display_stock_stockid }"  readonly required>
                                    </div>
                                        
                                    
                                                     <input type="hidden"  class="form-control" name="id_stock"  id="id_stock"   value="${stock.stock_stockid+0 }" >
                                                     <input type="hidden"  class="form-control" name="id"  id="id"   value="0" >
                                                        <input type="hidden"  class="form-control" name="status"  id="status"   value="CLEARED" >  
                                                             
                                                             
                                                             
                                                             
                                                             
                                                                </div>

							        <input type="hidden" name="tempId" id="tempId"  readonly value="${tempId}" >
							         <input type="hidden" name="datalink_name"  id="datalink_name"   readonly value="${key.datalink_name}" >
       								  <input type="hidden" name="type"  id="type"   readonly value="${key.datalink_name}" >

                                                                <label><spring:message code="item.rq"  />: </label>
                                                                <div class="mb-1">
                                                                    <input type="number" step="0.01" min="0" id="qty"  name="qty"   class="form-control"  ${readonly} required>
                                                                </div>
                                                                
                                                                
                                                               <label><spring:message code="item.iq"  />: </label>
                                                                <div class="mb-1">
                                                                    <input type="number" step="0.01" min="0" id="issued_qty"  name="issued_qty"   class="form-control"  required>
                                                                </div>
                                                                
                                                                 <label><spring:message code="item.idate"  />: </label>
                                                                <div class="mb-1">
                                                                    <input type="date"  id="date_action"  name="date_action"   class="form-control"  required>
                                                                </div>
                                                                
                                                               <label></label>  
                                                             <div class="mb-1">  

                  							   <input type="checkbox" id="save"  name="save" value="1" > Don't close the window.
                  							       </div>
                                                            </div>
                                                           
                                                           
                                                            <div class="modal-footer" >
                                                                <button type="button"  onclick='send2("/additem-filemanager?${_csrf.parameterName}=${_csrf.token}","formsr_c","subdata")'  class="btn btn-primary waves-effect waves-float waves-light" >เพิ่ม</button>
                                                            </div>
                                                </form:form>
                                                    </div>    
                               
                                        </div>
                                        </div>
                                        
                                        
                                        
                                        
                                        
<script>             


$("form#formsr #id").val(uuid);

   function send(Mode1,Mode2,Mode3){                                   
	     var maxQty = parseInt($("form#formsr #qty").attr("max")); // ดึงค่า max
	    var currentQty = parseInt($("form#formsr #qty").val()); // ดึงค่าที่ผู้ใช้กรอก
	
	    // ถ้าเกิน maxQty ให้เซ็ตค่าเป็น max
	    if (currentQty > maxQty ) {
            alert("Error จำนวนคงเหลือไม่เพียงพอ [The remaining amount is not enough.]");  
	    }
	    
	    // ถ้าเกิน maxQty ให้เซ็ตค่าเป็น max
	    else if (currentQty > maxQty ) {
            alert("Error จำนวนคงเหลือไม่เพียงพอ [The remaining amount is not enough.]");  
	    }
	    else{
	    	
	    
	    	
	    	postdata(Mode1,Mode2,Mode3);

	    	if ($("form#formsr #save").is(":checked")) {

	    	} else {
		    	const modal = bootstrap.Modal.getInstance(document.getElementById('addNewSR'));
		    	modal.hide();
	    	}

	    
     	    $("form#formsr #id_stock").val(0);
     	    $("form#formsr #stock_stockid").val(0);
     	    $("form#formsr #qty").attr("max", 0).val(0);
     	   $("form#formsr #display_stock_stockid").val("");
     		var uuid = crypto.randomUUID();
     		  $("form#formsr #id").val(uuid);	
	    }
	    

   }  
   
   
   

