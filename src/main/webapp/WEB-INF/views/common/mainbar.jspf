                        <li  style="display:none"   class=" nav-item" ><a class="d-flex align-items-center" href="#"><i data-feather='edit-2'></i>
                
                    <c:set var="apptotal" value="0" />  
                <span class="menu-title text-truncate" data-i18n="File Manager"><spring:message code="menu.Worksystem" text="ระบบงาน" /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                &nbsp;&nbsp;&nbsp;&nbsp;
                </span>&nbsp;&nbsp; <span id="apptotal"></span>
                </a>
                    <ul class="menu-content">

                     
                        
                            <c:forEach items="${workflow }" var="row" varStatus="count">
             
			<c:if test='${row.workflow_id >  0}'>

				                   <c:if test='${count.count == 1}'>  <c:set var="job" value="${job1}" /></c:if> 
    						        <c:if test='${count.count == 2}'>  <c:set var="job" value="${job2}" /></c:if> 
    						        <c:if test='${count.count == 3}'>  <c:set var="job" value="${job3}" /></c:if> 

                                    <li    class=" nav-item"><a class="d-flex align-items-center" href="#"><i data-feather='edit-2'></i>
                
                <c:set var="jobtotal" value="0" />
                
                
                <span class="menu-title text-truncate" data-i18n="File Manager">${row.workflow_name } </span>
                   <span  id="${row.workflow_id }"></span>
                
                </a>
             
                    <ul class="menu-content">
   							<c:forEach items="${row.process }" var="rows">
             				<c:if test='${dd.new_status == 1}'>	 </c:if>
							                      <li id="app_${rows.id}"><a class="d-flex align-items-center" href="/app-filemanager/${rows.id}">
							                        <i data-feather="circle"></i>
							                        <span class="menu-item text-truncate" data-i18n="List"> ${rows.name }</span>
							                        
							                        
							                         
							                         <c:if test='${dd.alert > 0}'>  <span class="badge badge-light-danger rounded-pill ms-auto me-2">${dd.alert}  
							                            <c:set var="jobtotal" value="${jobtotal + dd.alert}" /></span>
							                            
							                            
							                        </c:if>
							                        
							                        
							                         </a>
							                        </li>
						                        
                                      </c:forEach>   
                    </ul>
                    
                    
                </li> 
                     	<c:if test='${jobtotal> 0}'>
                     	 <c:set var="apptotal" value="${apptotal + jobtotal}" />
                       <script>$("#"+${row.workflow_id }).html('<span class="badge badge-light-danger rounded-pill ms-auto me-2">${jobtotal}</span>')</script>
                        </c:if>
                        
                    </c:if>     
                        
                                          </c:forEach>  
                        
                        	<c:if test='${apptotal > 0}'>
                       <script>$("#apptotal").html('<span class="badge badge-light-danger rounded-pill ms-auto me-2">${apptotal}</span>')</script>
                        </c:if>
                        
                        
                    </ul>
                    
                    
                </li> 
                     
                     
                     
                                 
      
                </li>
          
           
            
