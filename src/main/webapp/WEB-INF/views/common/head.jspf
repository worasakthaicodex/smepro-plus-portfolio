<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>    
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>    
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %> 
    
<!DOCTYPE HTML>
	<c:choose>
                                <c:when test='${cookie.theme.value.equals("moon")}'>
                               			<html class="loading dark-layout" lang="en" data-layout="dark-layout" data-textdirection="ltr">
                                </c:when>
                                <c:otherwise>
									<html class="loaded bordered-layout" lang="en" data-layout="bordered-layout" data-textdirection="ltr">
                              </c:otherwise>
                               </c:choose>  
<head>
<meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
<meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
 <link rel="icon"  href="<c:url value="/resources/img/mini_logo.png" />" type="image/png">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500;1,600" rel="stylesheet">
  
 

    <!-- BEGIN: Vendor CSS-->
    <link href="<c:url value="/resources/app-assets/vendors/css/vendors.min.css" />" rel="stylesheet">
    <!-- END: Vendor CSS-->

    <!-- BEGIN: Theme CSS-->
     <link href="<c:url value="/resources/app-assets/css/bootstrap.css" />" rel="stylesheet">
    <link href="<c:url value="/resources/app-assets/css/bootstrap-extended.css" />" rel="stylesheet">
    <link href="<c:url value="/resources/app-assets/css/colors.css" />" rel="stylesheet">
    <link href="<c:url value="/resources/app-assets/css/components.css" />" rel="stylesheet">
    <link href="<c:url value="/resources/app-assets/css/themes/dark-layout.css" />" rel="stylesheet">
    <link href="<c:url value="/resources/app-assets/css/themes/bordered-layout.css" />" rel="stylesheet">
    <link href="<c:url value="/resources/app-assets/css/themes/semi-dark-layout.css" />" rel="stylesheet">
    
    

    <!-- BEGIN: Page CSS-->
   
    <link href="<c:url value="/resources/app-assets/css/core/menu/menu-types/vertical-menu.css" />" rel="stylesheet">
    <link href="<c:url value="/resources/app-assets/css/plugins/forms/form-validation.css" />" rel="stylesheet">
    <link href="<c:url value="/resources/app-assets/css/pages/authentication.css" />" rel="stylesheet">

    <!-- END: Page CSS-->

    <!-- BEGIN: Custom CSS-->
     <link href="<c:url value="/resources/assets/css/style.css" />" rel="stylesheet">
    <!-- END: Custom CSS-->
    
    
    