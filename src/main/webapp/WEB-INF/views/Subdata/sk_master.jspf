<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>


<style>
.fixhead {
    max-width: 150px; /* กำหนดความกว้างสูงสุด */
    white-space: nowrap; /* ป้องกันข้อความขึ้นบรรทัดใหม่ */
    overflow: hidden; /* ซ่อนข้อความที่เกินขอบเขต */
    text-overflow: ellipsis; /* แสดง ... เมื่อข้อความยาวเกินไป */
}
</style>

 				  <input type="hidden" name="process_id" value="${process_id }">
		    	  <input type="hidden" name="tables" value="${tables }">
		    	   <input type="hidden" name="filters" value="${filters }">
		    	  <input type="hidden" name="edata_id" value="${edata_id+0 }">
			  <input type="hidden" name="type" value="${type }">

    <div class="row">
                                            <div class="col-md-12 col-12">
                                                <div class="mb-1">
                                                    <label class="form-label" for="first-name-column">Search</label>
                                                    <input type="text" name="register_name" id="first-name-column" class="form-control"  name="fname-column">
                                                </div>
                                            </div>
                                            
                                       
                                      
                                      <div>       
                               <a class="btn btn-primary waves-effect waves-float waves-light" onclick='postdata("/search_workflow_dbs-filemanager?${_csrf.parameterName}=${_csrf.token}","subdata_search","wrappermain")' >Submit</a>           
                                         
                                    </div>         
                                        </div>
                                                
                                                <br>  <br>
  <table  class="table">
                                    <thead>
                                        <tr>
                                        
            	 <th class="form-label fixhead" style="padding:5px;font-size:10px">#</th>   
            	 
       					<th class="form-label fixhead" style="padding:5px;font-size:10px"><spring:message code="product.lot_batch"  /></th>         	                          
<th class="form-label fixhead" style="padding:5px;font-size:10px"><spring:message code="material.stock_code"  /></th>     
<th class="form-label fixhead" style="padding:5px;font-size:10px"><spring:message code="material.stock_name"  /></th>    
<th class="form-label fixhead" style="padding:5px;font-size:10px"><spring:message code="maindata.batch_producer"  /></th>   
  

  
  
<th class="form-label fixhead" style="padding:5px;font-size:10px"><spring:message code="fg.quantity"  /></th>     
<th class="form-label fixhead" style="padding:5px;font-size:10px"><spring:message code="fg.unit"  /></th>     

<th class="form-label fixhead" style="padding:5px;font-size:10px"><spring:message code="product.product_cost_price"  /></th>     
<th class="form-label fixhead" style="padding:5px;font-size:10px"><spring:message code="common.status"  /></th>     

     
          
          <th class="form-label fixhead" style="padding:5px;font-size:10px">#</th>  
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <c:forEach items="${item }" var="rows"  varStatus="count">
				                                     
				                                     
				                                                            <tr>
                                        
            	 <td class="form-label fixhead" style="padding:5px;font-size:13px">${count.count }</td>   
            	 
            	                          
 					<td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="code"></td>    
 					
 					 
<td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="stock_code"  title="${rows.stock_code }${rows.stock_receipt_date }${rows.stock_id }">${rows.stock_code }${rows.stock_receipt_date }${rows.stock_id }</td>     
<td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="stock_name"   title="${rows.stock_list }">${rows.stock_list }</td>        
<td class="form-label fixhead" style="padding:5px;font-size:13px"> </td>   
<td class="form-label fixhead" style="padding:5px;font-size:13px"></td>   
<td class="form-label fixhead" style="padding:5px;font-size:13px"></td>  
<td class="form-label fixhead" style="padding:5px;font-size:13px"  ></td>   
<td class="form-label fixhead" style="padding:5px;font-size:13px"  >${rows.stock_status }</td>   
          <td class="form-label fixhead" style="padding:5px;font-size:13px">
             <c:if test="${load_type != 'log'}">  <a class="btn btn-sm btn-success" onclick="showAddressTitle2(this)" data-bs-dismiss="modal">+</a></c:if>
                   <a href="/sk-workflow/${rows.id }" class="btn btn-sm btn-light" target="_blank"><i data-feather='eye'></i></a>
          </td>  
                                        </tr>
														
				                   <c:forEach items="${rows.stock_lot }" var="row"  varStatus="count">   
				                                                              <tr>
                                        
            	 <td class="form-label fixhead" style="padding:5px;font-size:13px"></td>   
            	 
            	                          
 					<td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="code" 
 					title="${row.lot_batch }">${row.lot_batch }</td>    
 					
 					 
<td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="stock_code"  title="${row.stock_code }-${row.stock_id }">${row.stock_code }-${row.stock_id }</td>     
<td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="stock_name"   title="${row.stock_name }">${row.stock_name }</td>     
<td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="tracking_number"  title="${row.tracking_number }">${row.tracking_number }</td>     
<td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="quantity"   title="${row.stock_remaining }">${row.stock_remaining }</td>   
<td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="unit"   title="${rows.stock_unit }">${rows.stock_unit }</td>  
<td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="price"   title="${row.price }">${row.price }</td>  
<td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="status"   title="${row.stock_status }">${row.stock_status }</td>  
<td  data-custom="stock_storage"   title="${row.stock_storage}" style="display:none"></td> 
<td  data-custom="supplier_name"   title="${row.supplier_name}" style="display:none"></td> 
<td  data-custom="supplier_code"   title="${row.supplier_code}" style="display:none"></td> 
 
 
 
 
          <td class="form-label fixhead" style="padding:5px;font-size:13px">
             <c:if test="${load_type != 'log'}">  <a class="btn btn-sm btn-success" title="${row.supplier_code} ${row.supplier_name} [${row.stock_storage}]"  data-bs-dismiss="modal"onclick="showAddressTitle2(this)" data-bs-dismiss="modal">+</a></c:if>
               
          </td>  
                                        </tr>
												                  
				                       	</c:forEach>                  
				                                      
                                      
                                        	</c:forEach>   
                                        
                                    </tbody>
                                    </table>     
                                    
   <script>
        
            if (feather) {
                feather.replace({
                    width: 14,
                    height: 14
                });
            }
      
    </script>                                   
                                    
<script>
function showAddressTitle2(element) {
  
    let row = element.closest("tr");

    if (row) {
    	   
    	
        let codeTd = row.querySelector('td[data-custom="code"]')?.getAttribute("title");
       
        let stock_codeTd = row.querySelector('td[data-custom="stock_code"]')?.getAttribute("title");
        let stock_nameTd = row.querySelector('td[data-custom="stock_name"]')?.getAttribute("title");
        
        let supplier_codeTd = row.querySelector('td[data-custom="supplier_code"]')?.getAttribute("title");
        let supplier_nameTd = row.querySelector('td[data-custom="supplier_name"]')?.getAttribute("title");
        let unitTd = row.querySelector('td[data-custom="unit"]')?.getAttribute("title");
        let quantityTd = row.querySelector('td[data-custom="quantity"]')?.getAttribute("title");
        let priceTd = row.querySelector('td[data-custom="price"]')?.getAttribute("title");
        let tracking_numberTd = row.querySelector('td[data-custom="tracking_number"]')?.getAttribute("title");
        let stock_storageTd = row.querySelector('td[data-custom="stock_storage"]')?.getAttribute("title");
        
        
        fillPossibleFields(['skg_lot_batch','ski_lot_batch','ska_lot_batch','skt_lot_batch'], codeTd);
        fillPossibleFields(['ski_lot_batch2'], codeTd);
        fillPossibleFields(['skg_stock_code','ski_stock_code','ska_stock_code','skt_stock_code'], stock_codeTd);
        fillPossibleFields(['skg_stock_name','ski_stock_name','ska_stock_name','skt_stock_name','bom_name'], stock_nameTd);
        fillPossibleFields(['skt_quantity','ski_quantity'], quantityTd);
        fillPossibleFields(['skg_supplier_code', 'ski_supplier_code', 'ska_supplier_code', 'skt_supplier_code'], supplier_codeTd);
        fillPossibleFields(['skg_supplier_name', 'ski_supplier_name', 'ska_supplier_name', 'skt_supplier_name'], supplier_nameTd);
        fillPossibleFields(['skg_unit', 'ski_unit', 'ska_unit','bom_base_unit'], unitTd);
        fillPossibleFields(['tracking_number','ski_tracking_number'], tracking_numberTd);
        fillPossibleFields(['bom_price'], priceTd);
        fillPossibleFields(['skt_from_location'], stock_storageTd);
        
    }
}


function fillPossibleFields(possibleNames, value) {
    for (var i = 0; i < possibleNames.length; i++) {
        var name = possibleNames[i];
        var field = document.querySelector('input[name="' + name + '"]');
        if (field !== null) {
            field.value = value;
            break;
        }
    }
}
</script>                       