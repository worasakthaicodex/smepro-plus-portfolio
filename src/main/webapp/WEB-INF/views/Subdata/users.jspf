<script>
function showAddressTitle(element) {
    // หา parent <tr> ที่อยู่ใกล้ที่สุดของปุ่มที่กด
    let row = element.closest("tr");

    if (row) {
        // ค้นหา <td> ที่มี data-custom="address"
        let codeTd = row.querySelector('td[data-custom="code"]').getAttribute("title");
        let nameTd = row.querySelector('td[data-custom="name"]').getAttribute("title");
        let typeTd = row.querySelector('td[data-custom="type"]').getAttribute("title");
        let groupsTd = row.querySelector('td[data-custom="groups"]').getAttribute("title");
        let addressTd = row.querySelector('td[data-custom="address"]').getAttribute("title");
        let noteTd = row.querySelector('td[data-custom="note"]').getAttribute("title");
      
        fillPossibleFields(['customer_code','skg_supplier_code'], codeTd);
        fillPossibleFields(['customer_name','skg_supplier_name'], nameTd);
      
    }
}


function fillPossibleFields(possibleNames, value) {
    for (var i = 0; i < possibleNames.length; i++) {
        var name = possibleNames[i];
        var field = document.querySelector('input[name="' + name + '"]');
        if (field !== null) {
            field.value = value;
            break;
        }
    }
}
</script>    

<script>
function checkall(className, checked) {
    const checkboxes = document.querySelectorAll('.' + className);
    checkboxes.forEach(cb => cb.checked = checked);
}



function postdata(Mode, Mode2, Mode3) {

    let targetDiv = $("#" + Mode3);
    
    // ทำให้เนื้อหาเก่าจางลง
    targetDiv.css("opacity", "0.5").css("position", "relative");

    // สร้าง Spinner อยู่ตรงกลางของ div
    let loadingSpinner = `
        <div class="spinner-overlay">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>`;

    // แทรก Spinner เข้าไปใน div
    targetDiv.append(loadingSpinner);

		
	
	
    var formData = new FormData($("#" + Mode2)[0]);

    $.ajax({
        url: Mode,
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function(result){
            $('#' + Mode3).html(result);
            targetDiv.css("opacity", "1"); // คืนค่า opacity ปกติ
        },
        error: function(jqXHR, textStatus, errorThrown) {
                window.location.href = '/login'; // URL ของหน้า login
       
        }
    });

   // $("#" + Mode2)[0].reset();
   
    return false;
}
	    
</script>                   