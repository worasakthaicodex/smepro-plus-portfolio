<td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="type"   title="${row.group_department }">${row.group_department }</td>     

     
     
          <td class="form-label fixhead" style="padding:5px;font-size:13px">
          
       
          
                    <input type="checkbox" name="selectedIds" class="form-check-input check-input" value="${row.user_id }_${row.user_name }_${row.group_name }_${row.group_department }">
          </td>  
                                        </tr>
														
				                                     
				                                      
				                                      
                                      
