<%@ page  contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix = "c" uri = "http://java.sun.com/jsp/jstl/core" %>  
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ taglib prefix = "fmt" uri = "http://java.sun.com/jsp/jstl/fmt" %>


<style>
.fixhead {
    max-width: 150px; /* กำหนดความกว้างสูงสุด */
    white-space: nowrap; /* ป้องกันข้อความขึ้นบรรทัดใหม่ */
    overflow: hidden; /* ซ่อนข้อความที่เกินขอบเขต */
    text-overflow: ellipsis; /* แสดง ... เมื่อข้อความยาวเกินไป */
}
</style>
    <div class="row">
                                            <div class="col-md-4 col-12">
                                                <div class="mb-1">
                                                    <label class="form-label" for="first-name-column"><spring:message code="register.name"  /></label>
                                                    <input type="text" name="register_name" id="first-name-column" class="form-control"  name="fname-column">
                                                </div>
                                            </div>
                                            
                                            <c:set var="dataArray" value="${fn:split(register_type, ',')}" />
                                            <div class="col-md-4 col-12">
                                                <div class="mb-1">
                                                    <label class="form-label" for="last-name-column"><spring:message code="register.type"  /></label>
                                                    <select class="form-select" name="register_type">
                                                      <option value="-">-</option>
                                                        <c:forEach var="item" items="${dataArray}">
													     <option value="${item}">${item}</option>
													    </c:forEach>
                                                    </select>
                                                </div>
                                            </div>
                                                   <c:set var="dataArray2" value="${fn:split(register_group, ',')}" />
                                            <div class="col-md-4 col-12">
                                                <div class="mb-1">
                                                    <label class="form-label" for="last-name-column"><spring:message code="register.groups"  /></label>
                                                    <select class="form-select " name="register_groups" >
                                                    <option value="-">-</option>
                                                      <c:forEach var="item" items="${dataArray2}">
													     <option value="${item}">${item}</option>
													    </c:forEach>
                                                    </select>
                                                </div>
                                            </div>
                                      <div>       
                                 <button class="btn btn-primary waves-effect waves-float waves-light" type="submit">Submit</button>           
                                    </div>         
                                        </div>
                                                
                                                <br>  <br>
  <table  class="table">
                                    <thead>
                                        <tr>
                                        
            	 <th class="form-label fixhead" style="padding:5px;font-size:13px">#</th>   
            	 
       					<th class="form-label fixhead" style="padding:5px;font-size:13px">ID</th>         	                          
 					<th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="register.name"  /></th>     
  
<th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="register.type"  /></th>     
  <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="register.groups"  /></th>  
    <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="register.address"  /></th>  
     <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="register.note"  /></th>  
     
     <c:if test="${load_type == 'log'}">  
       <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="register.addby"  /></th>  
         <th class="form-label fixhead" style="padding:5px;font-size:13px"><spring:message code="register.created_at"  /></th>  
     </c:if>
     
     
          <th class="form-label fixhead" style="padding:5px;font-size:13px">#</th>  
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <c:forEach items="${item }" var="row"  varStatus="count">
				                                     
				                                     
				                                                            <tr>
                                        
            	 <td class="form-label fixhead" style="padding:5px;font-size:13px">${count.count }</td>   
            	 
            	                          
 					<td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="code" title="${row.register_code }${row.register_daterun }${row.register_id }">${row.register_code }${row.register_daterun }${row.register_id }</td>     
<td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="name"  title="${row.register_name }">${row.register_name }</td>     
<td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="type"   title="${row.register_type }">${row.register_type }</td>     
  <td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="groups"  title="${row.register_groups }">${row.register_groups }</td>  
    <td class="form-label fixhead" style="padding:5px;font-size:13px"  data-custom="address"   title="${row.register_address }">${row.register_address }</td>  
     <td class="form-label fixhead" style="padding:5px;font-size:13px" data-custom="note"  title="${row.register_note }">${row.register_note }</td>  
     
     
       	<c:if test="${load_type == 'log'}">  
          <td class="form-label fixhead" style="padding:5px;font-size:13px"   >${usersed_name }</td>  
          <td class="form-label fixhead" style="padding:5px;font-size:13px" >${row.created_at }</td>  
         </c:if>
          
     
          <td class="form-label fixhead" style="padding:5px;font-size:13px">
          <c:if test="${load_type != 'log'}">     <a class="btn btn-sm btn-success" onclick="showAddressTitle(this)">+</a></c:if>
                   <a class="btn btn-sm btn-light" ><i data-feather='eye'></i></a>
          </td>  
                                        </tr>
														
				                                     
				                                      
				                                      
                                      
                                        	</c:forEach>   
                                        
                                    </tbody>
                                    </table>     
                                    
   <script>
        
            if (feather) {
                feather.replace({
                    width: 14,
                    height: 14
                });
            }
      
    </script>                                   
                                    
<script>
function showAddressTitle(element) {
    // หา parent <tr> ที่อยู่ใกล้ที่สุดของปุ่มที่กด
    let row = element.closest("tr");

    if (row) {
        // ค้นหา <td> ที่มี data-custom="address"
        let codeTd = row.querySelector('td[data-custom="code"]').getAttribute("title");
        let nameTd = row.querySelector('td[data-custom="name"]').getAttribute("title");
        let typeTd = row.querySelector('td[data-custom="type"]').getAttribute("title");
        let groupsTd = row.querySelector('td[data-custom="groups"]').getAttribute("title");
        let addressTd = row.querySelector('td[data-custom="address"]').getAttribute("title");
        let noteTd = row.querySelector('td[data-custom="note"]').getAttribute("title");
      
        let codeField = document.querySelector('input[name="procurement_supplier_id"]');
        codeField.value = codeTd;
        
        let nameField = document.querySelector('input[name="procurement_supplier_name"]');
        nameField.value = nameTd;
        
        let addressField = document.querySelector('textarea[name="procurement_supplier_address"]');
        addressField.value = addressTd;
        
    }
}
</script>                       